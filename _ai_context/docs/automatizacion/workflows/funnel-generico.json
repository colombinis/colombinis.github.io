        "subject": "Gracias por su compra — SACsi",
        "text": "={{ $json.nombre }}, tu proyecto está por arrancar. Formulario: {{ $json.form_url }}",
        "html": "<p>Hola {{ $json.nombre }},</p><p>Tu proyecto está por arrancar. Completá tu formulario acá: <a href=\"{{ $json.form_url }}\">{{ $json.form_url }}</a></p>"
