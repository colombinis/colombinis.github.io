    },
    {
      "parameters": {
        "jsCode": [
          "const clienteId = items[0].json.id;",
          "const trabajoId = items[0].json.trabajo_id;",
          "const baseUrl = $workflow.staticData.SACSI_FORM_BASE_URL || process.env.SACSI_FORM_BASE_URL || 'https://sacsi.com.ar/formulario';",
          "const formUrl = `${baseUrl}/${trabajoId}/${clienteId}/`;",
          "return [{",
          "  json: {",
          "    cliente_id: clienteId,",
          "    trabajo_id: trabajoId,",
          "    form_url: formUrl,",
          "    email: items[0].json.email,",
          "    nombre: items[0].json.nombre,",
          "    telefono_whatsapp: items[0].json.telefono_whatsapp",
          "  }",
          "];"
        ]
      },
      "id": "598112d5-df4f-4b1d-8ab8-323f2455fb7f",
