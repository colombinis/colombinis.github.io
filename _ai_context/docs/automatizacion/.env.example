# Configuración de entorno para SACsi Automatización
# Copiá este archivo a .env y ajustá los valores

# === n8n ===
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGEME_AQUELI_PASSWORD

# === PostgreSQL (n8n) ===
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGEME_DB_PASSWORD
POSTGRES_DB=n8n

# === PostgreSQL (clientes — estado de funnel) ===
POSTGRES_USER_CLIENTES=sacsi
POSTGRES_PASSWORD_CLIENTES=CHANGEME_CLIENTES_PASSWORD
POSTGRES_DB_CLIENTES=clientes

# === Mercado Pago ===
# Obtenés el access_token desde: https://www.mercadopago.com.ar/ayuda/manuales/e-commerce/webhooks_30099
MERCADO_PAGO_ACCESS_TOKEN=TEST-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX
MERCADO_PAGO_WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET

# === Email (Mailgun / SendGrid / SMTP) ===
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=postmaster@sacsi.com.ar
EMAIL_PASSWORD=CHANGEME_EMAIL_PASSWORD

# === Slack (notificaciones críticas) ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# === Sitio web ===
SITE_URL=https://sacsi.com.ar
FORM_BASE_URL=https://sacsi.com.ar/formulario
WHATSAPP_PHONE=5493415197937

# === n8n Encryption Key (generar con: openssl rand -base64 32) ===
N8N_ENCRYPTION_KEY=CHANGEME_GENERAR_CON_OPENSSL

# NOTA: No necesitás configurar UID/GID — el docker-compose.yml maneja
# permisos automáticamente con chown -R 1000:1000 /home/node/.n8n