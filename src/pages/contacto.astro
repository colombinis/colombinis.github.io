---
// contacto.astro — página pública /contacto/
//
// REUTILIZA FormContactoProgresivo (componente genérico) en lugar de un formulario simple.
// Esto CIERRA el error P4: no hay /contacto-v2 paralelo; /contacto/ es el entry point único.
//
// Query-string ?categoria=<slug> precarga el select del step 1 (p.ej. ?categoria=facturacion-cobranzas).
// Se deriva el "asunto" readable desde la categoria (o se pasa explicito).
//
// Props del componente: categoria? (precarga select), asunto? (readonly), source? (tracking).
//
// Diseño Atómico (DESIGN.md): la tarjeta de promesa es <Card variant="accent">
// y el pill "Primera conversación sin cargo" es <Badge variant="accent"> —
// primitivos de src/components/ui/ (patrones ver design-style-guide.astro).
// El sizing exclusivo de página viaja por el prop class con :global() en el
// <style> (la raíz del primitivo la renderiza el componente ui, no esta página).
import Layout from "../layouts/Layout.astro";
import FormContactoProgresivo from "../components/FormContactoProgresivo.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import config from "../config/site.json";
import { ShieldCheck } from "lucide-astro";

// Whatsapp como fallback secundario (el usuario lo conserva en /contacto como alternativa).
const whatsappUrl = `${config.contact.whatsapp.base_url}?phone=${config.contact.whatsapp.phone}&text=Hola%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20soluciones`;

// Precarga de categoría: el sitio es ESTÁTICO (GitHub Pages), así que la
// query-string NO existe en build-time (Astro.url.searchParams es la del build).
// La precarga real se hace en cliente dentro de FormContactoProgresivo (lee
// window.location.search). Acá solo pasamos defaultToOtros para que, sin
// parámetro, quede seleccionado "Otros".
const categoria = Astro.url.searchParams.get("categoria") ?? undefined;
const asunto = Astro.url.searchParams.get("asunto") ?? undefined;
---

<Layout
  title="Contacto y Consulta sin Cargo para PyMEs en Rosario"
  description="Primera conversación sin cargo para PyMEs en Rosario. Te decimos con honestidad qué tecnología justa necesitás para tu negocio y qué no."
>
  <div class="page-header">
    <p class="hero__label">ATENCIÓN PERSONALIZADA EN ROSARIO</p>
    <h1>Contactanos</h1>
    <Card variant="accent" class="contact-promise-card">
      <Badge variant="accent" class="contact-promise-badge">
        <ShieldCheck size={16} aria-hidden="true" />
        <strong>Primera conversación sin cargo</strong>
      </Badge>
      <p class="contact-promise-highlight">
        Te decimos con honestidad si te conviene avanzar.
      </p>
      <p class="contact-promise-desc">
        Sin vueltas ni presiones comerciales: evaluamos tus procesos y te recomendamos únicamente lo que tu negocio necesita para crecer.
      </p>
    </Card>
    <p class="page-header__subtitle">
      Completá el formulario breve o escribinos directo por WhatsApp para coordinar tu primera charla.
    </p>
  </div>

  <section class="contact-section">
    <div class="contact-grid">
      <!-- Formulario progresivo reutilizable -->
      <FormContactoProgresivo
        categoria={categoria}
        asunto={asunto}
        source="contacto-page"
        defaultToOtros={true}
      />
    </div>
  </section>
</Layout>

<style>
  .hero__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tertiary-dark);
    margin: 0 0 var(--spacing-sm);
  }
  .page-header {
    padding: var(--spacing-xxl) var(--spacing-lg) 0;
    text-align: center;
  }
  /* Sizing de página sobre la Card primitiva (raíz renderizada por ui/Card) */
  :global(.contact-promise-card) {
    max-width: 580px;
    margin: var(--spacing-md) auto var(--spacing-lg);
    overflow-wrap: break-word;
  }
  /* El pill original permitía saltos de línea en pantallas angostas */
  :global(.contact-promise-badge) {
    margin-bottom: var(--spacing-xs);
    white-space: normal;
    text-align: center;
    line-height: 1.3;
  }
  .contact-promise-highlight {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--primary);
    margin: var(--spacing-xs) 0;
    overflow-wrap: break-word;
  }
  .contact-promise-desc {
    font-size: 0.9rem;
    color: var(--secondary);
    margin: 0;
    line-height: 1.5;
    overflow-wrap: break-word;
  }
  .page-header__subtitle {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 auto var(--spacing-lg);
    max-width: 560px;
  }
  .contact-section {
    padding: 0 var(--spacing-lg) var(--spacing-xxl);
  }
  .contact-grid {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }
</style>
