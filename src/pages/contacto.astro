---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto" description="Contactanos para consultas sin compromiso. Escribinos por WhatsApp, email o teléfono.">
  <div class="page-header">
    <h1>Contactanos</h1>
    <p class="page-header__subtitle">Estamos listos para escucharte. Respondemos por WhatsApp, mail o el medio que prefieras.</p>
  </div>

  <section class="contact-section">
    <div class="contact-grid">
      <div class="contact-form">
        <div class="success-message" id="success-message">
          <div class="success-message__icon">✓</div>
          <p>Gracias por tu consulta, te responderemos a la brevedad</p>
        </div>

        <form id="contact-form" action="mailto:sacsi@sacsi.com.ar" method="post" enctype="text/plain">
          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre</label>
              <input type="text" id="nombre" name="nombre" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
          </div>
          <div class="form-group">
            <label for="telefono">Teléfono <span class="optional">(opcional)</span></label>
            <input type="tel" id="telefono" name="telefono" />
          </div>
          <div class="form-group">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Enviar consulta</button>
        </form>
      </div>

      <div class="alt-contact">
        <p class="alt-contact__title">También podés contactarnos por:</p>
        <a
          class="alt-contact__whatsapp"
          href="https://api.whatsapp.com/send?phone=5493415197937&text=Hola%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20soluciones"
          rel="noopener noreferrer"
          target="_blank"
        >WhatsApp</a>
        <div class="alt-contact__item">
          <span>✉</span>
          <a href="mailto:sacsi@sacsi.com.ar">sacsi@sacsi.com.ar</a>
        </div>
        <div class="alt-contact__item">
          <span>📞</span>
          <a href="tel:3415197937">(341) 519-7937</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: var(--spacing-xxl) var(--spacing-lg) 0;
    text-align: center;
  }

  .page-header__subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 auto var(--spacing-xl);
    max-width: 560px;
  }

  .contact-section {
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-xxl);
  }

  .contact-grid {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .contact-form {
    background: var(--surface);
    border-radius: var(--rounded-md);
    padding: var(--spacing-xl);
    border: 1px solid #E8E8E8;
  }

  .form-row {
    display: flex;
    gap: var(--spacing-md);
  }

  .form-row .form-group {
    flex: 1;
  }

  .form-group {
    margin-bottom: var(--spacing-md);
  }

  .form-group label {
    display: block;
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 6px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #DDD;
    border-radius: var(--rounded-sm);
    font-size: 0.93rem;
    font-family: var(--font-stack);
    color: var(--secondary);
    background: var(--surface);
    transition: border-color 0.2s ease;
    outline: none;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--tertiary);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group .optional {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .submit-btn {
    width: 100%;
    background-color: var(--whatsapp);
    color: #FFFFFF;
    padding: 14px 32px;
    border: none;
    border-radius: var(--rounded-sm);
    font-weight: 700;
    font-size: 1rem;
    font-family: var(--font-stack);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .submit-btn:hover {
    background-color: var(--whatsapp-hover);
  }

  .success-message {
    display: none;
    background: #E8F5E9;
    border: 1px solid #A5D6A7;
    border-radius: var(--rounded-sm);
    padding: var(--spacing-lg);
    text-align: center;
    margin-bottom: var(--spacing-md);
  }

  .success-message.show {
    display: block;
  }

  .success-message__icon {
    font-size: 2rem;
    margin-bottom: var(--spacing-sm);
  }

  .success-message p {
    font-size: 0.93rem;
    color: #2E7D32;
    margin: 0;
    font-weight: 600;
  }

  .alt-contact {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .alt-contact__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }

  .alt-contact__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.93rem;
  }

  .alt-contact__item a {
    color: var(--secondary);
    font-weight: 500;
  }

  .alt-contact__item a:hover {
    color: var(--tertiary);
  }

  .alt-contact__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    background-color: var(--whatsapp);
    color: #FFFFFF;
    padding: 14px 24px;
    border-radius: var(--rounded-sm);
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
    width: 100%;
    justify-content: center;
  }

  .alt-contact__whatsapp:hover {
    background-color: var(--whatsapp-hover);
    color: #FFFFFF;
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
    }

    .contact-form {
      padding: var(--spacing-lg);
    }

    .alt-contact__whatsapp {
      width: 100%;
    }
  }
</style>

<script>
  document.getElementById('contact-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var formData = new FormData(this);
    var nombre = formData.get('nombre');
    var email = formData.get('email');
    var telefono = formData.get('telefono');
    var mensaje = formData.get('mensaje');

    var body = 'Nombre: ' + encodeURIComponent(nombre) +
               '%0AEmail: ' + encodeURIComponent(email) +
               '%0ATelefono: ' + encodeURIComponent(telefono) +
               '%0A%0AMensaje:%0A' + encodeURIComponent(mensaje);
    var mailto = 'mailto:sacsi@sacsi.com.ar?subject=Consulta%20desde%20SACsi&body=' + body;

    // CON-04: evento de conversion MOFU (form submit)
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'form_submit',
      form_name: 'contacto',
      lead_nombre: nombre
    });

    window.location.href = mailto;

    document.querySelector('.success-message').classList.add('show');
    this.reset();
  });
</script>
