---
// contacto.astro — página pública /contacto/
//
// REUTILIZA FormContactoProgresivo (componente genérico) en lugar de un formulario simple.
// Esto CIERRA el error P4: no hay /contacto-v2 paralelo; /contacto/ es el entry point único.
//
// Query-string ?categoria=<slug> precarga el select del step 1 (p.ej. ?categoria=facturacion-cobranzas).
// Se deriva el "asunto" readable desde la categoria (o se pasa explicito).
//
// Props del componente: categoria? (precarga select), asunto? (readonly), source? (tracking).
import Layout from "../layouts/Layout.astro";
import FormContactoProgresivo from "../components/FormContactoProgresivo.astro";
import config from "../config/site.json";

// Whatsapp como fallback secundario (el usuario lo conserva en /contacto como alternativa).
const whatsappUrl = `${config.contact.whatsapp.base_url}?phone=${config.contact.whatsapp.phone}&text=Hola%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20soluciones`;

// Precargo categoria/asunto desde query-string (link desde servicios/* → /contacto/?categoria=<slug>).
// Astro expone Astro.url en SSR/prerender: searchParams.get() resuelve el query.
const categoria = Astro.url.searchParams.get("categoria") ?? undefined;
const asunto = Astro.url.searchParams.get("asunto") ?? undefined;
---

<Layout
  title="Contacto"
  description="Contactanos sin compromiso para tu proyecto. Contanos tu idea y te respondemos en 24 h por WhatsApp, email o redes sociales."
>
  <div class="page-header">
    <h1>Contactanos</h1>
    <p class="page-header__subtitle">
      Estamos listos para escucharte. Respondemos por WhatsApp, mail o las redes
      que prefieras.
    </p>
  </div>

  <section class="contact-section">
    <div class="contact-grid">
      <!-- Formulario progresivo reutilizable (3 steps, Formspree, GTM) -->
      <!-- source="contacto-page" identifica el entry point en GA4/dataLayer -->
      <FormContactoProgresivo
        categoria={categoria}
        asunto={asunto}
        source="contacto-page"
      />

      
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: var(--spacing-xxl) var(--spacing-lg) 0;
    text-align: center;
  }
  .page-header__subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 auto var(--spacing-xl);
    max-width: 560px;
  }
  .contact-section {
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-xxl);
  }
  .contact-grid {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }
  .alt-contact {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
    text-align: center;
  }
  .alt-contact__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }
  .alt-contact__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.93rem;
  }
  .alt-contact__item a {
    color: var(--secondary);
    font-weight: 500;
  }
  .alt-contact__item a:hover {
    color: var(--tertiary);
  }
  .alt-contact__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    background-color: var(--whatsapp);
    color: #ffffff;
    padding: 14px 24px;
    border-radius: var(--rounded-sm);
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }
  .alt-contact__whatsapp:hover {
    background-color: var(--whatsapp-hover);
    color: #ffffff;
  }
  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
    text-align: center;
  }
  .social-links__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }
  .social-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }
  .social-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 10px 20px;
    border-radius: var(--rounded-sm);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.93rem;
    color: var(--primary);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .social-item:hover {
    background-color: var(--whatsapp);
    color: #ffffff;
  }
  .social-icon {
    font-size: 1.1rem;
  }
</style>
