---
// HOME — estructura estilo donweb.com/es-ar (rama feature/home-donweb-structure)
// 
// Orden de secciones (relevado de donweb, adaptado a contenido SACsi):
//   0. Topbar promo fina (slot pre-header)                     [nuevo]
//   1. Header transparente sobre hero → sólido al scroll       [overlay]
//   2. Hero de marca + slider en una fila (60/40)               [nuevo]
//   3. Soluciones para tu negocio (4 servicios)                 [existe]
//   5. Banner CTA Diagnóstico IA                                [nuevo]
//   6. Casos reales (Problema → Solución justa → Resultado)     [existe]
//   7. Cómo trabajamos (4 pasos)                                [existe]
//   8. POR QUÉ SACSI (foto + pilares)                                [nuevo]
//   9. Checklist lead magnet + origen marca + FAQ               [existe]
import Layout from '../layouts/Layout.astro';
import HeroRow from '../components/HeroRow.astro';
import SolucionesSection from '../components/SolucionesSection.astro';
import CasosAnonimosSection from '../components/CasosAnonimosSection.astro';
import ClientesConfian from '../components/ClientesConfian.astro';
import PorQueSacsiConFoto from '../components/PorQueSacsiConFoto.astro';
import FaqSection from '../components/FaqSection.astro';

// Clientes que confían — logos reales (variante slider, marquesina automática)
const clientes = [
  { name: 'MLR Sistemas', url: 'https://mlrsistemas.com.ar/', logo: '/assets/clientes/mlr-sistemas.webp', description: 'Sistemas de gestión y software empresarial' },
  { name: 'Syloper', url: 'https://syloper.com/', logo: '/assets/clientes/syloper.svg', description: 'Consultoría y desarrollo de software' },
  { name: 'Ameba', url: 'https://www.ameba.com.uy/en', logo: '/assets/clientes/ameba.svg', description: 'Diseño y desarrollo de plataformas digitales' },
  { name: 'SOESGPYLA', url: 'https://www.soesgpyla.com.ar/', logo: '/assets/clientes/soesgpyla.svg', description: 'Sindicato Obreros Estaciones de Servicio' },
  { name: 'Grupo El Positivo', url: 'https://www.grupoelpositivo.com.ar/', logo: '/assets/clientes/grupo-el-positivo.png', description: 'Comercialización y distribución de artículos' },
  { name: 'e-Softing', url: 'https://e-softing.com.ar/', logo: '/assets/clientes/e-softing.svg', description: 'Soluciones tecnológicas e infraestructura' },
  { name: '1950labs', url: 'https://1950labs.com/', logo: '/assets/clientes/1950labs.png', description: 'Staff augmentation y desarrollo de software' },
  { name: 'Tornillo Alvear', url: 'https://www.tornilloalvear.com/', logo: '/assets/clientes/tornillo-alvear.png', description: 'Fijaciones, tornillería y ferretería industrial' },
  { name: 'Fenicio', url: 'https://fenicio.io/', logo: '/assets/clientes/fenicio.png', description: 'Plataforma e-commerce para marcas' },
  { name: 'ON94', url: 'https://on94.com.ar/', logo: '/assets/clientes/on94.png', description: 'Radio online — Santa Fe, Argentina' },
  { name: 'Onmedia', url: 'https://onmedia.uy/', logo: '/assets/clientes/onmedia.png', description: 'Radio online — Maldonado, Uruguay' },
  { name: 'eLearn Guitar', url: 'http://elearnguitar.com/', logo: '/assets/clientes/elearnguitar.png', description: 'Enseñanza y partituras de guitarra clásica en línea' }
];
---
 
<Layout
  title="Tecnología Justa para PyMEs en Rosario"
  description="Tecnología justa para emprendedores y PyMEs. IA aplicada, automatización, software a medida y presencia online sin pagar de más ni modas."
  
>
  <!-- 2. Bloque de marca en una fila: hero (propuesta de valor) al 60% y
       slider de servicios al 40%. Ambos con el mismo fondo navy/texto blanco.
       Organismo HerowRow.astro (ver /design-style-guide §10b). -->
  <HeroRow />

  <!-- 3. Soluciones para tu negocio (los 4 servicios) -->
  <SolucionesSection />
  
  <!-- 4. Banner CTA Diagnóstico IA (la puerta de entrada al funnel) -->
  <section class="section section--alt diagnostico-banner">
    <div class="container diagnostico-banner__card">
      <div class="diagnostico-banner__content">
        <span class="diagnostico-banner__tag">EMPEZÁ POR ACÁ</span>
        <h2>¿No sabés qué necesita tu negocio?</h2>
        <p>
          En una sesión de trabajo detectamos dónde perdés horas y qué conviene
          automatizar primero. Recibís un diagnóstico en PDF con roadmap y ROI
          estimado. Se descuenta del proyecto si avanzás.
        </p>
      </div>
      <div class="diagnostico-banner__action">
        <a class="hero__cta" href="/soluciones/diagnostico-ia/">
          Quiero mi Diagnóstico IA
        </a>
      </div>
    </div>
  </section>
  
  <!-- 5. Casos reales (Problema → Solución justa → Resultado medible) -->
  <CasosAnonimosSection
    title="Experiencia comprobada en casos reales"
    titleHighlight="Experiencia comprobada"
    hideLabel={true}
    hideMeta={true}
  />
  
  <!-- 6. Clientes que confían — logos reales, variante "slider" (marquesina automática, solo imágenes, sin dots) -->
  <ClientesConfian mode="slider" clientes={clientes} />
  
  <!-- 7. Cómo trabajamos -->
  <section id="como-trabajamos" class="section">
    <div class="container">
      <h2 class="section__title">Cómo trabajamos</h2>
      <div class="steps">
        <div class="step">
          <div class="step__number">1</div>
          <h3>Descubrimiento</h3>
          <p>
            Analizamos tu negocio, tus procesos y tus necesidades. Recibís un
            diagnóstico claro con las oportunidades de mejora identificadas.
          </p>
        </div>
        <div class="step">
          <div class="step__number">2</div>
          <h3>Diagnóstico</h3>
          <p>
            Evaluamos la mejor solución técnica para tu caso. Recibís una
            propuesta con alcance, tiempos y presupuesto sin sorpresas.
          </p>
        </div>
        <div class="step">
          <div class="step__number">3</div>
          <h3>Prototipo</h3>
          <p>
            Construimos una versión funcional de la solución. Recibís entregas
            periódicas con avances visibles para que puedas sugerir ajustes.
          </p>
        </div>
        <div class="step">
          <div class="step__number">4</div>
          <h3>Producción</h3>
          <p>
            Ponemos la solución en marcha y te acompañamos. Recibís soporte
            continuo y garantía de funcionamiento post-entrega.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- 8. POR QUÉ SACSI — foto a todo el ancho + filas (icono, título y
       bajada) sobre la mitad derecha. Organismo PorQueSacsiConFoto.astro
       (ver /design-style-guide §13). Reemplaza la grilla de 4 cards. -->
  <PorQueSacsiConFoto />
  
  <!-- 9. Lead magnet: Checklist de Automatización -->
  <section class="section section--alt lead-magnet-banner">
    <div class="container lead-magnet-card">
      <div class="lead-magnet-content">
        <span class="lead-magnet-tag">RECURSO GRATUITO PARA PYMES</span>
        <h2>¿Tu negocio necesita automatización?</h2>
        <p>
          Descargá nuestro checklist en PDF y detectá en 5 minutos qué tareas
          repetitivas te están costando horas y dinero. Sin registros complicados.
        </p>
      </div>
      <div class="lead-magnet-action">
        <a class="hero__cta hero__cta--form" href="/checklist-automatizacion/">
          Descargar Checklist Gratis (PDF)
        </a>
      </div>
    </div>
  </section>
  
  <!-- FAQ -->
  <section id="faq" class="section section--alt">
    <div class="container">
      <h2 class="section__title">Preguntas frecuentes</h2>
      <FaqSection />
    </div>
  </section>
  
</Layout>

<style>
  /* El bloque hero + slider (grid 60/40, fondo navy) vive en el organismo
     HeroRow.astro; el estilo del hero de marca vive scopeado en
     src/components/Hero.astro. */
  .diagnostico-banner {
    padding: var(--spacing-xl) var(--spacing-md);
  }
  .diagnostico-banner__card {
    background: #FFFFFF;
    border: 2px solid var(--tertiary);
    border-radius: var(--rounded-md);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    align-items: center;
    text-align: center;
    box-shadow: 0 4px 16px rgba(10, 124, 255, 0.08);
  }
  .diagnostico-banner__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--tertiary-dark);
  }
  .diagnostico-banner__content h2 {
    font-size: 1.4rem;
    margin: 0 0 var(--spacing-xs);
    color: var(--primary);
  }
  .diagnostico-banner__content p {
    font-size: 0.95rem;
    color: var(--secondary);
    margin: 0;
    max-width: 580px;
    line-height: 1.5;
  }
  .diagnostico-banner__action .hero__cta {
    width: 100%;
    max-width: 360px;
    min-width: 0;
    white-space: normal;
    text-align: center;
  }
  @media (min-width: 768px) {
    .diagnostico-banner__card {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  
  .lead-magnet-banner {
    padding: var(--spacing-xxl) var(--spacing-md);
  }
  .lead-magnet-card {
    background: #FFFFFF;
    border: 2px solid var(--tertiary);
    border-radius: var(--rounded-md);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    align-items: center;
    text-align: center;
    box-shadow: 0 4px 16px rgba(10, 124, 255, 0.08);
  }
  @media (min-width: 768px) {
    .lead-magnet-card {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .lead-magnet-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--tertiary-dark);
    display: block;
    margin-bottom: var(--spacing-xs);
  }
  .lead-magnet-content h2 {
    font-size: 1.4rem;
    margin: 0 0 var(--spacing-xs);
  }
  .lead-magnet-content p {
    font-size: 0.95rem;
    color: var(--secondary);
    margin: 0;
    max-width: 580px;
    line-height: 1.5;
  }
  .lead-magnet-action .hero__cta {
    width: 100%;
    max-width: 360px;
    min-width: 0;
    white-space: normal;
    text-align: center;
  }
</style>
