---
// Ruta: /padmin/listado-soluciones/ — Área interna SACsi (protegida por Cloudflare Basic Auth)
// Convierte el HTML legacy listado-soluciones.html a una página Astro estática
// que renderiza en build-time la tabla de todas las soluciones desde
// src/lib/data-utils.ts (getSoluciones / getSolucionDetalle), con un detalle
// expandible de pasos por solución.
//
// NOTA: esta página vive bajo /padmin/* y NO debe ser linkeada desde el sitio
// público. El acceso se protege a nivel de Cloudflare (Basic Auth en /padmin/*).
import Layout from '../../layouts/Layout.astro';
import { getSoluciones, getSolucionDetalle, getCategoria } from '../../lib/data-utils';

const soluciones = getSoluciones();

// Formato de precios: los datos vienen en ARS "k" (miles) → pesos argentinos.
const arsFormatter = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});
function formatearARS(miles: number): string {
  return arsFormatter.format(Math.round(miles * 1000));
}
function formatearPrecio(min: number, max: number): string {
  if (min === max) return formatearARS(min);
  return `${formatearARS(min)} – ${formatearARS(max)}`;
}
function formatearHoras(min: number, max: number): string {
  if (min === max) return `${min} h`;
  return `${min}–${max} h`;
}

// Resuelve los títulos de las categorías de cada solución (fuente: detalle solucion_<id>.json)
function categoriasDe(id: string): string[] {
  const detalle = getSolucionDetalle(id);
  const ids = detalle?.categorias ?? [];
  return ids
    .map((catId) => getCategoria(catId)?.title ?? catId)
    .filter((t): t is string => Boolean(t));
}
---

<Layout
  title="Área interna SACsi — protegida"
  description="Listado interno de soluciones de SACsi: precios, horas y flujo de ejecución por solución. Área protegida."
  robots="noindex, nofollow"
>
  <section class="section">
    <div class="container">
      <p class="padmin__eyebrow">ÁREA INTERNA · PROTEGIDA</p>
      <h1 class="padmin__title">Listado de soluciones</h1>
      <p class="padmin__subtitle">
        Tabla de precios, horas y flujo de ejecución por solución. Los datos se
        cargan en build-time desde <code>src/data/soluciones/listado-soluciones.json</code>
        (fuente de verdad única). Esta página no está linkeada desde el sitio público.
      </p>

      <div class="padmin__table-wrap">
        <table class="padmin__table">
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Nombre</th>
              <th scope="col">Categoría</th>
              <th scope="col" class="tnum">Precio (ARS)</th>
              <th scope="col" class="tnum">Horas</th>
              <th scope="col">Flujo de ejecución</th>
            </tr>
          </thead>
          <tbody>
            {soluciones.map((s) => {
              const detalle = getSolucionDetalle(s.id);
              const flujo = detalle?.flujo ?? [];
              const cats = categoriasDe(s.id);
              return (
                <tr>
                  <td class="padmin__id">{s.id}</td>
                  <td class="padmin__nombre">{s.nombre}</td>
                  <td class="padmin__categorias">
                    {cats.length > 0 ? (
                      <ul class="padmin__cats">
                        {cats.map((c) => (
                          <li>{c}</li>
                        ))}
                      </ul>
                    ) : (
                      <span class="padmin__muted">—</span>
                    )}
                  </td>
                  <td class="tnum">{formatearPrecio(s.precioMin, s.precioMax)}</td>
                  <td class="tnum">{formatearHoras(s.horasMin, s.horasMax)}</td>
                  <td class="padmin__flujo">
                    {flujo.length > 0 ? (
                      <details class="padmin__details">
                        <summary>
                          {flujo.length} {flujo.length === 1 ? 'paso' : 'pasos'}
                        </summary>
                        <ol class="padmin__pasos">
                          {flujo.map((paso) => (
                            <li>
                              <span class="padmin__paso-titulo">
                                {paso.orden}. {paso.paso}
                                <span class="padmin__paso-horas">{paso.horas} h</span>
                              </span>
                              {paso.descripcion && (
                                <span class="padmin__paso-desc">{paso.descripcion}</span>
                              )}
                            </li>
                          ))}
                        </ol>
                      </details>
                    ) : (
                      <span class="padmin__muted">Sin flujo cargado</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <p class="padmin__note">
        Nota: los precios se expresan en pesos argentinos (ARS). La tabla se
        genera en build-time desde la fuente de verdad única
        (<code>src/data/soluciones/</code>); no requiere fetch en runtime.
      </p>
    </div>
  </section>
</Layout>

<style>
  .padmin__eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tertiary-dark);
    background: rgba(0, 122, 255, 0.08);
    border-radius: var(--rounded-full);
    padding: 4px 12px;
    margin: 0 0 var(--spacing-md);
  }
  .padmin__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--primary);
    margin: 0 0 var(--spacing-sm);
  }
  .padmin__subtitle {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 0 var(--spacing-lg);
    max-width: 70ch;
  }
  .padmin__subtitle code {
    font-size: 0.85em;
    background: rgba(0, 0, 0, 0.05);
    padding: 1px 6px;
    border-radius: var(--rounded-xs);
  }

  /* Tabla */
  .padmin__table-wrap {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid #E8E8E8;
    border-radius: var(--rounded-md);
  }
  .padmin__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .padmin__table th {
    text-align: left;
    color: var(--muted);
    font-weight: 600;
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid #E0E0E0;
    white-space: nowrap;
  }
  .padmin__table td {
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid #F0F0F0;
    vertical-align: top;
    color: var(--secondary);
  }
  .padmin__table tbody tr:hover td {
    background: #F9F9FB;
  }
  .padmin__table .tnum {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .padmin__id {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .padmin__nombre {
    font-weight: 600;
    color: var(--primary);
  }
  .padmin__muted {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .padmin__cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .padmin__cats li {
    font-size: 0.82rem;
  }

  /* Detalle expandible de pasos */
  .padmin__details summary {
    cursor: pointer;
    color: var(--tertiary);
    font-size: 0.82rem;
    font-weight: 600;
    display: inline-block;
    padding: 4px 10px;
    background: rgba(0, 122, 255, 0.08);
    border-radius: var(--rounded-sm);
    border: 1px solid rgba(0, 122, 255, 0.15);
    user-select: none;
  }
  .padmin__details summary::-webkit-details-marker {
    display: none;
  }
  .padmin__details summary::before {
    content: '▶ ';
    font-size: 0.7rem;
  }
  .padmin__details[open] summary::before {
    content: '▼ ';
  }
  .padmin__pasos {
    margin: var(--spacing-sm) 0 0;
    padding: 0 0 0 var(--spacing-lg);
    list-style: decimal outside;
  }
  .padmin__pasos li {
    margin-bottom: var(--spacing-sm);
  }
  .padmin__paso-titulo {
    display: block;
    font-weight: 600;
    color: var(--primary);
    font-size: 0.84rem;
  }
  .padmin__paso-horas {
    margin-left: 6px;
    font-weight: 600;
    color: var(--tertiary-dark);
    font-size: 0.78rem;
  }
  .padmin__paso-desc {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .padmin__note {
    margin-top: var(--spacing-lg);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .padmin__note code {
    font-size: 0.85em;
    background: rgba(0, 0, 0, 0.05);
    padding: 1px 6px;
    border-radius: var(--rounded-xs);
  }
</style>
