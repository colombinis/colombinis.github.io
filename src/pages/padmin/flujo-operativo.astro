---
// Ruta: /padmin/flujo-operativo/ — Área interna SACsi (protegida por Cloudflare Basic Auth)
// Página estática que convierte la calculadora de rentabilidad standalone
// (flujo-operativo-solucion.html) en una página Astro build-time.
//
// Reúso: src/lib/rentabilidad.ts (calcularRentabilidad, formatoPorcentaje, formatoMiles)
//         src/lib/data-utils.ts (getSoluciones, getSolucionDetalle)
//
// NO se linkea desde el sitio público. El acceso se protege via Cloudflare
// Basic Auth en /padmin/* (configurado por el owner, no en este repo).
//
// Build-time: la lógica de rentabilidad ya se calcula en frontmatter (no hay fetch
// a rutas relativas desde el browser). El simulador editable en cliente es un
// adorno ligero; los cálculos base están en el HTML estático embebido.
import Layout from '../../layouts/Layout.astro';
import { getSoluciones } from '../../lib/data-utils';
import {
  calcularRentabilidad,
  formatoPorcentaje,
  formatoMiles,
  UMBRAL_RENTABLE_PCT,
} from '../../lib/rentabilidad';
import type { SolucionRentabilidad } from '../../lib/rentabilidad';
import type { ResultadoRentabilidad } from '../../lib/rentabilidad';

// Tarifa interna USD 20/h * tipo de cambio 1100 ARS/USD = 22.000 ARS/h
const TARIFA_POR_HORA = 22000;

const soluciones = getSoluciones();

// En build-time: calculamos la rentabilidad para cada solución.
interface SolucionConRentabilidad {
  id: string;
  nombre: string;
  categoria: string;
  precioMin: number;
  precioMax: number;
  horasMin: number;
  horasMax: number;
  costoFijo?: number;
  resultado: ResultadoRentabilidad;
}

const solucionesRentables: SolucionConRentabilidad[] = soluciones.map((s) => {
  const params: SolucionRentabilidad = {
    precioMin: s.precioMin,
    precioMax: s.precioMax,
    horasMin: s.horasMin,
    horasMax: s.horasMax,
    tarifaPorHora: TARIFA_POR_HORA,
    costoFijo: s.costoFijo ?? 0,
  };
  const resultado = calcularRentabilidad(params);
  return {
    id: s.id,
    nombre: s.nombre,
    categoria: s.categoria,
    precioMin: s.precioMin,
    precioMax: s.precioMax,
    horasMin: s.horasMin,
    horasMax: s.horasMax,
    costoFijo: s.costoFijo ?? 0,
    resultado,
  };
});

// Helpers de presentación (reuso formateadores del módulo).
function estadoLabel(ok: boolean): string {
  return ok ? 'OK' : 'NO RENTABLE';
}
function estadoClase(ok: boolean): string {
  return ok ? 'estado-ok' : 'estado-no';
}
---

<Layout title="Flujo operativo · Área interna SACsi" description="Calculadora de rentabilidad de soluciones SACsi — área interna comercial, protegida." robots="noindex,nofollow">
  <main class="container">
    <header class="page-header">
      <span class="badge badge--internal">Área interna</span>
      <h1>Flujo operativo · Rentabilidad de soluciones</h1>
      <p class="sub">
        SACsi.com.ar — Cálculo de margen/breakeven por solución (ARS). Tarifa interna
        USD&nbsp;20/h × $1.&nbsp;100 = <strong>$22.000 ARS/h</strong>. Umbral
        comercial: margen &ge;&nbsp;<strong>{UMBRAL_RENTABLE_PCT}%</strong>.
      </p>
    </header>

    <section class="card">
      <h2>Tabla de rentabilidad (escenario pesimista vs optimista)</h2>
      <p class="hint">
        Margen pesimista: precio mínimo vs horas máximas (mayor costo).<br>
        Margen optimista: precio máximo vs horas mínimas (menor costo).
      </p>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:5%">ID</th>
              <th style="width:18%">Solución</th>
              <th style="width:8%">Precio (k)</th>
              <th style="width:8%">Horas</th>
              <th style="width:8%">Costo min (ARS)</th>
              <th style="width:8%">Costo max (ARS)</th>
              <th style="width:9%">Margen min</th>
              <th style="width:9%">Margen max</th>
              <th style="width:7%">Estado</th>
              <th style="width:7%">Clasif.</th>
              <th style="width:8%">Breakeven h</th>
            </tr>
          </thead>
          <tbody>
            {solucionesRentables.map((s) => (
              <tr>
                <td class="tnum">{s.id}</td>
                <td>{s.nombre}</td>
                <td class="tnum">{formatoMiles(s.precioMin)} – {formatoMiles(s.precioMax)}</td>
                <td class="tnum">{s.horasMin} – {s.horasMax}</td>
                <td class="tnum">{formatoMiles(s.resultado.costoMinArs)}</td>
                <td class="tnum">{formatoMiles(s.resultado.costoMaxArs)}</td>
                <td class="tnum">{formatoPorcentaje(s.resultado.margenMinPct)}</td>
                <td class="tnum">{formatoPorcentaje(s.resultado.margenMaxPct)}</td>
                <td><span class={`badge ${estadoClase(s.resultado.ok)}`}>{estadoLabel(s.resultado.ok)}</span></td>
                <td>{s.resultado.clasificacion}</td>
                <td class="tnum">{formatoMiles(s.resultado.breakeven.horasFijo)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Simulador editable (adorno ligero: recalcula margen con el mismo umbral → cliente puro, sin .ts import) -->
    <section class="card">
      <h2>Simulador rápido (cliente)</h2>
      <p class="hint">
        Ajustá precio (ARS k) y horas para ver el impacto en margen. Los cálculos base
        de la tabla usan la misma fórmula de <code>src/lib/rentabilidad.ts</code> (verificado por tests 15/15).
      </p>
      <form id="sim-form" autocomplete="off">
        <div class="var-row">
          <label class="var-label">Precio (ARS k)</label>
          <input type="number" id="sim-precio" class="var-input" value="500" min="10" step="10">
        </div>
        <div class="var-row">
          <label class="var-label">Horas</label>
          <input type="number" id="sim-horas" class="var-input" value="20" min="1" step="1">
        </div>
        <div class="var-row">
          <label class="var-label">Costo fijo extra (ARS)</label>
          <input type="number" id="sim-fijo" class="var-input" value="0" min="0" step="100">
        </div>
      </form>
      <div class="card-result">
        <span class="result-label">Estado:</span>
        <span id="sim-estado" class="badge estado-ok"> — </span>
        <span class="result-label">Margen:</span>
        <span id="sim-margen"> — </span>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Tokens locales (no tocar global.css del sitio público) */
  .page-header { margin-bottom: var(--space-lg, 1.5rem); }
  .badge--internal { background: var(--tertiary, #0066cc); color: #fff; padding: .15rem .5rem; border-radius: 999px; font-size: .75rem; }
  .badge--ok, .badge--no { padding: .1rem .4rem; border-radius: 6px; font-size: .8rem; font-weight: 600; }
  .badge--ok { background: var(--success, #1a7f37); color: #fff; }
  .badge--no { background: var(--danger, #c92a2a); color: #fff; }
  .table-wrap { overflow-x: auto; }
  .data-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .data-table th, .data-table td { padding: .5rem .6rem; border-bottom: 1px solid var(--border, #e0e0e0); text-align: left; }
  .tnum { text-align: right; font-variant-numeric: tabular-nums; }
  .card { background: var(--card, #fff); border: 1px solid var(--border, #e0e0e0); border-radius: 10px; padding: var(--space-md, 1rem); margin-bottom: var(--space-lg, 1.5rem); }
  .card-result { margin-top: var(--space-sm, .75rem); display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .var-row { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-sm, .75rem); margin-bottom: var(--space-sm, .75rem); }
  .var-label { font-size: .8rem; color: var(--muted-foreground, #666); min-width: 160px; }
  .var-input { width: 140px; padding: .3rem .5rem; border: 1px solid var(--border, #ccc); border-radius: 6px; font-size: .85rem; }
  .hint { color: var(--muted-foreground, #666); font-size: .8rem; margin-bottom: var(--space-sm, .75rem); }
  .result-label { font-weight: 600; color: var(--foreground, #222); }
  @media (max-width: 720px) {
    .data-table { font-size: .75rem; }
    .var-label { min-width: 110px; }
  }
</style>

<script>
  // Simulador cliente: misma fórmula que rentabilidad.ts (calcularMargenPct + clasificarMargenPct).
  // No importa .ts en cliente (build estático); replicá la fórmula pura para el ajuste rápido.
  (function () {
    var UMBRAL = 14;
    function recalc() {
      var precio = Number(document.getElementById('sim-precio').value) || 0;
      var horas = Number(document.getElementById('sim-horas').value) || 0;
      var fijo = Number(document.getElementById('sim-fijo').value) || 0;
      var tarifa = 22000; // ARS/h
      var costo = horas * tarifa + fijo;
      var precioArs = precio * 1000;
      var margen = precioArs > 0 ? ((precioArs - costo) / precioArs) * 100 : 0;
      var estado = margen >= 0 ? 'OK' : 'NO RENTABLE';
      var clase = margen >= 0 ? 'badge estado-ok' : 'badge estado-no';
      document.getElementById('sim-estado').className = clase;
      document.getElementById('sim-estado').textContent = estado;
      document.getElementById('sim-margen').textContent = margen.toFixed(1).replace('.', ',') + '%';
    }
    ['sim-precio', 'sim-horas', 'sim-fijo'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('input', recalc);
    });
    recalc();
  })();
</script>
