---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sobre Nosotros · Rosario" description="Conocé a SACsi, soluciones informáticas en Rosario. Más de 15 años ayudando a PyMEs con automatización, software a medida y presencia online.">
  <section class="hero">
    <div class="hero__container">
      <p class="hero__label">NOSOTROS</p>
      <h1 class="hero__title">Sobre SACsi</h1>
      <p class="hero__subtitle">
        Somos un equipo de desarrolladores y consultores con más de 15 años ayudando a PyMEs a integrar tecnología sin fricción.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">Números</h2>
      <div class="stats-grid">
        <div class="stat">
          <span class="stat__number">+15</span>
          <span class="stat__label">años de experiencia</span>
        </div>
        <div class="stat">
          <span class="stat__number">+50</span>
          <span class="stat__label">proyectos entregados</span>
        </div>
        <div class="stat">
          <span class="stat__number">+30</span>
          <span class="stat__label">clientes activos</span>
        </div>
        <div class="stat">
          <span class="stat__number">100%</span>
          <span class="stat__label">proyectos en Rosario</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">Equipo</h2>
      <div class="team-grid">
        <div class="team-card">
          <div class="team-card__avatar">SC</div>
          <h3 class="team-card__name">Sebastián Colombini</h3>
          <p class="team-card__role">Fundador / Lead Developer</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">Clientes que confían</h2>
      <div class="clients-grid">
        <span class="client-badge">Ferretería</span>
        <span class="client-badge">Tienda de ropa</span>
        <span class="client-badge">E-commerce</span>
        <span class="client-badge">Academia online</span>
        <span class="client-badge">Consultorio</span>
        <span class="client-badge">Medio digital</span>
        <span class="client-badge">Estudio de arquitectura</span>
        <span class="client-badge">Café de especialidad</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">Nuestra historia</h2>
      <p style="max-width:720px;margin:0 auto;color:var(--secondary);">
        SACsi nació en Rosario con la idea de que la tecnología no tiene por qué ser complicada. Trabajamos con empresas de diferentes rubros —desde comercios hasta industrias— adaptando soluciones a su realidad, no al revés.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">Cómo trabajamos</h2>
      <div class="steps">
        <div class="step">
          <div class="step__number">1</div>
          <h3>Descubrimiento</h3>
          <p>Entendemos tu negocio antes de proponer cualquier solución.</p>
        </div>
        <div class="step">
          <div class="step__number">2</div>
          <h3>Diagnóstico</h3>
          <p>Generamos una propuesta clara, con alcance y tiempos definidos.</p>
        </div>
        <div class="step">
          <div class="step__number">3</div>
          <h3>Prototipo</h3>
          <p>Construimos en iteraciones cortas con entregas visibles.</p>
        </div>
        <div class="step">
          <div class="step__number">4</div>
          <h3>Producción</h3>
          <p>Soporte post-entrega y evolución continua.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
