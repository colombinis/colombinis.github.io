---
// Página: Sobre Nosotros — Historia, Filosofía "Tecnología Justa", Equipo y Clientes
//
// Entrada de la página: organismo HeroRow (§10b "Fila Hero + Slider (portada
// de la home)") — hero a la izquierda con el contenido previo de la página y,
// a la derecha, el carrusel con los 4 pilares. La sección "Los 4 pilares de
// la Tecnología Justa" se eliminó: sus cards viven ahora como slides.
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import BioCard from '../components/BioCard.astro';
import ClientesConfian from '../components/ClientesConfian.astro';
import HeroRow from '../components/HeroRow.astro';

const clientes = [
  { name: 'MLR Sistemas', url: 'https://mlrsistemas.com.ar/', logo: '/assets/clientes/mlr-sistemas.webp', description: 'Sistemas de gestión y software empresarial' },
  { name: 'Syloper', url: 'https://syloper.com/', logo: '/assets/clientes/syloper.svg', description: 'Consultoría y desarrollo de software' },
  { name: 'Ameba', url: 'https://www.ameba.com.uy/en', logo: '/assets/clientes/ameba.svg', description: 'Diseño y desarrollo de plataformas digitales' },
  { name: 'SOESGPYLA', url: 'https://www.soesgpyla.com.ar/', logo: '/assets/clientes/soesgpyla.svg', description: 'Sindicato Obreros Estaciones de Servicio' },
  { name: 'Grupo El Positivo', url: 'https://www.grupoelpositivo.com.ar/', logo: '/assets/clientes/grupo-el-positivo.png', description: 'Comercialización y distribución de artículos' },
  { name: 'e-Softing', url: 'https://e-softing.com.ar/', logo: '/assets/clientes/e-softing.svg', description: 'Soluciones tecnológicas e infraestructura' },
  { name: '1950labs', url: 'https://1950labs.com/', logo: '/assets/clientes/1950labs.png', description: 'Staff augmentation y desarrollo de software' },
  { name: 'Tornillo Alvear', url: 'https://www.tornilloalvear.com/', logo: '/assets/clientes/tornillo-alvear.png', description: 'Fijaciones, tornillería y ferretería industrial' },
  { name: 'Fenicio', url: 'https://fenicio.io/', logo: '/assets/clientes/fenicio.png', description: 'Plataforma e-commerce para marcas' },
  { name: 'ON94', url: 'https://on94.com.ar/', logo: '/assets/clientes/on94.png', description: 'Radio online — Santa Fe, Argentina' },
  { name: 'Onmedia', url: 'https://onmedia.uy/', logo: '/assets/clientes/onmedia.png', description: 'Radio online — Maldonado, Uruguay' },
  { name: 'eLearn Guitar', url: 'http://elearnguitar.com/', logo: '/assets/clientes/elearnguitar.png', description: 'Enseñanza y partituras de guitarra clásica en línea' }
];

// Slides del slider de la fila Hero+Slider (§10b): las 4 cards de "Los 4
// pilares de la Tecnología Justa", con el mismo título y texto. Los pilares
// no tienen página de destino propia: cada slide enlaza al CTA de la página
// (/contacto/), la acción que comparten todos.
const pilaresSlides = [
  {
    id: 'sin-sobredimensionar',
    title: 'Sin sobredimensionar',
    claim:
      'No te proponemos un desarrollo de seis meses para algo que un script o una automatización directa resuelve en una semana. El tamaño de la solución debe ser proporcional a tu volumen y rentabilidad.',
    href: '/contacto/',
    imagen: '/assets/sacsi-servicios-09-automatizacion-procesos.webp',
  },
  {
    id: 'sin-modas-pasajeras',
    title: 'Sin modas pasajeras',
    claim:
      'Elegimos tecnologías maduras, robustas y ampliamente documentadas. No usamos herramientas solo porque sean tendencia en redes. Lo que construimos tiene que seguir funcionando firme durante años.',
    href: '/contacto/',
    imagen: '/assets/sacsi-servicios-11-soporte-mantenimiento.webp',
  },
  {
    id: 'entendemos-cada-peso',
    title: 'Entendemos lo que cuesta cada peso',
    claim:
      'En Argentina cada inversión cuenta. Calculamos el retorno antes de empezar: cada automatización o sistema debe pagarse solo, ahorrando horas operativas o generando nuevas oportunidades de venta.',
    href: '/contacto/',
    imagen: '/assets/sacsi-servicios-13-dashboards.webp',
  },
  {
    id: 'honestidad-radical',
    title: 'Honestidad radical',
    claim:
      'Si en la primera charla vemos que tu problema se soluciona ordenando un procedimiento interno o usando una planilla gratuita, te lo decimos de frente. Tu confianza vale mucho más que una venta forzada.',
    href: '/contacto/',
    imagen: '/assets/sacsi-servicios-12-consultoria-ia.webp',
  },
];
---

<Layout
  title="Sobre Nosotros · Tecnología Justa | SACsi"
  description="Conocé a SACsi y la historia de Sebastián Colombini: más de 15 años acompañando empresas desde Rosario con tecnología justa, sin modas y cuidando cada peso."
>
  <!-- Entrada: fila Hero + Slider (§10b) — izquierda = hero con el contenido
       previo de la página; derecha = carrusel con los 4 pilares. -->
  <HeroRow
    hero={{
      titleAccent: '',
      title: 'Sobre Nosotros: Tecnología justa para tu negocio',
      subtitle:
        'Creemos que la tecnología debe resolver problemas reales, no crearlos. Ni modas pasajeras, ni costos sobredimensionados: solo lo que realmente necesitás para crecer.',
      ctaLabel: 'Te decimos qué necesitás… y qué no. Consulta sin cargo',
      ctaHref: '/contacto/',
    }}
    slides={pilaresSlides}
    sliderLabel="Los 4 pilares de la Tecnología Justa"
  />

  <!-- Historia de Sebastián / El Origen -->
  <section class="section section--alt">
    <div class="container philosophy-grid">
      <BioCard />

      <div class="bio-text">
        <Badge variant="accent" size="sm" class="section-tag">EL ORIGEN</Badge>
        <h2>+15 años acompañando empresas desde Rosario</h2>
        <p>
          <strong>SACsi nace de las iniciales de Sebastián Alejandro Colombini</strong>. Empecé a desarrollar software colaborando con comercios familiares de la región, luego tuve la oportunidad de trabajar en grandes empresas multinacionales.
        </p>
        <p>
          En ese tiempo vi repetirse el mismo patrón una y otra vez: profesionales, PyMEs y pequeños comercios familiares que querian vender por internet se ven confundidos por la enorme cantidad de herramientas y promesas de marketing digital. Y terminan pagando mucho más de lo que necesitan, con resultados mediocres.
        </p>
        <p>
          Fundé SACsi para ser el contrapeso de esa tendencia. Para decirle a los dueños de negocios la verdad: <em>qué tecnología necesitás hoy y cuál no te conviene pagar</em>.
        </p>
      </div>
    </div>
  </section>

  <!-- Sección Clientes que confían con Logos Reales -->
  <ClientesConfian clientes={clientes} />

  <!-- Cómo trabajamos -->
  <section class="section section--alt">
    <div class="container">
      <div class="steps-header">
        <Badge variant="accent" size="sm" class="section-tag">METODOLOGÍA</Badge>
        <h2 class="section__title">Cómo trabajamos</h2>
        <p class="section__subtitle">Procesos claros, iteraciones cortas y entregas continuas sin sorpresas.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step__number">1</div>
          <h3>Descubrimiento</h3>
          <p>Entendemos tu negocio antes de proponer cualquier solución.</p>
        </div>
        <div class="step">
          <div class="step__number">2</div>
          <h3>Diagnóstico</h3>
          <p>Generamos una propuesta clara, con alcance y tiempos definidos.</p>
        </div>
        <div class="step">
          <div class="step__number">3</div>
          <h3>Prototipo</h3>
          <p>Construimos en iteraciones cortas con entregas visibles.</p>
        </div>
        <div class="step">
          <div class="step__number">4</div>
          <h3>Producción</h3>
          <p>Soporte post-entrega y evolución continua.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Historia & Filosofía */
  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  @media (min-width: 768px) {
    .philosophy-grid {
      grid-template-columns: minmax(320px, 420px) 1fr;
    }
  }

  /* .section-tag: display/box lo aporta <Badge>; se conserva la tipografía de etiqueta de sección */
  .section-tag {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--tertiary-dark);
    text-transform: uppercase;
    margin-bottom: var(--spacing-xs);
  }

  .bio-text h2 {
    font-size: 1.8rem;
    margin: 0 0 var(--spacing-md);
    line-height: 1.3;
    color: var(--primary);
  }

  .bio-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--secondary);
    margin-bottom: var(--spacing-md);
  }

  /* Pilares */
  .clients-header,
  .steps-header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  /* Equipo */
  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    max-width: 960px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* .team-card: fondo, borde, radio, padding y transición los aporta <Card variant="default" padding="lg"> */
  .team-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .team-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
  }

  .team-card__avatar {
    width: 68px;
    height: 68px;
    background: var(--primary, #1A1A2E);
    color: #FFFFFF;
    font-size: 1.35rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-md);
    border: 3px solid #EBF4FF;
  }

  .team-card:nth-child(2) .team-card__avatar {
    background: var(--tertiary-dark, #0066CC);
  }

  .team-card:nth-child(3) .team-card__avatar {
    background: #059669;
  }

  .team-card__name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary, #1A1A2E);
    margin: 0 0 4px;
  }

  .team-card__role {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--tertiary, #0A7CFF);
    margin: 0 0 var(--spacing-sm);
  }

  .team-card__bio {
    font-size: 0.9rem;
    color: var(--secondary, #444444);
    line-height: 1.45;
    margin: 0;
  }

  /* Clientes con Logos Reales */
  .clients-logo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }
</style>
