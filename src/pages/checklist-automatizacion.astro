---
// Página: Lead Magnet Checklist Automatización
// Captura email → descarga directa de PDF sin login
import Layout from '../layouts/Layout.astro';
import config from '../config/site.json';
import { Check, Lock, CheckCircle2 } from 'lucide-astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Input from '../components/ui/Input.astro';

const formEndpoint = config.contact.form_endpoint;
---

<Layout
  title="Checklist Gratis: ¿Tu negocio necesita automatización? · PyMEs Rosario"
  description="Descargá gratis el checklist práctico para PyMEs en Rosario. Detectá tareas repetitivas y cuellos de botella para automatizar con tecnología justa y sin sobrecostos."
>
  <section class="hero">
    <div class="hero__container">
      <Badge variant="accent" class="hero__badge">RECURSO GRATUITO PARA PYMES</Badge>
      <h1 class="hero__title">Checklist: ¿Tu negocio necesita automatización?</h1>
      <p class="hero__subtitle">
        Descubrí en menos de 5 minutos si estás perdiendo horas valiosas y dinero en tareas manuales que pueden funcionar solas con tecnología justa y sin sobrecostos.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container checklist-container">
      <div class="checklist-info">
        <h2>¿Qué vas a evaluar en este checklist?</h2>
        <ul class="checklist-items">
          <li>
            <span class="check-icon"><Check size={14} aria-hidden="true" /></span>
            <div>
              <strong>Carga repetitiva de datos:</strong>
              <p>Evaluá cuántas horas semanales dedica tu equipo a copiar y pegar datos entre WhatsApp, planillas de Excel y sistemas de AFIP.</p>
            </div>
          </li>
          <li>
            <span class="check-icon"><Check size={14} aria-hidden="true" /></span>
            <div>
              <strong>Facturación y cobranzas:</strong>
              <p>Detectá cuellos de botella en la emisión de comprobantes, control de deudas y avisos de cobro a clientes.</p>
            </div>
          </li>
          <li>
            <span class="check-icon"><Check size={14} aria-hidden="true" /></span>
            <div>
              <strong>Stock e inventario desincronizado:</strong>
              <p>Comprobá si los quiebres de stock o errores de entrega se deben a falta de actualización en tiempo real.</p>
            </div>
          </li>
          <li>
            <span class="check-icon"><Check size={14} aria-hidden="true" /></span>
            <div>
              <strong>Matriz de decisión honesta:</strong>
              <p>Te enseñamos cuándo conviene armar una solución simple y cuándo es preferible no invertir y seguir manual.</p>
            </div>
          </li>
        </ul>

        <Card variant="default" padding="md" class="checklist-guarantee">
          <p><strong>Filosofía SACsi:</strong> Elegimos la tecnología adecuada, no la de moda. Entendemos lo que cuesta cada peso y no te vendemos nada que no necesites.</p>
        </Card>
      </div>

      <Card variant="accent" padding="lg">
        <div class="card-header">
          <h3>Descargá la guía en PDF</h3>
          <p>Completá tu nombre y email para descargar el archivo de inmediato. Sin registro ni contraseñas.</p>
        </div>

        <form id="lead-magnet-form" method="POST" action={formEndpoint}>
          <input type="hidden" name="categoria" value="checklist-automatizacion" />
          <input type="hidden" name="source" value="lead-magnet-checklist" />
          {/* Honeypot anti-spam (el worker lo respeta: si llega lleno, devuelve ok y descarta) */}
          <input type="text" name="website" tabindex={-1} autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;" />
          {/* El worker exige `message`; para el lead magnet enviamos un valor fijo */}
          <input type="hidden" name="message" value="Descarga del checklist de automatización (lead magnet)" />

          <Input
            id="lm-nombre"
            name="nombre"
            type="text"
            required={true}
            label="Tu nombre"
            placeholder="Ej: Mariano López"
          />

          <Input
            id="lm-email"
            name="email"
            type="email"
            required={true}
            label="Tu email de trabajo"
            placeholder="tu@empresa.com"
          />

          <Input
            id="lm-rubro"
            name="rubro"
            type="text"
            label="Rubro o actividad de tu negocio (opcional)"
            placeholder="Ej: Distribuidora, Ferretería, Comercio"
          />

          <Button type="submit" variant="primary" id="lm-submit" class="checklist-submit">
            Descargar Checklist en PDF (Gratis)
          </Button>

          {/* Turnstile: el worker exige cf-turnstile-response (patrón de /contacto) */}
          <div class="cf-turnstile" data-sitekey={config.contact.turnstile_site_key} data-theme="light" data-size="compact"></div>
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

          <p class="form-status" id="lm-status" role="status" aria-live="polite"></p>

          <p class="form-privacy">
            <Lock size={13} aria-hidden="true" style="display:inline;vertical-align:-1px;margin-right:4px;" />
            <span>Respetamos tu privacidad. No enviamos spam ni compartimos tus datos.</span>
          </p>
        </form>

        <div id="lm-success" class="lead-success" style="display:none;">
          <div class="success-icon">
            <CheckCircle2 size={44} color="#059669" aria-hidden="true" />
          </div>
          <h4>¡Listo! Tu descarga está lista</h4>
          <p>La descarga del checklist comenzará en unos segundos.</p>
          <Button
            variant="primary"
            id="download-btn-direct"
            href="/descargas/checklist-automatizacion-pymes-sacsi.pdf"
            download="Checklist-Automatizacion-SACsi.pdf"
            class="checklist-download"
          >
            Hacé clic acá si no descargó automáticamente
          </Button>
          <p class="next-step-note">
            ¿Querés saber qué conviene automatizar primero en tu caso? <a href="/soluciones/diagnostico-ia/">Empezá con un Diagnóstico IA express</a> y recibí un roadmap con ROI estimado.
          </p>
        </div>
      </Card>
    </div>
  </section>
</Layout>

<style>
  .checklist-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xxl);
    align-items: start;
    max-width: 1040px;
    margin: 0 auto;
  }

  @media (min-width: 860px) {
    .checklist-container {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  /* Eyebrow del hero (Badge): la Badge aporta el estilo de píldora;
     solo ajustamos el margen inferior propio de esta página. */
  .hero__badge {
    margin-bottom: var(--spacing-md);
  }

  .checklist-info h2 {
    font-size: 1.6rem;
    margin-bottom: var(--spacing-lg);
  }

  .checklist-items {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .checklist-items li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .check-icon {
    background: #EBF4FF;
    color: var(--tertiary-dark);
    font-weight: 700;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .checklist-items strong {
    color: var(--primary);
    display: block;
    margin-bottom: 2px;
  }

  .checklist-items p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--secondary);
    line-height: 1.5;
  }

  /* Callout de garantía: la Card (variant default) aporta superficie,
     borde, radio y sombra; el acento azul a la izquierda es exclusivo
     de esta página (selector más específico para ganarle al borde
     base de .ui-card). */
  .checklist-info .checklist-guarantee {
    border-left: 4px solid var(--tertiary);
  }

  .checklist-guarantee p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--secondary);
    line-height: 1.6;
  }

  .card-header h3 {
    font-size: 1.35rem;
    margin: 0 0 var(--spacing-xs);
  }

  .card-header p {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 var(--spacing-lg);
    line-height: 1.5;
  }

  #lead-magnet-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  /* Botón de envío: la Button (variant primary) aporta el estilo base;
     el ancho completo y el margen son propios de este formulario. */
  .checklist-submit {
    width: 100%;
    margin-top: var(--spacing-xs);
  }

  .form-privacy {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
    text-align: center;
  }

  /* Estado de envío (mismo patrón que FormContactoProgresivo) */
  .form-status {
    font-size: 0.88rem;
    margin: var(--spacing-sm) 0 0;
    text-align: center;
    min-height: 1.2em;
  }
  .form-status--error { color: #E53935; font-weight: 500; }
  .form-status--success { color: #128C7E; font-weight: 600; }

  .lead-success {
    text-align: center;
    padding: var(--spacing-lg) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .success-icon {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-xs);
  }

  .lead-success h4 {
    font-size: 1.3rem;
    color: var(--primary);
    margin: 0 0 var(--spacing-xs);
    line-height: 1.3;
  }

  .lead-success p {
    font-size: 0.95rem;
    color: var(--secondary);
    margin: 0 0 var(--spacing-sm);
    line-height: 1.5;
  }

  /* Botón de descarga directa: la Button (variant primary, href → <a>)
     aporta el estilo base; ancho completo y margen son propios de
     esta página. */
  .checklist-download {
    width: 100%;
    margin: var(--spacing-md) 0;
    overflow-wrap: break-word;
  }

  .next-step-note {
    font-size: 0.88rem;
    color: var(--muted);
    margin-top: var(--spacing-md);
    line-height: 1.5;
    overflow-wrap: break-word;
  }
</style>

<script>
  (function () {
    var form = document.getElementById('lead-magnet-form') as HTMLFormElement | null;
    var successDiv = document.getElementById('lm-success');
    var downloadBtn = document.getElementById('download-btn-direct');
    var statusEl = document.getElementById('lm-status') as HTMLElement | null;
    if (!form || !successDiv) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var nombre = (form.querySelector('#lm-nombre') as HTMLInputElement)?.value.trim();
      var email = (form.querySelector('#lm-email') as HTMLInputElement)?.value.trim();

      if (!nombre || !email || email.indexOf('@') === -1) {
        alert('Por favor, ingresá un nombre y un email válido.');
        return;
      }

      // Turnstile: el worker rechaza sin token (BUG-01). Si el widget no
      // inyectó el token todavía, frenamos y mostramos el error.
      var turnstileToken = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
      if (!turnstileToken || !turnstileToken.value) {
        statusEl.textContent = 'Completá la verificación de seguridad antes de descargar.';
        statusEl.className = 'form-status form-status--error';
        return;
      }

      // Enviar evento a dataLayer si existe
      if (typeof window !== 'undefined' && (window as any).dataLayer) {
        (window as any).dataLayer.push({
          event: 'lead_magnet_download',
          resource: 'checklist-automatizacion',
          lead_email: email,
        });
      }

      // Enviar al endpoint y SOLO mostrar éxito si el worker responde ok.
      // (BUG-01: antes esto era fire-and-forget y un 400 del worker se
      // disfrazaba como éxito — el lead se perdía en silencio.)
      var formData = new FormData(form);
      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' },
      })
        .then(function (resp) {
          if (!resp.ok) {
            statusEl.textContent = 'No pudimos registrar tu descarga. Probá de nuevo o escribinos por WhatsApp.';
            statusEl.className = 'form-status form-status--error';
            if (typeof window !== 'undefined' && (window as any).turnstile) {
              (window as any).turnstile.reset();
            }
            return;
          }
          // Éxito real: registrar evento y mostrar pantalla de descarga
          if (typeof window !== 'undefined' && (window as any).dataLayer) {
            (window as any).dataLayer.push({
              event: 'form_submit',
              form_name: 'lead-magnet-checklist',
            });
          }
          form.style.display = 'none';
          successDiv.style.display = 'flex';

          // Disparar descarga directa del PDF
          var downloadUrl = '/descargas/checklist-automatizacion-pymes-sacsi.pdf';
          var a = document.createElement('a');
          a.href = downloadUrl;
          a.download = 'Checklist-Automatizacion-SACsi.pdf';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        })
        .catch(function () {
          statusEl.textContent = 'Error de conexión. Escribinos por WhatsApp.';
          statusEl.className = 'form-status form-status--error';
        });
    });
  })();
</script>
