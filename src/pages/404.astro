---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import { AlertTriangle } from 'lucide-astro';
---

<Layout
  title="Página no encontrada"
  description="La página que buscás no existe. Volvé a la página de inicio o contactanos por WhatsApp."
  robots="noindex, follow"
>
  <section class="hero">
    <div class="hero__container">
      <div class="not-found__badge">
        <AlertTriangle size={24} aria-hidden="true" />
      </div>
      <h1 class="hero__title">Página no encontrada</h1>
      <p class="hero__subtitle">
        La página que estás buscando no existe o fue movida. No te preocupes, podés volver a la página de inicio o escribirnos directamente.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* Medallón circular de icono de alerta — composición page-specific con tokens.
     No mapea a <Card> (no es una caja de contenido con border+padding) ni a
     <Badge> (no es una píldora de texto), así que se queda como CSS propio. */
  .not-found__badge {
    width: 64px;
    height: 64px;
    background: rgba(10, 127, 255, 0.1);
    border-radius: var(--rounded-full);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--spacing-md);
    color: var(--tertiary);
  }
</style>
