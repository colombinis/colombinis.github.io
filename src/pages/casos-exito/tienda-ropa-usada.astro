---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const title = 'Tienda de ropa usada con pagos automáticos a donantes';
const description = 'Caso de éxito: digitalización de una tienda de ropa usada con pagos automáticos a donantes y catálogo online.';
---

<CaseStudyLayout
  title={title}
  description={description}
  cliente="Tienda de ropa usada"
  heroLabel="CASO DE ÉXITO"
  heroSubtitle="Cómo una PyME de ropa usada escaló registrando prendas en dos pasos, publicando automáticamente y pagando a donantes sin mover efectivo."
  imagen="/assets/sacsi-casos-34-tienda-ropa-usada.webp"
  problema="El administrativo se comía gran parte del día: cargar stock, sacar fotos, publicar en la tienda y conciliar los pagos de los donantes. Crecían las ventas pero también los errores y las horas de trabajo."
  solutions={[
    { icon: '📦', title: 'Registro express', text: 'Formulario guiado para cargar prendas en dos pasos, con validaciones y generación automática de código.' },
    { icon: '🖼️', title: 'Publicación automática', text: 'Cada carga se publica directo en la tienda online, con imágenes, talles y precios sincronizados.' },
    { icon: '💸', title: 'Pagos a donantes', text: 'Liquidación automática por venta y payout a donantes sin mover efectivo ni cargar transferencias manualmente.' },
  ]}
  testimonial={{
    quote: 'El administrativo se redujo un 70%. Ahora podemos dedicar el tiempo a vender más y no a cargar stock.',
    author: 'Dueña — Tienda de ropa usada',
    role: 'Rosario, Santa Fe',
  }}
  metrics={[
    { value: '70%', label: 'menos tiempo administrativo' },
    { value: '2', label: 'pasos por carga de prenda' },
  ]}
/>
