---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const title = 'Academia online con LMS y membresías sobre WordPress';
const description = 'Caso de éxito: una capacitadora pasó de dar cursos por Zoom y Drive a su propia academia online con acceso por membresía, progreso y certificados automáticos sobre WordPress.';
---

<CaseStudyLayout
  title={title}
  description={description}
  cliente="Academia online"
  heroSubtitle="Una capacitadora que dictaba cursos por Zoom y compartía el material por Drive, con los pagos y accesos gestionados a mano. Quería su propia plataforma con contenido pago, progreso y certificados."
  problema="Sus cursos funcionaban, pero la operación era un rompecabezas: cobraba por transferencia, sumaba a cada alumno a mano a una carpeta de Drive, mandaba los links de Zoom por WhatsApp y armaba los certificados uno por uno en un editor de imágenes. Cada nueva camada de alumnos multiplicaba el trabajo administrativo y no escalaba."
  problemaExtra="Su deseo era tener <strong>su propia academia online</strong>: un lugar donde el alumno pagara, entrara solo, viera las clases en orden, avanzara a su ritmo y, al terminar, obtuviera su certificado. Todo <strong>automático, con su marca</strong>, sin que ella tuviera que dar accesos ni perseguir pagos manualmente."
  vision="Imagino mi academia funcionando sola: el alumno paga, entra, ve las clases en orden, va avanzando y cuando termina descarga su certificado con mi logo. Yo mientras tanto grabo el próximo curso, sin mandar un solo link a mano."
  solutions={[
    { icon: '🎓', title: 'Cursos con LMS', text: 'Montamos los cursos en una plataforma de aprendizaje online (LearnDash): lecciones en orden, contenido liberado por etapas y evaluaciones al final de cada módulo.' },
    { icon: '🔑', title: 'Membresías con pago recurrente', text: 'El acceso se otorga solo al pagar: membresías con cobro recurrente y altas/bajas automáticas, sin gestión manual de accesos.' },
    { icon: '📜', title: 'Progreso y certificados', text: 'Cada alumno ve su avance y descarga su certificado personalizado al completar el curso. Emails automáticos en cada hito.' },
  ]}
  stack={['WordPress', 'LearnDash (LMS)', 'MemberPress', 'Pagos recurrentes', 'ACF', 'Drip content', 'Integración de email']}
  testimonial={{
    quote: 'Dejé de ser la secretaria de mis propios cursos. Ahora la academia funciona sola: los alumnos entran, avanzan y se certifican mientras yo preparo el próximo contenido.',
    author: ' Academia de capacitación profesional',
    role: 'Argentina',
  }}
  metrics={[
    { value: '300+', label: 'alumnos activos' },
    { value: '0', label: 'accesos dados a mano' },
    { value: '100%', label: 'certificados automáticos' },
  ]}
/>
