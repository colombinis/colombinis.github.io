---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const title = 'Consultorio de psicología con alquiler de espacios de atención';
const description = 'Caso de éxito: consultorio de psicología con agenda online, alquiler de consultorios automatizado y presentación a obras sociales centralizada.';
---

<CaseStudyLayout
  title={title}
  description={description}
  heroLabel="CASO DE ÉXITO"
  heroSubtitle="Agenda online, alquiler de consultorios automatizado y presentación a obras sociales centralizada."
  problema="La administración del consultorio era manual: agenda por WhatsApp, turnos cruzados, facturación a obras sociales en PDF y alquiler de consultorios por separado. Con el crecimiento se volvió inmanejable."
  solutions={[
    { icon: '📅', title: 'Agenda online', text: 'Turnos autogestionados por pacientes, recordatorios automáticos y lista de espera inteligente.' },
    { icon: '🏠', title: 'Alquiler de espacios', text: 'Calendario de disponibilidad, reservas automáticas y reglas de precio por franja horaria.' },
    { icon: '📄', title: 'Obras sociales', text: 'Presentación centralizada de prestaciones, seguimiento de autorizaciones y facturación unificada.' },
  ]}
  testimonial={{
    quote: 'El administrativo se redujo un 70%. Los pacientes reservan solos y yo me enfoco en atender.',
    author: 'Directora — Consultorio de psicología',
    role: 'Rosario, Santa Fe',
  }}
  metrics={[
    { value: '70%', label: 'menos carga administrativa' },
    { value: '0', label: 'turnos cruzados' },
  ]}
/>
