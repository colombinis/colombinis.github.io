---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const title = 'Ferretería familiar sin tiempo para la tienda online';
const description = 'Caso de éxito: ferretería de accesorios de gas y plomería que pasó de no tener tienda online a vender sin cargar stock ni configurar pagos.';
---

<CaseStudyLayout
  title={title}
  description={description}
  cliente="Ferretería y gas/plomería"
  heroLabel="CASO DE ÉXITO"
  heroSubtitle="Dueño de una PyME de accesorios de gas y plomería que necesitaba vender más por internet sin perder horas en cargar stock, configurar pagos ni aprender herramientas complicadas."
  problema="El owner no tenía tiempo ni conocimientos para armar una tienda. Quería un canal de venta simple, con pasarelas integradas y sin mantenimiento diario."
  solutions={[
    { icon: '🛒', title: 'Tienda online simple', text: 'Catálogo por categorías, carrito y checkout listo para usar.' },
    { icon: '💳', title: 'Pagos y envíos', text: 'Mercado Pago y correo integrados. Sin comisiones ocultas.' },
    { icon: '📦', title: 'Stock bajo control', text: 'Actualización automática y alertas de mínimo stock.' },
  ]}
  testimonial={{
    quote: 'Ahora la tienda trabaja sola. Subo el precio, actualizo el stock y listo. Las ventas online crecen mes a mes.',
    author: 'Dueño — Ferretería de gas y plomería',
    role: 'Rosario, Santa Fe',
  }}
  metrics={[
    { value: '+35%', label: 'ventas online - 3 meses' },
    { value: '0', label: 'configuración diaria' },
  ]}
/>
