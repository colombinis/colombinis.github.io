---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import BrandIcon from '../components/ui/BrandIcon.astro';
import Logo from '../components/ui/Logo.astro';
import Input from '../components/ui/Input.astro';
import Textarea from '../components/ui/Textarea.astro';
import Accordion from '../components/ui/Accordion.astro';
import Tabs from '../components/ui/Tabs.astro';
import SliderControls from '../components/ui/SliderControls.astro';
import IconResolver from '../components/ui/IconResolver.astro';
import TopBarControl from '../components/TopBarControl.astro';
import Header from '../components/Header.astro';
import ClientesConfian from '../components/ClientesConfian.astro';
import BioCard from '../components/BioCard.astro';
import HeroRow from '../components/HeroRow.astro';
import PorQueSacsiConFoto from '../components/PorQueSacsiConFoto.astro';
import {
  ArrowRight,
  ShieldCheck,
  Check,
  CheckCircle2,
  AlertCircle,
  TrendingUp,
  MapPin,
  Lock,
  MessageSquare,
  Wrench,
  Search,
  ExternalLink,
  Code2,
  Sliders,
  Sparkles,
  Terminal,
  Cpu,
  BarChart3,
  Package,
  Layers
} from 'lucide-astro';

// Datos de demostración para acordeón
const faqDemo = [
  {
    id: 'pyme-justa',
    title: '¿Qué significa "Tecnología Justa" para una PyME?',
    content: 'Significa diseñar e implementar únicamente la tecnología que resuelve el cuello de botella actual de tu operación. <strong>Sin sobredimensionar servidores</strong>, sin obligarte a contratar licencias corporativas innecesarias y cuidando el retorno de cada inversión.'
  },
  {
    id: 'tiempos-implementacion',
    title: '¿Cuánto demora una automatización o sistema a medida?',
    content: 'Un flujo de sincronización o automatización puntual suele desplegarse en 1 a 2 semanas. Desarrollos a medida más integrales se entregan de forma modular en ciclos ágiles de 3 a 4 semanas con entregables funcionales en cada etapa.'
  },
  {
    id: 'primera-consulta',
    title: '¿Cómo funciona la primera conversación sin cargo?',
    content: 'Coordinamos una charla de 20 minutos por videollamada o WhatsApp. Nos contás tus procesos manuales y te decimos con franqueza si conviene avanzar con tecnología o si podés resolverlo con un ajuste organizativo sin costo.'
  }
];

// Pestañas de demostración
const tabsDemo = [
  { id: 'overview', label: 'Visión General' },
  { id: 'tokens', label: 'Tokens de Diseño' },
  { id: 'code-snippet', label: 'Ejemplo de Código' }
];

// Variaciones del logotipo SACsi (Logo.astro)
const logoVariants = [
  {
    id: 'logo-texto',
    label: 'Imagen del logo + texto',
    desc: 'Logo actual (/logo.svg) acompañado del tagline "Soluciones Informáticas".'
  },
  {
    id: 'favicon-texto',
    label: 'Favicon + texto',
    desc: 'Favicon (/favicon.ico) acompañado del tagline "Soluciones Informáticas".'
  },
  {
    id: 'sacsi-color',
    label: 'Texto "SACsi" a color',
    desc: '"SAC" sobre bloque celeste #00A1F1 y "si" sobre bloque naranja #F16529.'
  },
  {
    id: 'sacsi-blanco',
    label: 'Texto "SACsi" en blanco',
    desc: 'Tipografía blanca — pensada para fondos oscuros.'
  },
  {
    id: 'sacsi-naranja',
    label: 'Texto "SACsi" en naranja',
    desc: 'Tipografía naranja de marca #F16529.'
  }
];
---

<Layout
  title="Guía de Componentes y Sistema de Diseño · SACsi"
  description="Guía viva de componentes, tokens y patrones de interfaz para SACsi. Arquitectura limpia inspirada en shadcn/ui y tokens de DESIGN.md."
>
  <div class="guide-hero">
    <div class="container">
      <div class="guide-hero__badge">
        <Badge variant="accent">
          <Terminal size={13} aria-hidden="true" />
          <span>SISTEMA DE DISEÑO VIVO</span>
        </Badge>
      </div>
      <h1 class="guide-hero__title">Guía de Componentes de SACsi</h1>
      <p class="guide-hero__subtitle">
        Catálogo navegable de patrones, controles interactivos y tokens visuales probados en producción. Construido bajo la filosofía de <strong>Tecnología Justa</strong>, sin elementos genéricos de IA ni emojis decorativos.
      </p>

      <!-- Barra de navegación rápida (orden por nivel atómico) -->
      <nav class="guide-nav" aria-label="Navegación del sistema de diseño">
        <a href="#tokens" class="guide-nav__link">Fundaciones · Tokens</a>
        <a href="#botones" class="guide-nav__link">Primitivos · Botones</a>
        <a href="#badges" class="guide-nav__link">Badges</a>
        <a href="#formularios" class="guide-nav__link">Formularios</a>
        <a href="#iconos" class="guide-nav__link">Iconografía</a>
        <a href="#logotipo" class="guide-nav__link">Primitivos · Logotipo</a>
        <a href="#tarjetas" class="guide-nav__link">Composiciones · Tarjetas</a>
        <a href="#bio-card" class="guide-nav__link">Composiciones · Perfil</a>
        <a href="#clientes-confian" class="guide-nav__link">Organismos · Clientes</a>
        <a href="#controles" class="guide-nav__link">Tabs</a>
        <a href="#acordeon" class="guide-nav__link">Acordeón</a>
        <a href="#slider-controls" class="guide-nav__link">Slider</a>
        <a href="#hero-marca" class="guide-nav__link">Organismos · Hero</a>
        <a href="#hero-slider-row" class="guide-nav__link">Organismos · Hero+Slider</a>
        <a href="#slider-demo" class="guide-nav__link">Carrusel</a>
        <a href="#foto-pilares" class="guide-nav__link">Organismos · Foto+Pilares</a>
        <a href="#chrome" class="guide-nav__link">Chrome · TopBar + Menú</a>
      </nav>
    </div>
  </div>

  <main class="container guide-content">

    <!-- Nota de gobernanza: Diseño Atómico (DESIGN.md) -->
    <aside class="governance-note" aria-label="Regla de gobernanza del sistema de diseño">
      <strong>Gobernanza — Diseño Atómico (ver DESIGN.md):</strong> ante cualquier elemento de UI nuevo, el flujo obligatorio es: 1) buscarlo primero en esta guía; 2) si no existe, componerlo con los primitivos de <code>src/components/ui/</code>; 3) si faltan primitivos, preguntar al dueño la fuente; 4) sin respuesta del dueño, tomar como referencia el componente compatible de <a href="https://ui.shadcn.com/docs/components" target="_blank" rel="noopener">ui.shadcn.com</a>, adaptado a Astro + tokens SACsi.
    </aside>

    <!-- 1. FUNDACIONES — TOKENS -->
    <section id="tokens" class="guide-section">
      <div class="section-title-wrap">
        <h2>1. Fundaciones — Tokens Fundamentales (DESIGN.md)</h2>
        <p>Paleta sobria con un 60% de superficie neutra, 30% estructural y 10% de acento de interacción.</p>
      </div>

      <div class="swatches-grid">
        <div class="swatch-card">
          <div class="swatch-color" style="background:#1A1A2E;"></div>
          <div class="swatch-info">
            <strong>Primary</strong>
            <code>#1A1A2E</code>
            <span>Navy profundo / Encabezados</span>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background:#0A7CFF;"></div>
          <div class="swatch-info">
            <strong>Tertiary / Accent</strong>
            <code>#0A7CFF</code>
            <span>Azul eléctrico interactivo</span>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background:#F16529;"></div>
          <div class="swatch-info">
            <strong>Naranja Marca (nuevo)</strong>
            <code>#F16529</code>
            <span>Acento de marca del logo — CTAs hero, banda de Cards, labels</span>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background:#D9531E;"></div>
          <div class="swatch-info">
            <strong>Naranja Profundo</strong>
            <code>#D9531E</code>
            <span>Hover del naranja de marca</span>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background:#25D366;"></div>
          <div class="swatch-info">
            <strong>WhatsApp</strong>
            <code>#25D366</code>
            <span>Canal directo de conversión</span>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background:#444444;"></div>
          <div class="swatch-info">
            <strong>Secondary</strong>
            <code>#444444</code>
            <span>Texto corporal (WCAG AA)</span>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background:#FAFAFA; border:1px solid #E2E8F0;"></div>
          <div class="swatch-info">
            <strong>Neutral Canvas</strong>
            <code>#FAFAFA</code>
            <span>Fondo general suave</span>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background:#FFFFFF; border:1px solid #E2E8F0;"></div>
          <div class="swatch-info">
            <strong>Surface</strong>
            <code>#FFFFFF</code>
            <span>Tarjetas y formularios</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. PRIMITIVOS — BOTONES -->
    <section id="botones" class="guide-section">
      <div class="section-title-wrap">
        <h2>2. Primitivos — Botones & Acciones (Button.astro)</h2>
        <p>Inspirados en las primitivas de shadcn/ui con soporte de foco accesible, estados activos y slots de iconos.</p>
      </div>

      <div class="component-showcase">
        <div class="showcase-row">
          <span class="showcase-label">Variantes principales:</span>
          <div class="btn-group-wrap">
            <Button variant="primary">
              <span>Consulta sin cargo</span>
              <ArrowRight slot="icon-end" size={16} />
            </Button>

            <Button variant="orange">
              <span>CTA naranja de marca</span>
              <ArrowRight slot="icon-end" size={16} />
            </Button>

            <Button variant="secondary">
              <Code2 slot="icon-start" size={16} />
              <span>Ver especificaciones</span>
            </Button>

            <Button variant="outline">
              <span>Descargar recurso</span>
            </Button>

            <Button variant="whatsapp" href="https://api.whatsapp.com/send?phone=5493415197937" target="_blank">
              <MessageSquare slot="icon-start" size={16} />
              <span>Contactar por WhatsApp</span>
            </Button>

            <Button variant="ghost">
              <span>Cancelar</span>
            </Button>

            <Button variant="link" href="/contacto/">
              <span>Más información →</span>
            </Button>
          </div>
        </div>

        <div class="showcase-row">
          <span class="showcase-label">Escala de tamaños:</span>
          <div class="btn-group-wrap" style="align-items:center;">
            <Button size="sm" variant="secondary">Pequeño (sm)</Button>
            <Button size="md" variant="primary">Predeterminado (md)</Button>
            <Button size="lg" variant="primary">Llamada Hero (lg)</Button>
            <Button size="icon" variant="outline" aria-label="Buscar">
              <Search size={16} />
            </Button>
            <Button size="icon" variant="primary" round aria-label="Ir">
              <IconResolver name="chevron-right" size={20} />
            </Button>
          </div>
        </div>

        <div class="showcase-row">
          <span class="showcase-label">Estados deshabilitados:</span>
          <div class="btn-group-wrap">
            <Button variant="primary" disabled>Enviando datos...</Button>
            <Button variant="outline" disabled>No disponible</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. PRIMITIVOS — BADGES -->
    <section id="badges" class="guide-section">
      <div class="section-title-wrap">
        <h2>3. Primitivos — Etiquetas de Estado (Badge.astro)</h2>
        <p>Micro-etiquetas de estado y categoría que se componen dentro de tarjetas, encabezados y banners.</p>
      </div>

      <div class="component-showcase">
        <div class="showcase-row">
          <span class="showcase-label">Variantes:</span>
          <div class="btn-group-wrap">
            <Badge variant="neutral">Neutra</Badge>
            <Badge variant="accent">Acento</Badge>
            <Badge variant="success">Éxito</Badge>
            <Badge variant="warning">Alerta</Badge>
            <Badge variant="outline">Contorno</Badge>
          </div>
        </div>

        <div class="showcase-row">
          <span class="showcase-label">Escala de tamaños:</span>
          <div class="btn-group-wrap" style="align-items:center;">
            <Badge variant="accent" size="sm">Pequeña (sm)</Badge>
            <Badge variant="accent" size="md">Predeterminada (md)</Badge>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRIMITIVOS — FORMULARIOS -->
    <section id="formularios" class="guide-section">
      <div class="section-title-wrap">
        <h2>4. Primitivos — Controles de Formulario (Input / Textarea)</h2>
        <p>Entradas de texto accesibles con anillos de enfoque contrastados y soporte de mensajes de error.</p>
      </div>

      <div class="form-preview-grid">
        <div class="form-preview-col">
          <Input
            id="guide-demo-name"
            label="Nombre y apellido"
            placeholder="Ej: Marcelo Rossi"
            required={true}
            helperText="Ingresá el nombre de la persona de contacto."
          />

          <Input
            id="guide-demo-email"
            type="email"
            label="Correo corporativo"
            placeholder="marcelo@distribuidorapyme.com.ar"
            required={true}
          />
        </div>

        <div class="form-preview-col">
          <Input
            id="guide-demo-error"
            label="Campo con validación activa"
            value="correo-invalido"
            error="El formato del correo ingresado no es válido."
          />

          <Textarea
            id="guide-demo-msg"
            label="Descripción del proyecto o duda"
            rows={3}
            placeholder="Contanos brevemente qué proceso te gustaría automatizar o mejorar..."
          />
        </div>
      </div>
    </section>

    <!-- 5. PRIMITIVOS — ICONOGRAFÍA -->
    <section id="iconos" class="guide-section">
      <div class="section-title-wrap">
        <h2>5. Primitivos — Iconografía Vectorial (Lucide + IconResolver)</h2>
        <p>Reemplazo estricto de cualquier emoticón por iconos SVG geométricos y profesionales, resueltos desde lucide-astro vía IconResolver.</p>
      </div>

      <div class="icons-grid">
        <div class="icon-sample">
          <ShieldCheck size={24} color="#0A7CFF" />
          <span>ShieldCheck (Confianza)</span>
        </div>
        <div class="icon-sample">
          <CheckCircle2 size={24} color="#059669" />
          <span>CheckCircle2 (Éxito)</span>
        </div>
        <div class="icon-sample">
          <AlertCircle size={24} color="#DC2626" />
          <span>AlertCircle (Problema)</span>
        </div>
        <div class="icon-sample">
          <TrendingUp size={24} color="#065F46" />
          <span>TrendingUp (Métricas)</span>
        </div>
        <div class="icon-sample">
          <Wrench size={24} color="#1A1A2E" />
          <span>Wrench (Solución justa)</span>
        </div>
        <div class="icon-sample">
          <MapPin size={24} color="#64748B" />
          <span>MapPin (Ubicación Rosario)</span>
        </div>
        <div class="icon-sample">
          <Lock size={24} color="#475569" />
          <span>Lock (Seguridad)</span>
        </div>
        <div class="icon-sample">
          <BarChart3 size={24} color="#0A7CFF" />
          <span>BarChart3 (Reportes)</span>
        </div>
        <div class="icon-sample">
          <Package size={24} color="#0A7CFF" />
          <span>Package (Stock/Logística)</span>
        </div>
        <div class="icon-sample">
          <Layers size={24} color="#1A1A2E" />
          <span>Layers (Arquitectura)</span>
        </div>
      </div>
    </section>

    <!-- 5b. PRIMITIVOS — LOGOTIPO DE MARCA -->
    <section id="logotipo" class="guide-section">
      <div class="section-title-wrap">
        <h2>5b. Primitivos — Logotipo de Marca (Logo.astro)</h2>
        <p>
          Cinco variaciones del logotipo SACsi, cada una sobre <strong>fondo claro</strong> y <strong>fondo oscuro</strong>. El prop <code>variant</code> define la variación y <code>theme</code> (light/dark) adapta el color del tagline al fondo sobre el que se apoya.
        </p>
      </div>

      <div class="logo-showcase">
        <div class="logo-showcase__col logo-showcase__col--light">
          <h3 class="logo-showcase__col-title">Sobre fondo claro</h3>

          {logoVariants.map((v) => (
            <div class="logo-demo" data-variant={v.id}>
              <div class="logo-demo__stage">
                {v.id === 'sacsi-blanco' ? (
                  <span class="logo-demo__plate">
                    <Logo variant={v.id} theme="dark" size="lg" />
                  </span>
                ) : (
                  <Logo variant={v.id} theme="light" size="lg" />
                )}
              </div>
              <span class="logo-demo__label">{v.label}</span>
              <span class="logo-demo__desc">{v.desc}</span>
            </div>
          ))}
        </div>

        <div class="logo-showcase__col logo-showcase__col--dark">
          <h3 class="logo-showcase__col-title">Sobre fondo oscuro</h3>

          {logoVariants.map((v) => (
            <div class="logo-demo" data-variant={v.id}>
              <div class="logo-demo__stage">
                <Logo variant={v.id} theme="dark" size="lg" />
              </div>
              <span class="logo-demo__label">{v.label}</span>
              <span class="logo-demo__desc">{v.desc}</span>
            </div>
          ))}
        </div>
      </div>

      <p class="pattern-note">
        <strong>Regla del patrón:</strong> usar el primitivo <code>Logo.astro</code> en <code>src/components/ui/</code> en lugar de repetir markup de marca. La variante blanca requiere fondo oscuro (en el panel claro se previsualiza sobre una placa navy). El bloque <code>sacsi-color</code> replica el logo real: <code>#00A1F1</code> detrás de "SAC" y <code>#F16529</code> detrás de "si". Todas las variaciones exponen un nombre accesible ("SACsi" / "Logo SACsi").
      </p>
    </section>

    <!-- 6. COMPOSICIONES — TARJETAS -->
    <section id="tarjetas" class="guide-section">
      <div class="section-title-wrap">
        <h2>6. Composiciones — Tarjetas & Contenedores (Card.astro)</h2>
        <p>Estructuras limpias con bordes sutiles y elevación única en interacción.</p>
      </div>

      <div class="cards-preview-grid">
        <Card variant="default">
          <div class="card-demo-header">
            <Badge variant="neutral">ESTÁTICA</Badge>
            <h3>Tarjeta Estándar</h3>
          </div>
          <p>Superficie blanca con borde de 1px en color pizarra neutro. Ideal para agrupaciones de contenido informativo o secciones de apoyo.</p>
          <div class="card-demo-footer">
            <span class="text-xs text-muted">Contenedor pasivo</span>
          </div>
        </Card>

        <Card variant="interactive" href="#tarjetas">
          <div class="card-demo-header">
            <Badge variant="accent">INTERACTIVA</Badge>
            <h3>Tarjeta Cliqueable</h3>
          </div>
          <p>Reacciona al hover con una suave elevación de 3px y profundización de sombra. Incluye accesibilidad nativa para teclado.</p>
          <div class="card-demo-footer">
            <span class="text-xs text-blue">Hacé clic para probar hover →</span>
          </div>
        </Card>

        <Card variant="accent">
          <div class="card-demo-header">
            <Badge variant="success">DESTACADA</Badge>
            <h3>Propuesta Justa</h3>
          </div>
          <p>Borde y resplandor sutil en azul institucional. Se utiliza en el lead magnet o en las ofertas principales de valor.</p>
          <div class="card-demo-footer">
            <Button size="sm" variant="primary">Acción directa</Button>
          </div>
        </Card>

        <Card variant="media-accent">
          <div class="ui-card__media">
            <img src="/assets/sacsi-servicios-12-consultoria-ia.webp" alt="Ilustración del servicio IA Aplicada" loading="lazy" />
          </div>
          <div class="ui-card__body">
            <div class="card-demo-header">
              <Badge variant="neutral">HOME</Badge>
              <h3>Servicio con Banda Azul Accent</h3>
            </div>
            <p>Patrón de los cards de la home: banda superior azul accent #0A7CFF con la imagen del servicio centrada y bordes redondeados; cuerpo blanco con título navy y claim gris. La variante es autónoma: fuerza su propio layout (banda flush a los bordes) sin depender del padding que pase el consumidor. CTA circular alineado al borde derecho.</p>
            <div class="card-demo-footer card-demo-footer--end">
              <Button size="icon" variant="primary" round href="#tarjetas" aria-label="Ver servicio">
                <IconResolver name="chevron-right" size={20} />
              </Button>
            </div>
          </div>
        </Card>

        <Card variant="top-accent">
          <span class="ui-card__icon">
            <IconResolver name="ShieldCheck" size={30} />
          </span>
          <div class="card-demo-header">
            <Badge variant="accent">POR QUÉ SACSI</Badge>
            <h3>Pilar con Acento Superior</h3>
          </div>
          <p>Card blanco centrado con línea azul de 4px en el borde superior e icono circular celeste. Es el patrón de los 4 pilares de la sección "Por qué SACsi" de la home (experiencia, trato, IA, ROI).</p>
          <div class="card-demo-footer">
            <span class="text-xs text-muted">Consumidor: PorQueSacsiConFoto</span>
          </div>
        </Card>

        <Card variant="case-flow" padding="none">
          <h3 class="ui-card__title">
            <BrandIcon class="ui-card__title-icon" alt="" />
            <span>Comercio minorista: pedidos por WhatsApp</span>
          </h3>

          <div class="ui-flow">
            <div class="ui-flow__step ui-flow__step--problema">
              <div class="ui-flow__header">
                <span class="ui-flow__indicator ui-flow__indicator--danger">
                  <IconResolver name="AlertCircle" size={14} />
                </span>
                <h4 class="ui-flow__title">Problema</h4>
              </div>
              <p class="ui-flow__desc">Cada pedido entraba por WhatsApp a mano y terminaba copiado en una planilla, con errores de stock y facturación demorada.</p>
            </div>

            <div class="ui-flow__step ui-flow__step--solucion">
              <div class="ui-flow__header">
                <span class="ui-flow__indicator ui-flow__indicator--primary">
                  <IconResolver name="CheckCircle2" size={14} />
                </span>
                <h4 class="ui-flow__title">Solución justa</h4>
              </div>
              <p class="ui-flow__desc">Automatización sobre lo que ya usaban: el pedido de WhatsApp se carga en el sistema y dispara stock y factura sin retipear.</p>
            </div>

            <div class="ui-flow__step ui-flow__step--resultado">
              <div class="ui-flow__header">
                <span class="ui-flow__indicator ui-flow__indicator--success">
                  <IconResolver name="TrendingUp" size={14} />
                </span>
                <h4 class="ui-flow__title">Resultado medible</h4>
              </div>
