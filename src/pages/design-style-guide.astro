<script>
  // Demo interactiva de SliderControls (Organismos — Carrusel Interactivo):
  // conecta prev/next/dots con el mini-carrusel #guide-slider-demo.
  // Patrón de integración vanilla reutilizable: el componente expone
  // data-slider-prev/next/dots + targetId.
  (function () {
    var viewport = document.getElementById('guide-slider-demo');
    var controls = document.querySelector('[data-ui-slider-controls][data-target="guide-slider-demo"]');
    if (!viewport || !controls) return;

    var slides = Array.prototype.slice.call(viewport.querySelectorAll('.slider-demo__slide'));
    var dots = Array.prototype.slice.call(controls.querySelectorAll('.ui-slider-dot'));
    var current = 0;

    function render() {
      slides.forEach(function (s, i) {
        s.classList.toggle('is-active', i === current);
      });
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === current);
        d.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
    }

    function go(index) {
      current = (index + slides.length) % slides.length;
      render();
    }

    controls.querySelector('[data-slider-prev]').addEventListener('click', function () { go(current - 1); });
    controls.querySelector('[data-slider-next]').addEventListener('click', function () { go(current + 1); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { go(parseInt(d.getAttribute('data-slide-index'), 10)); });
    });

    render();
  })();
</script>
