---
// Ruta: /catalogo/ — Catálogo global de soluciones contratables (US-01)
// Datos normalizados desde src/lib/data-utils.ts (sin hardcodear IDs).
// Render inicial SSG con solo servicios/categorías que tienen soluciones (CA-02);
// los filtros interactivos (cambio/input) se resuelven client-side en CAT-02.
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Input from '../components/ui/Input.astro';
import {
  getSoluciones,
  getSolucionDetalle,
  getCategoriasConSoluciones,
  getServiciosConSoluciones,
} from '../lib/data-utils';

const servicios = getServiciosConSoluciones();
const categorias = getCategoriasConSoluciones();
const soluciones = getSoluciones();

// Formateo de precios (ARS k) para las tarjetas
function formatearPrecio(min: number, max: number): string {
  if (min === max) return `$${min}k ARS`;
  return `$${min}k - $${max}k ARS`;
}

// Categorías y servicios de cada solución, desde el detalle solucion_<id>.json
// (fuente de verdad de la pertenencia solución→categoría)
const categoriasDeSolucion = new Map<string, string[]>();
const serviciosDeSolucion = new Map<string, string[]>();
for (const s of soluciones) {
  const catIds = getSolucionDetalle(s.id)?.categorias ?? [];
  const cats = categorias.filter((c) => catIds.includes(c.id));
  categoriasDeSolucion.set(s.id, cats.map((c) => c.id));
  const serviciosIds: string[] = [];
  for (const c of cats) {
    if (!serviciosIds.includes(c.servicio_id)) serviciosIds.push(c.servicio_id);
  }
  serviciosDeSolucion.set(s.id, serviciosIds);
}

const breadcrumb = [
  { label: 'Inicio', href: '/' },
  { label: 'Catálogo', href: Astro.url.pathname },
];
---

<Layout
  title="Catálogo de soluciones"
  description="Explorá todas las soluciones contratables de SACsi en un solo lugar: filtrá por servicio, categoría o buscá por nombre la solución que necesitás."
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumb.map((b) => (
        <li>
          {b.href === Astro.url.pathname ? (
            <span aria-current="page">{b.label}</span>
          ) : (
            <a href={b.href}>{b.label}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <!-- Hero -->
  <section class="hero hero--detail">
    <div class="hero__container">
      <p class="hero__label">CATÁLOGO</p>
      <h1 class="hero__title">Catálogo de soluciones</h1>
      <p class="hero__subtitle">
        Todas las soluciones que podés contratar en SACsi. Filtralas por servicio,
        categoría o buscá por nombre la que necesitás.
      </p>
    </div>
  </section>

  <!-- Filtros: markup data-driven (CA-02). La interactividad se agrega en CAT-02 -->
  <section class="section section--filtros">
    <div class="container">
      <div class="catalogo-filtros">
        <div class="catalogo-filtros__campo">
          <label for="filtro-servicio">Servicio</label>
          <select id="filtro-servicio" name="servicio">
            <option value="">Todos los servicios</option>
            {servicios.map((s) => (
              <option value={s.id}>{s.title}</option>
            ))}
          </select>
        </div>
        <div class="catalogo-filtros__campo">
          <label for="filtro-categoria">Categoría</label>
          <select id="filtro-categoria" name="categoria">
            <option value="">Todas las categorías</option>
            {servicios.map((s) => (
              <optgroup label={s.title} data-servicio={s.id}>
                {categorias
                  .filter((c) => c.servicio_id === s.id)
                  .map((c) => (
                    <option value={c.id} data-servicio={s.id}>
                      {c.icon} {c.title}
                    </option>
                  ))}
              </optgroup>
            ))}
          </select>
        </div>
        <div class="catalogo-filtros__campo">
          <label for="filtro-texto">Buscar</label>
          <Input
            id="filtro-texto"
            type="search"
            name="q"
            placeholder="Ingresá palabras clave de la solución"
          />
        </div>
        <Button
          id="filtro-reset"
          variant="outline"
          type="button"
          class="catalogo-filtros__reset"
        >
          Limpiar filtros
        </Button>
      </div>
    </div>
  </section>

  <!-- Grilla de soluciones — tarjetas con el primitivo Card
       variante media-accent (banda naranja donweb) -->
  <section class="section">
    <div class="container">
      <p class="catalogo-contador" id="catalogo-contador" aria-live="polite">
        {soluciones.length} solucion{soluciones.length === 1 ? '' : 'es'} disponible{soluciones.length === 1 ? '' : 's'}
      </p>
      <div class="cards-grid" id="catalogo-grilla">
        {soluciones.map((s) => {
          const cats = categoriasDeSolucion.get(s.id) ?? [];
          const serviciosIds = serviciosDeSolucion.get(s.id) ?? [];
          return (
            <Card
              as="article"
              variant="media-accent"
              padding="none"
              class="service-card"
              data-solucion-id={s.id}
              data-servicio={serviciosIds.join(' ')}
              data-categoria={cats.join(' ')}
              data-nombre={s.nombre}
            >
              <div class="ui-card__media">
                <img
                  src={s.imagen ? s.imagen : `/assets/sacsi-transversales-02-patron-institucional.webp`}
                  srcset={s.imagen ? `${s.imagen} 1x` : `/assets/sacsi-transversales-02-patron-institucional.webp 1x`}
                  sizes="(max-width: 375px) 90vw, (max-width: 1440px) 60vw, 80vw"
                  width="375"
                  height="250"
                  alt={`Ilustración representativa de ${s.nombre}`}
                  loading="lazy"
                />
              </div>
              <div class="ui-card__body">
                <h3>
                  <a href={`/soluciones/${s.id}/`}>{s.nombre}</a>
                </h3>
                <p class="service-card__claim">
                  {s.descripcion_publica}
                </p>
                <p class="service-card__price">
                  Desde {formatearPrecio(s.precioMin, s.precioMax)}
                </p>
              <Button
                variant="whatsapp"
                size="sm"
                href={`/soluciones/${s.id}/`}
                class="service-card__cta"
              >
                Ver +
              </Button>
              </div>
            </Card>
          );
        })}
      </div>
      <Card
        variant="muted"
        padding="lg"
        class="catalogo-vacio"
        id="catalogo-vacio"
        hidden={true}
      >
        <p>No encontramos soluciones con esos filtros.</p>
        <p>
          ¿Querés ver qué podemos hacer por tu negocio? Contanos tu caso y te
          armamos una propuesta a medida.
        </p>
        <Button variant="primary" href="/contacto/" class="hero__cta">
          Consultar sin cargo
        </Button>
      </Card>

      <!-- C3: puerta de entrada al servicio IA — diagnóstico con entregable -->
      <Card variant="accent" padding="lg" class="catalogo-diagnostico">
        <p>¿No sabés por dónde empezar?</p>
        <p class="catalogo-diagnostico__desc">
          En una sesión de trabajo detectamos dónde tu negocio pierde horas y
          qué conviene automatizar primero. Recibís un diagnóstico en PDF con
          roadmap y ROI estimado.
        </p>
        <Button
          variant="primary"
          href="/soluciones/diagnostico-ia/"
          class="hero__cta"
        >
          Empezá con un Diagnóstico IA express
        </Button>
      </Card>
    </div>
  </section>
</Layout>

<script>
  const filtroServicio = document.getElementById('filtro-servicio') as HTMLSelectElement;
  const filtroCategoria = document.getElementById('filtro-categoria') as HTMLSelectElement;
  const filtroTexto = document.getElementById('filtro-texto') as HTMLInputElement;
  const botonReset = document.getElementById('filtro-reset') as HTMLButtonElement;
  const grilla = document.getElementById('catalogo-grilla') as HTMLElement;
  const contador = document.getElementById('catalogo-contador') as HTMLElement;
  const vacio = document.getElementById('catalogo-vacio') as HTMLElement;

  const tarjetas = Array.from(grilla.querySelectorAll('.service-card'));

  function normalizar(texto: string): string {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function aplicarJerarquia(): void {
    const servicio = filtroServicio.value;
    filtroCategoria.querySelectorAll('optgroup').forEach((grupo) => {
      const coincide = servicio === '' || grupo.dataset.servicio === servicio;
      grupo.hidden = !coincide;
      grupo.querySelectorAll('option').forEach((op) => {
        op.hidden = !coincide;
      });
    });
    const valor = filtroCategoria.value;
    if (valor) {
      const op = filtroCategoria.querySelector(
        `option[value="${valor}"]`,
      ) as HTMLOptionElement | null;
      if (op && op.hidden) filtroCategoria.value = '';
    }
  }

  function aplicarFiltros(): void {
    const servicio = filtroServicio.value;
    const categoria = filtroCategoria.value;
    const texto = normalizar(filtroTexto.value.trim());

    let visibles = 0;
    tarjetas.forEach((tarjeta) => {
      const servicios = (tarjeta.dataset.servicio || '').split(' ');
      const categorias = (tarjeta.dataset.categoria || '').split(' ');
      const cumpleServicio = servicio === '' || servicios.includes(servicio);
      const cumpleCategoria = categoria === '' || categorias.includes(categoria);
      const cumpleTexto =
        texto === '' || normalizar(tarjeta.dataset.nombre || '').includes(texto);
      const visible = cumpleServicio && cumpleCategoria && cumpleTexto;
      tarjeta.hidden = !visible;
      if (visible) visibles++;
    });

    contador.textContent = `${visibles} solucion${visibles === 1 ? '' : 'es'} disponible${visibles === 1 ? '' : 's'}`;
    vacio.hidden = visibles > 0;
  }

  function escribirEstado(push: boolean): void {
    const params = new URLSearchParams();
    if (filtroServicio.value) params.set('servicio', filtroServicio.value);
    if (filtroCategoria.value) params.set('categoria', filtroCategoria.value);
    if (filtroTexto.value.trim()) params.set('q', filtroTexto.value.trim());
    const qs = params.toString();
    const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    if (push) {
      window.history.pushState({}, '', url);
    } else {
      window.history.replaceState({}, '', url);
    }
  }

  function leerEstado(): void {
    const params = new URLSearchParams(window.location.search);
    const servicio = params.get('servicio');
    const categoria = params.get('categoria');
    const q = params.get('q');
    if (servicio) filtroServicio.value = servicio;
    if (categoria) filtroCategoria.value = categoria;
    if (q) filtroTexto.value = q;
  }

  filtroServicio.addEventListener('change', () => {
    aplicarJerarquia();
    aplicarFiltros();
    escribirEstado(true);
  });
  filtroCategoria.addEventListener('change', () => {
    aplicarFiltros();
    escribirEstado(true);
  });
  filtroTexto.addEventListener('input', () => {
    aplicarFiltros();
    escribirEstado(false);
  });
  botonReset.addEventListener('click', () => {
    filtroServicio.value = '';
    filtroCategoria.value = '';
    filtroTexto.value = '';
    aplicarJerarquia();
    aplicarFiltros();
    escribirEstado(true);
  });
  window.addEventListener('popstate', () => {
    leerEstado();
    aplicarJerarquia();
    aplicarFiltros();
  });

  leerEstado();
  aplicarJerarquia();
  aplicarFiltros();
</script>

<style>
  /* Breadcrumb (mismo patrón que las páginas de servicio/categoría) */
  .breadcrumb {
    font-size: 0.9rem;
  }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    list-style: none;
    margin: 0;
    padding: var(--spacing-md) var(--spacing-md) 0;
  }
  .breadcrumb li {
    color: var(--secondary);
  }
  .breadcrumb a {
    color: var(--primary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb [aria-current='page'] {
    color: var(--muted);
  }

  .hero--detail {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  }

  /* Filtros (móvil-first) */
  .section--filtros {
    padding-top: 0;
  }
  .catalogo-filtros {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
    background: var(--surface);
    border: 1px solid #E8E8E8;
    border-radius: var(--rounded-md);
    padding: var(--spacing-lg);
  }
  .catalogo-filtros__campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .catalogo-filtros label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--secondary);
  }
  .catalogo-filtros select {
    padding: 10px 12px;
    border: 1px solid #DDDDDD;
    border-radius: var(--rounded-sm);
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--secondary);
    background: var(--neutral);
  }
  .catalogo-filtros select:focus {
    outline: 2px solid var(--tertiary);
    outline-offset: 1px;
    border-color: var(--tertiary);
  }
  /* Reset: botón renderizado por Button.astro → :global para que el
     ancho 100% mobile y el contorno propio de la página sigan aplicando */
  :global(.catalogo-filtros__reset) {
    padding: 10px 16px;
    border: 1.5px solid #DDDDDD;
    border-radius: var(--rounded-sm);
    background: transparent;
    color: var(--primary);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    width: 100%;
  }
  :global(.catalogo-filtros__reset:hover) {
    border-color: var(--primary);
  }

  /* Contador de resultados */
  .catalogo-contador {
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 var(--spacing-lg);
  }

  /* Tarjetas ocultas por los filtros (renderizadas por Card.astro → :global) */
  :global(.service-card[hidden]) {
    display: none;
  }

  /* Estado sin resultados (contenedor renderizado por Card.astro → :global;
     .ui-card define display:flex, que pisaría el [hidden] del UA → regla explícita) */
  :global(.catalogo-vacio) {
    text-align: center;
    color: var(--secondary);
    padding: var(--spacing-xl) var(--spacing-md);
    background: #F9F9FB;
    border-radius: var(--rounded-md);
  }
  :global(.catalogo-vacio[hidden]) {
    display: none;
  }
  :global(.catalogo-vacio p) {
    margin: 0 0 var(--spacing-sm);
  }
  :global(.catalogo-vacio a) {
    margin-top: var(--spacing-md);
  }

  /* Precio "desde" en tarjetas (C3) */
  .service-card__price {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--tertiary-dark);
    margin: 0 0 var(--spacing-sm);
  }

  /* Tarjetas del catálogo: el contenedor es el primitivo
     <Card variant="media-accent" padding="none">. La banda
     .ui-card__media (fondo #F16529, márgenes horizontales
     -24px del primitivo) queda al ras del borde superior y a
     todo el ancho porque el card tiene overflow:hidden —
     mismo patrón "donweb" de body.header-overlay .service-card
     en global.css.
     La regla global .service-card (padding 28px 24px 32px;
     fondo #F9F9FB) es del layout legacy donde .service-card
     era el card: se neutraliza con mayor especificidad para
     que gane el primitivo (la clase se conserva por el
     contrato E2E .service-card).
     Con padding "none" el primitivo no aporta inset interior,
     así que el cuerpo lo lleva acá; la tipografía vertical
     (h3, claim, cta) sigue siendo la global .service-card. */
  :global(.service-card.ui-card--media-accent) {
    padding: 0;
    background-color: var(--surface, #FFFFFF);
  }
  :global(.service-card.ui-card--media-accent h3),
  :global(.service-card.ui-card--media-accent .service-card__claim),
  :global(.service-card.ui-card--media-accent .service-card__price) {
    padding-left: var(--spacing-md, 16px);
    padding-right: var(--spacing-md, 16px);
  }
  :global(.service-card.ui-card--media-accent .service-card__cta) {
    margin: 0 var(--spacing-md, 16px) var(--spacing-md, 16px);
  }

  /* CTA diagnóstico (C3) — banner renderizado por Card.astro → :global */
  :global(.catalogo-diagnostico) {
    text-align: center;
    margin-top: var(--spacing-xl);
    padding: var(--spacing-xl) var(--spacing-md);
    background: #FFFFFF;
    border: 2px solid var(--tertiary);
    border-radius: var(--rounded-md);
    box-shadow: 0 4px 16px rgba(10, 124, 255, 0.08);
  }
  :global(.catalogo-diagnostico p:first-child) {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 var(--spacing-xs);
  }
  .catalogo-diagnostico__desc {
    font-size: 0.95rem;
    color: var(--secondary);
    max-width: 560px;
    margin: 0 auto var(--spacing-lg);
    line-height: 1.5;
  }

  @media (min-width: 601px) {
    .breadcrumb ol {
      padding: var(--spacing-lg) var(--spacing-lg) 0;
    }
    .catalogo-filtros {
      grid-template-columns: repeat(3, 1fr) auto;
      align-items: end;
    }
    :global(.catalogo-filtros__reset) {
      width: auto;
    }
  }
</style>

