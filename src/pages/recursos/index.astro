---
// Página: Hub de Recursos Gratuitos para PyMEs
import Layout from '../../layouts/Layout.astro';
import { CheckSquare, Globe, Bot, ArrowRight, ShieldCheck } from 'lucide-astro';

const recursos = [
  {
    title: 'Checklist de Automatización de Procesos',
    slug: '/checklist-automatizacion/',
    tag: 'DIAGNÓSTICO EN 5 MIN',
    badge: 'Checklist interactivo & PDF',
    description: 'Detectá tareas manuales, cuellos de botella en facturación y planillas desincronizadas para saber con exactitud si tu PyME necesita automatizar.',
    icon: CheckSquare,
    accent: '#0A7CFF'
  },
  {
    title: 'Cómo construir tu Identidad Digital',
    slug: '/recursos/identidad-digital/',
    tag: 'GUÍA PRÁCTICA',
    badge: 'Lectura de 7 min',
    description: 'Dejá de depender únicamente de redes sociales. Construí activos propios: dominio, correos corporativos, Google Maps y WhatsApp Business optimizado.',
    icon: Globe,
    accent: '#059669'
  },
  {
    title: 'Cómo implementar Inteligencia Artificial en tu negocio',
    slug: '/recursos/inteligencia-artificial/',
    tag: 'GUÍA ESTRATÉGICA',
    badge: 'Lectura de 8 min',
    description: 'Una mirada realista y sin modas sobre la IA para PyMEs: casos de uso rentables, protección de datos y qué errores caros debés evitar.',
    icon: Bot,
    accent: '#4F46E5'
  }
];
---

<Layout
  title="Recursos Gratuitos para PyMEs · Guías y Checklists | SACsi"
  description="Accedé gratis a checklists y guías prácticas de tecnología justa para PyMEs y emprendedores: automatización, identidad digital e inteligencia artificial sin sobrecostos."
>
  <section class="hero">
    <div class="hero__container">
      <p class="hero__label">HERRAMIENTAS Y GUÍAS PRÁCTICAS</p>
      <h1 class="hero__title">Recursos gratuitos de tecnología justa para tu negocio</h1>
      <p class="hero__subtitle">
        Material directo, práctico y sin tecnicismos para que evalúes tus procesos, fortalezcas tu presencia y aproveches la tecnología adecuada sin pagar de más.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="resources-grid">
        {recursos.map((rec) => {
          const IconComp = rec.icon;
          return (
            <article class="resource-card">
              <div class="resource-card__header">
                <span class="resource-card__tag">{rec.tag}</span>
                <span class="resource-card__badge">{rec.badge}</span>
              </div>
              
              <div class="resource-card__icon-wrap" style={`color: ${rec.accent}; background-color: ${rec.accent}12;`}>
                <IconComp size={28} aria-hidden="true" />
              </div>

              <h2 class="resource-card__title">
                <a href={rec.slug}>{rec.title}</a>
              </h2>

              <p class="resource-card__desc">{rec.description}</p>

              <div class="resource-card__footer">
                <a class="resource-card__btn" href={rec.slug}>
                  <span>Acceder al recurso gratis</span>
                  <ArrowRight size={16} aria-hidden="true" />
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <div class="resources-promise">
        <div class="promise-badge">
          <ShieldCheck size={18} aria-hidden="true" />
          <span>COMPROMISO SACSI</span>
        </div>
        <h3>Todos nuestros recursos son 100% gratuitos y prácticos</h3>
        <p>
          No te pedimos registrarte con contraseñas complejas ni te llenamos la casilla de correos de spam. Nuestro objetivo es que conozcas cómo pensamos y tomes decisiones informadas.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .resources-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xxl);
  }

  @media (min-width: 768px) {
    .resources-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .resource-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: var(--rounded-md);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .resource-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: var(--tertiary);
  }

  .resource-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
    font-size: 0.75rem;
  }

  .resource-card__tag {
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--tertiary-dark);
    text-transform: uppercase;
  }

  .resource-card__badge {
    background: #F1F5F9;
    color: var(--secondary);
    padding: 3px 8px;
    border-radius: var(--rounded-full);
    font-weight: 600;
  }

  .resource-card__icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--rounded-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-md);
  }

  .resource-card__title {
    font-size: 1.28rem;
    margin: 0 0 var(--spacing-sm);
    line-height: 1.35;
  }

  .resource-card__title a {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .resource-card__title a:hover {
    color: var(--tertiary);
  }

  .resource-card__desc {
    font-size: 0.94rem;
    color: var(--secondary);
    line-height: 1.55;
    margin: 0 0 var(--spacing-lg);
    flex-grow: 1;
  }

  .resource-card__footer {
    padding-top: var(--spacing-md);
    border-top: 1px solid #F1F5F9;
  }

  .resource-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--tertiary);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .resource-card__btn:hover {
    gap: 12px;
    color: var(--primary);
  }

  .resources-promise {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: var(--rounded-md);
    padding: var(--spacing-xl);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .promise-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ECFDF5;
    color: #047857;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--rounded-full);
    margin-bottom: var(--spacing-sm);
  }

  .resources-promise h3 {
    font-size: 1.3rem;
    color: var(--primary);
    margin: 0 0 var(--spacing-xs);
  }

  .resources-promise p {
    font-size: 0.96rem;
    color: var(--secondary);
    margin: 0;
    line-height: 1.6;
  }
</style>
