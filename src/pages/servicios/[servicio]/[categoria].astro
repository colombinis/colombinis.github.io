---
// Route dinámico: detalle de subnivel de solución
// URL: /servicios/<servicio>/<categoria>/
// Data source: src/data/servicios/servicio_*.json + src/data/categorias/categoria_*.json (normalizados)
// Analogia Laravel: Route::get('/servicios/{servicio}/{categoria}', ...) → Service::find($id)->categoria($cat)
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import { getServicio, getCategoriaByServicio, getServicios, getCategoriasByServicio, getSolucionesByCategoria } from '../../../lib/data-utils';

interface Props {
  params: { servicio: string; categoria: string };
}

// Genera 9 rutas estáticas (3 servicios × 3 categorías)
export async function getStaticPaths() {
  const paths: { params: { servicio: string; categoria: string } }[] = [];
  for (const svc of getServicios()) {
    for (const cat of getCategoriasByServicio(svc.id)) {
      paths.push({
        params: { servicio: svc.id, categoria: cat.id },
      });
    }
  }
  return paths;
}

const servicio = getServicio(Astro.params.servicio);
const categoria = getCategoriaByServicio(Astro.params.servicio!, Astro.params.categoria!);

if (!servicio || !categoria) {
  throw new Error(
    `No se encontró servicio=${Astro.params.servicio} categoría=${Astro.params.categoria}`
  );
}

const { title: svcTitle, href: svcHref } = servicio;
const { title: catTitle, descripcion, claim, beneficios, casos } = categoria;

// Soluciones asociadas a esta categoría (según el campo categorias de cada detalle solucion_<id>.json)
const solucionesCategoria = getSolucionesByCategoria(categoria.id);

// Formateo de precios (ARS k) para las tarjetas
function formatearPrecio(min: number, max: number) {
  if (min === max) return `$${min}k ARS`;
  return `$${min}k - $${max}k ARS`;
}

// Breadcrumb
const breadcrumb = [
  { label: 'Inicio', href: '/' },
  { label: svcTitle, href: svcHref },
  { label: catTitle, href: Astro.url.pathname },
];
---

<Layout
  title={`${catTitle} | ${svcTitle} | SACsi`}
  description={descripcion}
>
  <!-- Breadcrumb (arriba del hero) -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumb.map((b) => (
        <li>
          {b.href ? <a href={b.href}>{b.label}</a> : <span>{b.label}</span>}
        </li>
      ))}
    </ol>
  </nav>

  <!-- Hero -->
  <section class="hero hero--detail">
    <div class="hero__container">
      <h1 class="hero__title">{catTitle}</h1>
      <p class="hero__subtitle">{descripcion}</p>
      <p class="hero__claim">{claim}</p>
      <div class="hero__actions">
        <Button
          variant="primary"
          size="lg"
          class="categoria-hero__cta"
          href={`/contacto/?categoria=${categoria.id}&asunto=Consulta%20sobre%20${categoria.title}`}
        >
          Consultar sin cargo
        </Button>
      </div>
    </div>
  </section>

  <!-- Beneficios con links a casos -->
  <section class="section">
    <div class="container">
      <h2 class="section__title">Beneficios concretos</h2>
      <div class="cards-grid">
        {beneficios.map((beneficio) => (
          <Card variant="muted" padding="md" as="article" class="categoria-card">
            <p class="categoria-card__texto">{beneficio.texto}</p>
            {beneficio.caso ? (
              <Button
                variant="outline"
                size="sm"
                href={`/casos-exito/${beneficio.caso}/`}
              >
                Ver caso de exito
              </Button>
            ) : (
              <Button variant="outline" size="sm" disabled>Sin caso asociado</Button>
            )}
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- En qué nos especializamos (soluciones con esta categoría) -->
  {solucionesCategoria.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section__title">Soluciones relacionadas</h2>
        <div class="cards-grid">
          {solucionesCategoria.map((solucion) => (
            <Card variant="muted" padding="md" as="article" class="categoria-card">
              <h3>
                <a href={`/soluciones/${solucion.id}/`}>{solucion.nombre}</a>
              </h3>
              <p class="service-card__claim">
                Desde {solucion.precioMin}
              </p>
              <Button
                variant="outline"
                size="sm"
                href={`/soluciones/${solucion.id}/`}
              >
                Ver detalle
              </Button>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  /* Inline styles consistent with global.css vars */
  .hero--detail {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  }
  .hero__claim {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--tertiary);
    margin: var(--spacing-sm) 0 var(--spacing-lg);
  }
  .breadcrumb {
    font-size: 0.9rem;
  }
  .breadcrumb ol {
    display: flex;
    gap: var(--spacing-sm);
    list-style: none;
  }
  .breadcrumb li {
    color: var(--secondary);
  }
  .breadcrumb a {
    color: var(--primary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }

  /* Hero: CTA (Button) — paridad con .hero__cta de global.css
     (CTA full-width en móvil) */
  .categoria-hero__cta {
    width: 100%;
  }
  @media (min-width: 601px) {
    .categoria-hero__cta {
      width: auto;
    }
  }

  /* Cards de categoría: tipografía con paridad a .service-card (global.css),
     ya que el primitivo Card no incluye estilos de texto interno */
  .categoria-card__texto {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 0 var(--spacing-md);
  }
  .categoria-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--primary);
    margin: 0 0 var(--spacing-sm);
  }
  .categoria-card h3 a {
    color: inherit;
    text-decoration: none;
  }
</style>
