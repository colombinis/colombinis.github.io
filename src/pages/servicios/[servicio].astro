---
// Route dinámico: detalle de servicio
// URL: /servicios/<servicio>/
// Data source: src/data/servicios/servicio_*.json + src/data/categorias/categoria_*.json (normalizados)
// Reemplaza a: servicios/automatizacion.astro, servicios/software-a-medida.astro, servicios/presencia-online.astro
// Analogia Laravel: Route::get('/servicios/{servicio}', ...) → ServicioController@show
import Layout from '../../layouts/Layout.astro';
import SolucionesSection from '../../components/SolucionesSection.astro';
import CasosAnonimosSection from '../../components/CasosAnonimosSection.astro';
import { getServicio, getCategoriasByServicio, getTestimoniosByServicio } from '../../lib/data-utils';
import Button from '../../components/ui/Button.astro';
import IconResolver from '../../components/ui/IconResolver.astro';
import Card from '../../components/ui/Card.astro';
import HeroRow from '../../components/HeroRow.astro';

interface Props {
  params: { servicio: string };
}

// Genera 3 rutas estáticas (una por servicio)
export async function getStaticPaths() {
  const { getServicios } = await import('../../lib/data-utils.ts');
  return getServicios().map((svc) => ({
    params: { servicio: svc.id },
  }));
}

const servicio = getServicio(Astro.params.servicio);

if (!servicio) {
  throw new Error(`No se encontró servicio=${Astro.params.servicio}`);
}

const {
  title: svcTitle,
  href: svcHref,
  claim: svcClaim,
  short: svcShort,
  value_prop: svcValueProp,
  categoria_section_title,
} = servicio;

const defaultPropMap: Record<string, string> = {
  'automatizacion': 'Sin gastar de más. Solo lo que realmente genera valor.',
  'presencia-online': 'Sitios y tiendas que funcionan sin complicaciones ni costos ocultos.',
  'software-a-medida': 'Sistemas hechos a la medida de tu realidad, no de las modas.',
};

const serviceValueProp = svcValueProp || defaultPropMap[servicio.id] || 'Tecnología justa adaptada a las necesidades de tu PyME.';

const categorias = getCategoriasByServicio(servicio.id);
const testimoniosData = getTestimoniosByServicio(servicio.id);

// Slides del slider de la fila Hero+Slider (§10b): el contenido de las
// cards de categoría, mismo destino que los links de la grilla de abajo.
const categoriaSlides = categorias.map((cat) => ({
  id: cat.id,
  title: cat.title,
  claim: cat.claim,
  imagen: cat.imagen ?? cat.icon,
  href: `${svcHref}${cat.id}/`,
}));
---

<Layout
  title={servicio.seo_title || `${svcTitle} para PyMEs`}
  description={servicio.seo_description || svcShort}
>
  <!-- Hero: fila Hero + Slider (§10b) — izquierda = contenido del hero del
       servicio, derecha = slides armados desde las cards de categoría. -->
  <HeroRow
    headingTag="h1"
    hero={{
      titleAccent: '',
      title: svcTitle,
      valueLine: serviceValueProp,
      subtitle: svcShort,
      ctaLabel: 'Consultar sin cargo',
      ctaHref: `/contacto/?categoria=${servicio.id}&asunto=Consulta%20sobre%20${servicio.title}`,
    }}
    slides={categoriaSlides}
    sliderLabel={`Categorías de ${svcTitle}`}
  />

  <!-- Categorías con cards -->
  <section class="section">
    <div class="container">
      <h2 class="section__title">{categoria_section_title}</h2>
      <div class="cards-grid">
        {categorias.map((cat) => (
          <Card as="article" variant="media-accent" padding="none" class="service-card">
            <div class="ui-card__media">
              <img src={cat.imagen ?? cat.icon} alt={cat.title} loading="lazy" />
            </div>
            <div class="ui-card__body service-card__body">
              <h3 class="service-card__title">
                <a href={`${svcHref}${cat.id}/`}>{cat.title}</a>
              </h3>
              <p class="service-card__desc">{cat.descripcion}</p>
              <p class="service-card__claim">{cat.claim}</p>
              <Button
                variant="primary"
                size="icon"
                round
                href={`${svcHref}${cat.id}/`}
                aria-label={`Ver categoría ${cat.title}`}
              >
                <IconResolver name="chevron-right" size={20} />
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Casos anónimos de éxito del servicio (Problema → Solución justa → Resultado medible) -->
  <CasosAnonimosSection
    servicioId={servicio.id}
    title={`Casos reales de ${svcTitle}`}
  />

  <!-- Testimonios / Social proof -->
  {testimoniosData && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="section__title">{testimoniosData.section_title}</h2>
        <div class="testimonials-grid">
          {testimoniosData.testimonios.slice(0, 3).map((t) => (
            <Card variant="muted" padding="md">
              <p class="testimonial-card__quote">
                "{t.quote}"
              </p>
              <p class="testimonial-card__author">{t.autor}</p>
              {t.rol && <p class="testimonial-card__role">{t.rol}</p>}
              {t.ubicacion && <p class="testimonial-card__role">{t.ubicacion}</p>}
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  /* Card de categoría = primitivo Card variant="media-accent" con
     padding="none": la banda .ui-card__media (fondo accent #0A7CFF)
     llega borde a borde porque la variante fuerza padding 0 (el
     primitivo la recorta con overflow:hidden). El wrapper
     .service-card__body recupera el padding del cuerpo que p-none deja
     en 0, con paridad al patrón de banda de global.css (0 24px 32px).
     La tipografía del card (h3 / p / .service-card__claim) la aporta
     global.css vía la clase .service-card conservada en la raíz. */
  .service-card__body {
    padding: 0 var(--spacing-lg) var(--spacing-xl);
    /* Patrón maestro (guía): CTA circular alineado al borde derecho. */
    display: flex;
    flex-direction: column;
  }
  .service-card__body :global(.ui-btn--round) {
    align-self: flex-end;
  }
</style>
