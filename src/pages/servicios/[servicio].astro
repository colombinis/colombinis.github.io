---
// Route dinámico: detalle de servicio
// URL: /servicios/<servicio>/
// Data source: src/data/servicios/servicio_*.json + src/data/categorias/categoria_*.json (normalizados)
// Reemplaza a: servicios/automatizacion.astro, servicios/software-a-medida.astro, servicios/presencia-online.astro
// Analogia Laravel: Route::get('/servicios/{servicio}', ...) → ServicioController@show
import Layout from '../../layouts/Layout.astro';
import SolucionesSection from '../../components/SolucionesSection.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CasosAnonimosSection from '../../components/CasosAnonimosSection.astro';
import { getServicio, getCategoriasByServicio, getTestimoniosByServicio } from '../../lib/data-utils';
import { Check } from 'lucide-astro';

interface Props {
  params: { servicio: string };
}

// Genera 3 rutas estáticas (una por servicio)
export async function getStaticPaths() {
  const { getServicios } = await import('../../lib/data-utils.ts');
  return getServicios().map((svc) => ({
    params: { servicio: svc.id },
  }));
}

const servicio = getServicio(Astro.params.servicio);

if (!servicio) {
  throw new Error(`No se encontró servicio=${Astro.params.servicio}`);
}

const {
  title: svcTitle,
  href: svcHref,
  claim: svcClaim,
  short: svcShort,
  hero_label,
  categoria_section_title,
} = servicio;

const categorias = getCategoriasByServicio(servicio.id);
const testimoniosData = getTestimoniosByServicio(servicio.id);
---

<Layout
  title={servicio.seo_title || `${svcTitle} para PyMEs en Rosario`}
  description={servicio.seo_description || svcShort}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__container">
      <p class="hero__label">{hero_label}</p>
      <h1 class="hero__title">{svcTitle}</h1>
      <p class="hero__subtitle">
        {svcShort}
      </p>
      <div class="service-value-pills">
        <span class="value-pill"><Check size={14} aria-hidden="true" style="display:inline;vertical-align:-1px;margin-right:4px;" />Elegimos la tecnología adecuada, no la de moda</span>
        <span class="value-pill"><Check size={14} aria-hidden="true" style="display:inline;vertical-align:-1px;margin-right:4px;" />Entendemos lo que cuesta cada peso</span>
      </div>
      <div class="hero__actions">
        <a
          class="hero__cta hero__cta--form"
          href={`/contacto/?categoria=${servicio.id}&asunto=Consulta%20sobre%20${servicio.title}`}
          >Consultar sin cargo</a>
      </div>
    </div>
  </section>

  <!-- Categorías con cards -->
  <section class="section">
    <div class="container">
      <h2 class="section__title">{categoria_section_title}</h2>
      <div class="cards-grid">
        {categorias.map((cat) => (
          <article class="service-card">
            <div class="service-card__icon">{cat.icon ? <img src={cat.imagen ?? cat.icon} alt={cat.title} loading="lazy" /> : ''}</div>
            <h3><a href={cat.id.startsWith(servicio.id + '/') ? `${svcHref}${cat.id}/` : `${svcHref}${cat.id}/`} style="color:inherit;text-decoration:none;">{cat.title}</a></h3>
            <p>{cat.descripcion}</p>
            <p class="service-card__claim">{cat.claim}</p>
            <div class="hero__actions">
              <a
                class="hero__cta-secondary"
                href={cat.id.startsWith(servicio.id + '/') ? `${svcHref}${cat.id}/` : `${svcHref}${cat.id}/`}
                >Ver +</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Casos anónimos de éxito del servicio (Problema → Solución justa → Resultado medible) -->
  <CasosAnonimosSection
    servicioId={servicio.id}
    title={`Casos reales de ${svcTitle}`}
    subtitle="Tecnología justa aplicada: problema concreto, solución sin sobrecostos y resultado medible."
  />

  <!-- Testimonios / Social proof -->
  {testimoniosData && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="section__title">{testimoniosData.section_title}</h2>
        <div class="testimonials-grid">
          {testimoniosData.testimonios.map((t) => (
            <div class="testimonial-card">
              <p class="testimonial-card__quote">
                "{t.quote}"
              </p>
              <p class="testimonial-card__author">{t.autor}</p>
              {t.rol && <p class="testimonial-card__role">{t.rol}</p>}
              {t.ubicacion && <p class="testimonial-card__role">{t.ubicacion}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  .service-card__claim {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--tertiary);
    margin-top: var(--spacing-xs);
  }
  .service-value-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    margin: 0 auto var(--spacing-lg);
    max-width: 680px;
  }
  .value-pill {
    background: #EBF4FF;
    color: var(--tertiary-dark);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    padding: 6px 14px;
    border-radius: var(--rounded-full);
    border: 1px solid rgba(10, 124, 255, 0.2);
    text-align: center;
    white-space: normal;
    overflow-wrap: break-word;
  }
</style>
