---
import Layout from '../../layouts/Layout.astro';
import SolucionesSection from '../../components/SolucionesSection.astro';
---

<Layout
  title="Servicios"
  description="Servicios para PyMEs en Rosario: automatización de procesos, software a medida y presencia online, con más de 15 años de experiencia."
>
  <section class="hero">
    <div class="hero__container">
      <p class="hero__label">SERVICIOS</p>
      <h1 class="hero__title">Soluciones para tu negocio</h1>
      <p class="hero__subtitle">
        Tenemos varias formas de ayudarte a ganar tiempo, reducir costos y vender más. Elegí la que mejor se adapta a lo que necesitás hoy.
      </p>
    </div>
  </section>

  <SolucionesSection />
</Layout>
