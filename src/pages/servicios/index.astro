---
import Layout from '../../layouts/Layout.astro';
import SolucionesSection from '../../components/SolucionesSection.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
---

<Layout
  title="Servicios · Tecnología Justa para PyMEs en Rosario"
  description="Servicios informáticos para PyMEs en Rosario: elegimos la tecnología adecuada, no la de moda. Entendemos lo que cuesta cada peso."
>
  <section class="hero">
    <div class="hero__container">
      <h1 class="hero__title">Soluciones con tecnología justa para tu negocio</h1>
      <p class="hero__subtitle">
        IA aplicada, automatización, presencia online y software a medida: elegimos la tecnología adecuada, no la de moda. Te ayudamos a ganar tiempo, reducir costos operativos y vender más sin pagar licencias de más.
      </p>
      <div class="hero__actions">
        <Button variant="primary" size="lg" href="/contacto/" class="hero__cta hero__cta--form">Consultar sin cargo</Button>
      </div>
    </div>
  </section>

  <SolucionesSection />
</Layout>
