---
// Ruta: src/pages/contacto-v2.astro
// Página pública que reúne el formulario progresivo reutilizable.
// - Reemplaza gradualmente a contacto.astro (misma meta: captura de leads via Formspree).
// - Reutilizable desde servicios/*, casos-exito/* y futuras landing de marketing.
// - CTA principal del site (Header + servicios) apunta AQUÍ, no a WhatsApp.
//
// Props build-time: precargamos categoria/asunto según el contexto de invocación.
import Layout from '../layouts/Layout.astro';
import FormContactoProgresivo from '../components/FormContactoProgresivo.astro';

// Para esta landing genérica: sin precarga (el usuario elige su servicio en step1).
// Las landing específicas (servicios/*) pasan categoria="automatizacion" + asunto precargado.
---
<Layout title="Contacto comercial | SACsi" description="Consultoría de automatización e IA para PyMEs. Dejanos tu brief y te contactamos con un presupuesto ajustado a tu necesidad.">
  <main class="container">
    <header class="page-header">
      <h1>Contacto comercial</h1>
      <p class="subtitle">
        Contanos qué necesitás y te preparo un brief personalizado.<br>
        <strong>Reemplazamos el WhatsApp por un formulario estructurado:</strong> capturamos tu servicio, brief y datos para contactarte de la forma más precisa posible.
      </p>
    </header>

    <section>
      <FormContactoProgresivo source="contacto-v2-header" />
    </section>

    <!-- Noscript fallback (formulario simple mailto, accesible sin JS) -->
    <section class="noscript-fallback">
      <h2>Contacto alternativo (sin JavaScript)</h2>
      <form
        method="POST"
        action="https://formspree.io/f/mljrdlka"
        class="fallback-form"
      >
        <div class="form-group">
          <label for="fb-name">Nombre y apellido *</label>
          <input type="text" id="fb-name" name="name" required maxlength="100">
        </div>
        <div class="form-group">
          <label for="fb-email">Email *</label>
          <input type="email" id="fb-email" name="email" required maxlength="100">
        </div>
        <div class="form-group">
          <label for="fb-brief">Brief *</label>
          <textarea id="fb-brief" name="message" required rows="3" maxlength="500" placeholder="¿Qué necesitás?."></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Enviar</button>
      </form>
    </section>
  </main>
</Layout>

<style>
  .page-header { text-align: center; margin: var(--space-lg, 2rem) 0; }
  .subtitle { color: var(--muted-foreground, #666); max-width: 680px; margin-inline: auto; }
  .fallback-form { display: grid; gap: var(--space-sm, .75rem); max-width: 540px; margin-inline: auto; }
  .noscript-fallback { margin-top: var(--space-lg, 2rem); padding: var(--space-md, 1.5rem); border: 1px dashed var(--border, #ccc); border-radius: 10px; }
  @media (max-width: 600px) { .fallback-form { grid-template-columns: 1fr; } }
</style>
