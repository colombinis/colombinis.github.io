---
// Ruta dinámica: detalle de cada solución (PDP de e-commerce)
// URL: /soluciones/<id>/
// Data source: src/data/soluciones/listado-soluciones.json + src/data/soluciones/detalle/solucion_<id>.json
// Patrón: Product Detail Page — breadcrumb, precio desde*, qué incluye,
//         proceso, soluciones relacionadas, FAQ y CTA final.
import Layout from '../../layouts/Layout.astro';
import FAQData from '../../data/preguntas-frecuentes-solucion.json';
import SocialProofSection from '../../components/SocialProofSection.astro';
import {
  getSoluciones,
  getSolucionDetalle,
  getCategoria,
  getServicio,
} from '../../lib/data-utils';

interface Props {
  params: { solucion: string };
}

// Genera una ruta estática por cada solución
export async function getStaticPaths() {
  return getSoluciones().map((s) => ({
    params: { solucion: s.id },
  }));
}

const solucionId = Astro.params.solucion;
const solucion = getSoluciones().find((s) => s.id === solucionId);

if (!solucion) {
  throw new Error(`No se encontró la solución: ${solucionId}`);
}

const detalle = getSolucionDetalle(solucion.id);
const flujo = detalle?.flujo ?? [];

// --- Formatos de presentación --
// Los precios de los datos están en ARS "k" (miles): 500 → $500.000
const arsFormatter = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});

function formatearARS(miles: number): string {
  return arsFormatter.format(Math.round(miles * 1000));
}

function formatearHoras(min: number, max: number): string {
  return min === max ? `${min} h` : `${min}-${max} h`;
}

// --- Categorías + breadcrumb (Inicio › Servicio › Categoría › Solución) ---
const categorias = (solucion.categorias ?? [])
  .map((id) => getCategoria(id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const categoriaPrincipal = categorias[0];
const servicio = categoriaPrincipal ? getServicio(categoriaPrincipal.servicio_id) : undefined;

const breadcrumb = [
  { label: 'Inicio', href: '/' },
  ...(servicio ? [{ label: servicio.title, href: servicio.href }] : []),
  ...(servicio && categoriaPrincipal
    ? [{ label: categoriaPrincipal.title, href: `${servicio.href}${categoriaPrincipal.id}/` }]
    : []),
  { label: solucion.nombre, href: Astro.url.pathname },
];

// --- Descripción (meta + bloque de producto) ---
const descripcion =
  solucion.descripcion_publica ||
  detalle?.flujo?.[0]?.descripcion ||
  'Un paquete de solución estructurada para resolver un desafío puntual de tu negocio.';

// --- Soluciones relacionadas (comparten al menos una categoría) ---
const relacionadas = getSoluciones()
  .filter(
    (s) =>
      s.id !== solucion.id &&
      (s.categorias ?? []).some((cat) => (solucion.categorias ?? []).includes(cat))
  )
  .slice(0, 3);

// --- FAQ del PDP: generales + específicas de la categoría ---
const faqs = FAQData.preguntas.filter(
  (q) =>
    q.donde_mostrar.nivel === 'general' ||
    (categoriaPrincipal && q.donde_mostrar.categoria === categoriaPrincipal.id)
);

// --- Structured data (schema.org Product) ---
const jsonLdProduct = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: solucion.nombre,
  description: descripcion,
  ...(categoriaPrincipal ? { category: categoriaPrincipal.title } : {}),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'ARS',
    lowPrice: solucion.precioMin * 1000,
    highPrice: solucion.precioMax * 1000,
    availability: 'https://schema.org/InStock',
  },
};

// --- Links de contacto ---
// URL del formulario de contacto con la categoría y asunto precargados
const contactoUrl = categoriaPrincipal
  ? `/contacto/?categoria=${categoriaPrincipal.id}&asunto=${encodeURIComponent(solucion.nombre)}`
  : `/contacto/?asunto=${encodeURIComponent(solucion.nombre)}`;

const esRango = solucion.precioMax > solucion.precioMin;
const totalPasos = flujo.length;
const horasTotales = formatearHoras(solucion.horasMin, solucion.horasMax);
---

<Layout title={solucion.nombre} description={descripcion}>
  <!-- Structured data del producto -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdProduct)} />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumb.map((item) => (
        <li>
          {item.href === Astro.url.pathname ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <!-- Producto: info + caja de precio / compra -->
  <section class="pdp">
    <div class="container pdp__grid">
      <div class="pdp__left">
        {categoriaPrincipal && (
          <div class="pdp__media" aria-hidden="true">
            <span class="pdp__media-icon">{categoriaPrincipal.icon}</span>
            <span class="pdp__media-label">{categoriaPrincipal.title}</span>
          </div>
        )}
        <div class="pdp__info">
          <span class="pdp__tag">Solución a medida</span>
          <h1 class="pdp__title">{solucion.nombre}</h1>
          <p class="pdp__desc">{descripcion}</p>
          <ul class="pdp__chips">
            <li>Tiempo estimado: {horasTotales}</li>
            {totalPasos > 0 && (
              <li>{totalPasos} {totalPasos === 1 ? 'paso' : 'pasos'} de ejecución</li>
            )}
          </ul>
          {categorias.length > 0 && (
            <div class="pdp__cats">
              {categorias.map((cat) => (
                <span class="pdp__cat">{cat.title}</span>
              ))}
            </div>
          )}
        </div>
      </div>

      <aside class="pdp__buybox" aria-label="Precio y consulta">
        <p class="pdp__price-label">
          Precio desde<sup aria-hidden="true">*</sup>
        </p>
        <p class="pdp__price">{formatearARS(solucion.precioMin)}</p>
        {esRango && <p class="pdp__price-old">{formatearARS(solucion.precioMax)}</p>}
        <p class="pdp__note">
          <sup aria-hidden="true">*</sup>
          Precios expresados en pesos argentinos (ARS) y válidos para clientes que ya tienen
          productos contratados con SACsi.
        </p>
        <div class="pdp__actions">
          <a
            class="pdp__cta pdp__cta--primary"
            href={contactoUrl}
            >Quiero recibir mas info</a
          >
        </div>
        <ul class="pdp__trust">
          <li>Presupuesto claro y sin compromiso</li>
          <li>Avances en cada etapa</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Qué incluye (especificaciones del producto) -->
  {flujo.length > 0 && (
    <section class="section section--alt" aria-labelledby="incluye-titulo">
      <div class="container">
        <h2 class="section__title" id="incluye-titulo">Qué incluye esta solución</h2>
        <div class="incluye__grid">
          <div class="incluye__col">
            <h3 class="incluye__subtitle">Recibís</h3>
            <ul class="incluye__list">
              {flujo.map((paso) => (
                <li class="incluye__item">
                  <span class="incluye__num">{paso.orden}</span>
                  <span>{detalle?.recibis || paso.salidas}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="incluye__col">
            <h3 class="incluye__subtitle">Qué necesitamos de vos</h3>
            <ul class="incluye__list">
              {flujo.map((paso) => (
                <li class="incluye__item">
                  <span class="incluye__num">{paso.orden}</span>
                  <span>{detalle?.necesitamos || paso.entradas}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Soluciones relacionadas (cross-sell) -->
  {relacionadas.length > 0 && (
    <section class="section section--alt" aria-labelledby="relacionadas-titulo">
      <div class="container">
        <h2 class="section__title" id="relacionadas-titulo">Soluciones relacionadas</h2>
        <div class="cards-grid">
          {relacionadas.map((s) => {
            const resumen = getSolucionDetalle(s.id)?.flujo?.[0]?.descripcion || '';
            return (
              <article class="service-card">
                <h3>
                  <a href={`/soluciones/${s.id}/`}>{s.nombre}</a>
                </h3>
                {resumen && <p>{resumen}</p>}                
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-titulo">
    <div class="container">
      <h2 class="section__title" id="faq-titulo">Preguntas frecuentes</h2>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <div class="faq-item">
            <button
              class="faq-question"
              type="button"
              aria-expanded="false"
              aria-controls={`faq-answer-${i}`}
              id={`faq-question-${i}`}
            >
              {faq.titulo}
            </button>
            <div class="faq-answer" id={`faq-answer-${i}`}>
              <p set:html={faq.respuesta} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Resultados que hablan (componente reutilizable) -->
  <SocialProofSection />

</Layout>

<script>
  // Acordeón de FAQ del PDP
  document.querySelectorAll('.faq-question').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const item = this.closest('.faq-item') as HTMLElement;
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const isOpen = this.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('.faq-question[aria-expanded="true"]').forEach(function (openBtn) {
        openBtn.setAttribute('aria-expanded', 'false');
        const openItem = (openBtn as HTMLElement).closest('.faq-item') as HTMLElement;
        openItem.querySelector('.faq-answer')?.classList.remove('open');
      });

      if (!isOpen) {
        this.setAttribute('aria-expanded', 'true');
        answer.classList.add('open');
      }
    });
  });
</script>

<style>
  /* ---------- Breadcrumb ---------- */
  .breadcrumb {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-md) 0;
    font-size: 0.9rem;
  }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadcrumb li {
    color: var(--secondary);
  }
  .breadcrumb li + li::before {
    content: '›';
    margin: 0 var(--spacing-sm);
    color: var(--muted);
  }
  .breadcrumb a {
    color: var(--primary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb [aria-current='page'] {
    color: var(--tertiary-dark);
    font-weight: 600;
  }

  /* ---------- Layout del producto ---------- */
  .pdp {
    padding: var(--spacing-xl) var(--spacing-md);
  }
  .pdp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  /* Media / galería decorativa */
  .pdp__media {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xxl) var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border: 1px solid #ECECEF;
    border-radius: var(--rounded-md);
    text-align: center;
  }
  .pdp__media-icon {
    font-size: 3.5rem;
    line-height: 1;
  }
  .pdp__media-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tertiary-dark);
  }

  /* Info del producto */
  .pdp__tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tertiary-dark);
    background: rgba(0, 122, 255, 0.08);
    border-radius: var(--rounded-full);
    padding: 4px 12px;
    margin-bottom: var(--spacing-md);
  }
  .pdp__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--primary);
    margin: 0 0 var(--spacing-md);
  }
  .pdp__desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 0 var(--spacing-lg);
    max-width: 60ch;
  }
  .pdp__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-lg);
  }
  .pdp__chips li {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
    background: var(--surface);
    border: 1px solid #E0E0E0;
    border-radius: var(--rounded-full);
    padding: 6px 16px;
  }
  .pdp__cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }
  .pdp__cat {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--secondary);
    background: rgba(0, 0, 0, 0.05);
    border-radius: var(--rounded-full);
    padding: 4px 12px;
  }

  /* Caja de precio / compra */
  .pdp__buybox {
    align-self: start;
    background: var(--surface);
    border: 1px solid #ECECEF;
    border-radius: var(--rounded-md);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
    padding: var(--spacing-xl);
  }
  .pdp__price-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tertiary-dark);
    margin: 0 0 var(--spacing-xs);
  }
  .pdp__price {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--primary);
    margin: 0 0 var(--spacing-xs);
  }
  .pdp__price-old {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: line-through;
    margin: 0 0 var(--spacing-md);
  }
  .pdp__note {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 var(--spacing-md);
  }
  .pdp__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
  }
  .pdp__cta {
    display: inline-block;
    text-align: center;
    padding: 14px 24px;
    border-radius: var(--rounded-sm);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .pdp__cta--primary {
    background-color: var(--tertiary);
    color: #FFFFFF;
  }
  .pdp__cta--primary:hover {
    background-color: var(--tertiary-dark);
    color: #FFFFFF;
  }
  .pdp__trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .pdp__trust li {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (min-width: 601px) {
    .pdp__grid {
      grid-template-columns: 1fr 1fr;
    }
    .pdp__actions {
      flex-direction: row;
    }
  }
</style>
