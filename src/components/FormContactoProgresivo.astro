---
// Ruta: src/components/FormContactoProgresivo.astro
// Formulario de contacto REUTILIZABLE (reemplaza formulario simple de contacto.astro y CTAs WhatsApp).
// UNA SOLA VISTA: todos los campos visibles por defecto (sin steps). Jerarquía en el select:
//   <optgroup label="Servicio"> → categorías del servicio; + <optgroup label="Otro">.
//
// Props (build-time, reutilizables por página/marketing):
//   categoria?:  opcional, precarga el select (p.ej. "facturacion-cobranzas").
//   asunto?:     opcional, NO se usa como campo visible (el user pidió borrar "Asunto").
//   source?:     opcional, identificador de campaña para dataLayer (p.ej. "header", "contacto-page").
//
// Arquitectura:
//   - Un solo paso: select servicio/categoría (requerido) + email (requerido) + brief (requerido).
//   - Submit único "Enviar mensaje" → POST Formspree (config.contact.form_endpoint).
//   - Debajo del submit: botón WhatsApp (con icono) + botón "Preferís email?" (estilo botón, scroll al email).
//   - Redes sociales con iconos SVG de la misma familia que el icono de WhatsApp (no emojis).
//   - Eventos GTM (dataLayer.push): form_submit (onsubmit), checkout_started (en click de enviar).
//   - NO jQuery. Vanilla JS inline solo para validación + toggle "otro" + GTM.
//   - Build-time: getServicios() + getCategoriasByServicio() popular el select jerarquizado.
import { getServicios, getCategoriasByServicio } from '../lib/data-utils';
import config from '../config/site.json';

interface Props {
  categoria?: string;
  asunto?: string;
  source?: string;
}

const { categoria, source } = Astro.props as Props;
const formEndpoint = config.contact.form_endpoint;
const whatsappUrl = `${config.contact.whatsapp.base_url}?phone=${config.contact.whatsapp.phone}&text=Hola%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20soluciones`;

// Jerarquía servicio -> categorías (fuente de verdad: data-utils).
const servicios = getServicios().map((svc) => ({
  id: svc.id,
  title: svc.title,
  categorias: getCategoriasByServicio(svc.id).map((c) => ({
    id: c.id,
    title: c.title,
  })),
}));
const sourceDefault = source ?? 'contacto-progresivo';
---

<form
  id="form-contacto-progresivo"
  class="progressive-form"
  method="POST"
  action={formEndpoint}
  data-source={sourceDefault}
  autocomplete="on"
>
  <!-- 1. Select jerarquizado: Servicio > Categorías + Otro (requerido) -->
  <div class="form-group">
    <label for="pf-categoria">¿Sobre qué necesitás información? <span aria-hidden="true">*</span></label>
    <select id="pf-categoria" name="categoria" required>
      <option value="" disabled selected={categoria ? undefined : true}>Elegí una opción</option>
      {servicios.map((svc) => (
        <optgroup label={svc.title}>
          {svc.categorias.map((cat) => (
            <option value={cat.id} selected={categoria === cat.id ? true : undefined}>
              {cat.title}
            </option>
          ))}
        </optgroup>
      ))}
      <optgroup label="Otro">
        <option value="otro" selected={categoria === 'otro' ? true : undefined}>Otro (especificar)</option>
      </optgroup>
    </select>
  </div>

  <!-- texto libre si elige "Otro" -->
  <div class="form-group" id="pf-otro-wrap" hidden>
    <label for="pf-categoria-otro">Especificá el servicio</label>
    <input
      type="text"
      id="pf-categoria-otro"
      name="categoria_otro"
      placeholder="Ej: integración de pagos"
      maxlength="80"
    >
  </div>

  <!-- 2. Email (requerido) -->
  <div class="form-group">
    <label for="pf-email">Email <span aria-hidden="true">*</span></label>
    <input type="email" id="pf-email" name="email" required maxlength="100" placeholder="tu@email.com">
  </div>

  <!-- 3. Cuéntanos brevemente (requerido) -->
  <div class="form-group">
    <label for="pf-brief">Cuéntanos brevemente qué necesitás <span aria-hidden="true">*</span></label>
    <textarea id="pf-brief" name="message" rows="4" required maxlength="500" placeholder="Máximo 500 caracteres..."></textarea>
  </div>

  <!-- Botón único de envío -->
  <button type="submit" class="btn btn--primary" id="pf-submit">Enviar mensaje</button>

  <!-- Alternativas: WhatsApp (icono) + Preferís email? -->
  <div class="form-alt">
    <a class="btn btn--whatsapp" href={whatsappUrl} rel="noopener noreferrer" target="_blank" aria-label="Contactarnos por WhatsApp">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-5.46-4.45-9.91-9.92-9.91zm0 1.8c4.47 0 8.11 3.64 8.11 8.11 0 4.47-3.64 8.11-8.11 8.11a8.06 8.06 0 0 1-4.13-1.14l-.3-.18-3.12.82.83-3.04-.2-.31a8.07 8.07 0 0 1-1.26-4.35c0-4.47 3.64-8.11 8.11-8.11zm-3.04 3.96c-.17 0-.45.06-.69.34-.24.28-.83.81-.83 1.97 0 1.16.85 2.28 1.7 3.12.94.94 2.18 1.46 3.48 1.77.45.13.9.03 1.11-.16.16-.15.71-.66.9-1.01.18-.35.36-.7.36-1.01 0-.3-.15-.46-.54-.64-.39-.18-2.31-1.14-2.67-1.27-.36-.13-.62-.2-.88.2-.26.4-1.01 1.01-1.24 1.22-.23.2-.46.23-.86.13-.4-.1-1.69-.62-3.22-1.98-1.19-1.06-1.99-2.37-2.22-2.77-.23-.4-.02-.62.18-.82.18-.18.4-.46.6-.69.2-.23.27-.39.4-.65.14-.26.07-.49-.03-.68-.1-.2-.88-2.12-1.2-2.9-.32-.78-.64-.68-.88-.69z"/>
      </svg>
      Escribir por WhatsApp
    </a>
    <button type="button" class="btn btn--email" id="pf-prefiere-email">Preferís email?</button>
  </div>

  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<!-- Redes sociales (iconos de la misma familia que WhatsApp) -->
<div class="social-links">
  <a class="social-item" href={config.social.instagram} rel="noopener noreferrer" target="_blank" aria-label="Instagram">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.8c-3.15 0-3.52.01-4.76.07-.9.04-1.38.19-1.7.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.13.32-.28.8-.32 1.7C3.98 8.48 3.97 8.85 3.97 12s.01 3.52.07 4.76c.04.9.19 1.38.32 1.7.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.13.8.28 1.7.32 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c.9-.04 1.38-.19 1.7-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.04-.9-.19-1.38-.32-1.7a2.85 2.85 0 0 0-.69-1.06 2.85 2.85 0 0 0-1.06-.69c-.32-.13-.8-.28-1.7-.32C15.52 3.97 15.15 3.96 12 3.96zm0 3.06A4.98 4.98 0 1 1 12 17a4.98 4.98 0 0 1 0-9.98zm0 1.8a3.18 3.18 0 1 0 0 6.36 3.18 3.18 0 0 0 0-6.36zm5.18-.7a1.16 1.16 0 1 1 0 2.32 1.16 1.16 0 0 1 0-2.32z"/>
    </svg>
    Instagram
  </a>
  <a class="social-item" href={config.social.youtube} rel="noopener noreferrer" target="_blank" aria-label="YouTube">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/>
    </svg>
    YouTube
  </a>
  <a class="social-item" href={config.social.linkedin} rel="noopener noreferrer" target="_blank" aria-label="LinkedIn">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.74v20.51C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.74C24 .78 23.2 0 22.22 0z"/>
    </svg>
    LinkedIn
  </a>
</div>

<style>
  .progressive-form {
    display: grid;
    gap: 1rem;
    max-width: 560px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }
  .form-group label {
    font-size: .85rem;
    color: var(--secondary, #444);
    font-weight: 600;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: .6rem .75rem;
    border: 1px solid #D0D0D0;
    border-radius: 8px;
    font-size: .95rem;
    color: var(--primary, #222);
    background: #fff;
    font-family: inherit;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: 2px solid var(--tertiary, #0066cc);
    outline-offset: 1px;
    border-color: var(--tertiary, #0066cc);
  }
  .form-group textarea { resize: vertical; }

  /* Botones */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    cursor: pointer;
    border: none;
    border-radius: 8px;
    padding: .7rem 1.2rem;
    font-size: .95rem;
    font-weight: 600;
    font-family: inherit;
    text-decoration: none;
    transition: background-color .2s ease, color .2s ease;
  }
  .btn--primary {
    background: var(--primary, #1A1A2E);
    color: #fff;
  }
  .btn--primary:hover { background: var(--tertiary, #0066cc); }
  .btn--primary:disabled { opacity: .5; cursor: not-allowed; }

  .btn--whatsapp {
    background: var(--whatsapp, #25D366);
    color: #fff;
  }
  .btn--whatsapp:hover { background: var(--whatsapp-hover, #1ebe5d); }

  .btn--email {
    background: transparent;
    color: var(--secondary, #444);
    border: 1.5px solid #D0D0D0;
  }
  .btn--email:hover {
    border-color: var(--tertiary, #0066cc);
    color: var(--tertiary, #0066cc);
  }

  .form-alt {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    align-items: center;
  }
  .ic { flex-shrink: 0; }

  .form-status {
    font-size: .85rem;
    color: var(--secondary, #444);
    margin: 0;
    min-height: 1.1em;
  }
  .form-status--success { color: #128C7E; font-weight: 600; }
  .form-status--error { color: #E53935; font-weight: 500; }

  /* Redes sociales */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: .5rem;
  }
  .social-item {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .5rem .9rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: .9rem;
    color: var(--primary, #222);
    border: 1.5px solid #E0E0E0;
    transition: background-color .2s ease, color .2s ease;
  }
  .social-item:hover {
    background: var(--tertiary, #0066cc);
    color: #fff;
    border-color: var(--tertiary, #0066cc);
  }
  .social-item .ic { color: currentColor; }

  @media (max-width: 600px) {
    .btn, .social-item { width: 100%; }
    .form-alt { flex-direction: column; align-items: stretch; }
  }
</style>

<script>
  (function () {
    var form = document.getElementById('form-contacto-progresivo');
    if (!form) return;

    var categoria = form.querySelector('#pf-categoria');
    var categoriaOtro = form.querySelector('#pf-categoria-otro');
    var otroWrap = form.querySelector('#pf-otro-wrap');
    var email = form.querySelector('#pf-email');
    var brief = form.querySelector('#pf-brief');
    var submitBtn = form.querySelector('#pf-submit');
    var prefiereEmail = form.querySelector('#pf-prefiere-email');
    var statusEl = form.querySelector('.form-status');
    var source = form.getAttribute('data-source') || 'contacto-progresivo';

    function categoriaValida() {
      var v = categoria.value;
      if (!v) return false;
      if (v === 'otro') return categoriaOtro.value.trim().length > 0;
      return true;
    }
    function contactoValido() {
      return email.value.trim().length > 0 && email.value.indexOf('@') > -1 &&
             brief.value.trim().length > 0;
    }
    function updateSubmit() {
      submitBtn.disabled = !(categoriaValida() && contactoValido());
    }

    if (categoria) categoria.addEventListener('change', function () {
      otroWrap.hidden = categoria.value !== 'otro';
      if (categoria.value !== 'otro') categoriaOtro.value = '';
      updateSubmit();
    });
    if (categoriaOtro) categoriaOtro.addEventListener('input', updateSubmit);
    if (email) email.addEventListener('input', updateSubmit);
    if (brief) brief.addEventListener('input', updateSubmit);

    if (prefiereEmail) prefiereEmail.addEventListener('click', function () {
      email.scrollIntoView({ behavior: 'smooth', block: 'center' });
      email.focus();
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!categoriaValida() || !contactoValido()) {
        statusEl.textContent = 'Completá los campos requeridos (*).';
        statusEl.className = 'form-status form-status--error';
        return;
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'checkout_started', source: source, categoria: categoria.value });

      var data = new FormData(form);
      fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' },
      })
        .then(function (resp) {
          if (resp.ok) {
            window.dataLayer.push({
              event: 'form_submit',
              form_name: 'contacto-progresivo',
              source: source,
              categoria: categoria.value,
            });
            statusEl.textContent = '¡Mensaje enviado! Te respondemos en 24 h.';
            statusEl.className = 'form-status form-status--success';
            form.reset();
            otroWrap.hidden = true;
          } else {
            statusEl.textContent = 'Error al enviar. Por favor, intentá de nuevo.';
            statusEl.className = 'form-status form-status--error';
          }
        })
        .catch(function () {
          statusEl.textContent = 'Error de conexión. Escribinos por WhatsApp.';
          statusEl.className = 'form-status form-status--error';
        });
    });

    updateSubmit();
  })();
</script>
