---
// Ruta: src/components/FormContactoProgresivo.astro
// Formulario de contacto REUTILIZABLE (reemplaza formulario simple de contacto.astro y CTAs WhatsApp).
// UNA SOLA VISTA: todos los campos visibles por defecto (sin steps). Jerarquía en el select:
//   <optgroup label="Servicio"> → opción del servicio (value=svc.id) + categorías del servicio (value=cat.id); + <optgroup label="Otro">.
//   El select lista servicios Y categorías (todos los ids de los .json de fuente de verdad),
//   para que ?categoria=<svc.id> o ?categoria=<cat.id> precarguen correctamente.
//
// Props (build-time, reutilizables por página/marketing):
//   categoria?:  opcional, precarga el select (p.ej. "facturacion-cobranzas").
//   asunto?:     opcional, NO se usa como campo visible (el user pidió borrar "Asunto").
//   source?:     opcional, identificador de campaña para dataLayer (p.ej. "header", "contacto-page").
//
// Arquitectura:
//   - Un solo paso: nombre + select servicio/categoría + email + brief (requeridos).
//   - Submit único "Enviar mensaje" → POST al backend configurado en site.json.
//   - Debajo del submit: botón WhatsApp (con icono) + botón "Preferís email?" (estilo botón, scroll al email).
//   - Redes sociales removidas del form (feedback dueño 2026-10-06): Instagram y YouTube
//     viven ahora en el Footer (col 4); LinkedIn se eliminó del sitio.
//   - Eventos GTM (dataLayer.push): form_submit (onsubmit), checkout_started (en click de enviar).
//   - NO jQuery. Vanilla JS inline solo para validación + GTM.
//   - Build-time: getServicios() + getCategoriasByServicio() popular el select jerarquizado.
//
// Diseño Atómico (DESIGN.md): campos <Input>/<Textarea> y CTAs <Button> vienen de
// src/components/ui/ (ver design-style-guide.astro). El select jerarquizado NO tiene
// primitivo Select en el catálogo — se conserva el <select> nativo con estilos
// tokenizados a mano (mismo box de Input). IDs/nombres de campos y hooks JS intocados
// (contrato E2E: #form-contacto-progresivo, pf-categoria, pf-brief, .form-status,
// .cf-turnstile, dataLayer checkout_started/form_submit, fetch(form.action) con resp.ok).
import { getServicios, getCategoriasByServicio } from '../lib/data-utils';
import config from '../config/site.json';
import { CheckCircle2 } from 'lucide-astro';
import Button from './ui/Button.astro';
import Input from './ui/Input.astro';
import Textarea from './ui/Textarea.astro';

interface Props {
  categoria?: string;
  asunto?: string;
  source?: string;
  defaultToOtros?: boolean;
}

const { categoria, source, defaultToOtros = false } = Astro.props as Props;
const formEndpoint = config.contact.form_endpoint;
const whatsappUrl = `${config.contact.whatsapp.base_url}?phone=${config.contact.whatsapp.phone}&text=Hola%20SACsi,%20quiero%20hacer%20una%20consulta%20sin%20cargo%20para%20mi%20negocio`;

// Jerarquía servicio -> categorías (fuente de verdad: data-utils).
const servicios = getServicios().map((svc) => ({
  id: svc.id,
  title: svc.title,
  categorias: getCategoriasByServicio(svc.id).map((c) => ({
    id: c.id,
    title: c.title,
  })),
}));
const sourceDefault = source ?? 'contacto-progresivo';
---

<form
  id="form-contacto-progresivo"
  class="progressive-form"
  method="POST"
  action={formEndpoint}
  data-source={sourceDefault}
  data-default-otros={defaultToOtros ? '1' : undefined}
  autocomplete="on"
>
  <!-- 1. Select jerarquizado: Servicio > Categorías + Otro (requerido).
       No existe primitivo Select en src/components/ui/ — se conserva el
       select nativo estilizado con los tokens de Input. -->
  <div class="form-group">
    <label for="pf-categoria">¿Sobre qué necesitás información? <span aria-hidden="true">*</span></label>
    <select id="pf-categoria" name="categoria" required>
      <option value="" disabled selected={categoria ? undefined : true}>Elegí una opción</option>
      {servicios.map((svc) => (
        <optgroup label={svc.title}>
          <option value={svc.id} selected={categoria === svc.id ? true : undefined}>
            {svc.title}
          </option>
          {svc.categorias.map((cat) => (
            <option value={cat.id} selected={categoria === cat.id ? true : undefined}>
              {cat.title}
            </option>
          ))}
        </optgroup>
      ))}
      <optgroup label="Otro">
        <option value="otro" selected={categoria === 'otro' ? true : undefined}>Otro (especificar)</option>
      </optgroup>
    </select>
  </div>

  <!-- 2. Nombre (requerido) -->
  <Input
    id="pf-nombre"
    name="nombre"
    type="text"
    label="Nombre"
    required
    maxlength="100"
    autocomplete="name"
    placeholder="Tu nombre"
  />

  <!-- 3. Email (requerido) -->
  <Input
    id="pf-email"
    name="email"
    type="email"
    label="Email"
    required
    maxlength="254"
    autocomplete="email"
    placeholder="tu@email.com"
  />

  <!-- 4. Cuéntanos brevemente (requerido) -->
  <Textarea
    id="pf-brief"
    name="message"
    label="Cuéntanos brevemente qué necesitás"
    required
    rows={4}
    maxlength="500"
    placeholder="Máximo 500 caracteres..."
  />

  <!-- Honeypot anti-spam: debe permanecer vacío y no es visible para usuarios. -->
  <div class="form-trap" aria-hidden="true">
    <Input
      id="pf-website"
      name="website"
      type="text"
      label="Sitio web"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <!-- Turnstile widget script (una sola vez por página) -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <!-- Turnstile: protección anti-bot. -->
  <div class="cf-turnstile" data-sitekey={config.contact.turnstile_site_key} data-theme="light" data-size="compact"></div>

  <!-- Botón único de envío -->
  <Button type="submit" variant="primary" id="pf-submit">Enviar consulta sin cargo</Button>

  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<!-- Thank-you state: reemplaza el form después de envío exitoso -->
<div class="form-thankyou" style="display:none;">
  <p class="form-thankyou__title" style="display:flex;align-items:center;justify-content:center;gap:8px;">
    <CheckCircle2 size={24} color="#059669" aria-hidden="true" />
    <span>¡Mensaje enviado con éxito!</span>
  </p>
  <p class="form-thankyou__text">¡Recibimos tu consulta! Te respondemos en menos de 24 horas hábiles con una primera orientación sincera. Mientras tanto, podés escribirnos por WhatsApp si es urgente.</p>
</div>

  <!-- Alternativas: WhatsApp (icono) + Preferís email? -->
  <div class="form-alt">
    <Button
      variant="whatsapp"
      href={whatsappUrl}
      rel="noopener noreferrer"
      target="_blank"
      aria-label="Contactarnos por WhatsApp"
    >
      <img slot="icon-start" class="ic" src="/icons/brand-whatsapp.svg" alt="WhatsApp" width="18" height="18" />
      Escribinos al WhatsApp
    </Button>
    <Button
      variant="outline"
      type="button"
      id="pf-prefiere-email"
      data-email={config.contact.email}
    >
      <img slot="icon-start" class="ic" src="/icons/mail.svg" alt="" aria-hidden="true" width="18" height="18" />
      Si preferis por Email
    </Button>
  </div>
<style>
  .progressive-form {
    display: grid;
    gap: 1rem;
    max-width: 560px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* Select nativo (no hay primitivo Select): mismo estilo que ui-input */
  .form-group label {
    font-size: 0.875rem;
    color: var(--primary, #1A1A2E);
    font-weight: 600;
  }
  .form-group select {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #CBD5E1;
    border-radius: var(--rounded-sm, 8px);
    font-size: 0.95rem;
    color: var(--primary, #1A1A2E);
    background-color: #FFFFFF;
    font-family: inherit;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }
  .form-group select:focus {
    outline: none;
    border-color: var(--tertiary, #0A7CFF);
    box-shadow: 0 0 0 3px rgba(10, 124, 255, 0.15);
  }
  .form-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: normal;
    justify-content: center;
  }
  .ic {
    flex-shrink: 0;
  }

  .form-status {
    font-size: 0.85rem;
    color: var(--secondary, #444);
    margin: 0;
    min-height: 1.1em;
  }
  .form-status--success { color: #128C7E; font-weight: 600; }
  .form-status--error { color: #E53935; font-weight: 500; }

  /* Mobile-first: los Button primitivos ocupan el ancho completo */
  @media (max-width: 600px) {
    .form-alt :global(.ui-btn) {
      width: 100%;
    }
    .form-alt {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  (function () {
    var form = document.getElementById('form-contacto-progresivo');
    if (!form) return;

    var categoria = form.querySelector('#pf-categoria');
    var nombre = form.querySelector('#pf-nombre');
    var email = form.querySelector('#pf-email');
    var brief = form.querySelector('#pf-brief');
    var submitBtn = form.querySelector('#pf-submit');
    var prefiereEmail = document.getElementById('pf-prefiere-email');
    var statusEl = form.querySelector('.form-status');
    var source = form.getAttribute('data-source') || 'contacto-progresivo';

    // Contenedores para thank-you state
    var formAlt = document.querySelector('.form-alt');
    var thankyou = document.querySelector('.form-thankyou');

    function categoriaValida() {
      return !!categoria.value;
    }
    function contactoValido() {
      return nombre.value.trim().length > 0 && email.value.trim().length > 0 && email.value.indexOf('@') > -1 &&
             brief.value.trim().length > 0;
    }
    function updateSubmit() {
      submitBtn.disabled = !(categoriaValida() && contactoValido());
    }

    if (categoria) categoria.addEventListener('change', updateSubmit);
    if (nombre) nombre.addEventListener('input', updateSubmit);
    if (email) email.addEventListener('input', updateSubmit);
    if (brief) brief.addEventListener('input', updateSubmit);

    if (prefiereEmail) prefiereEmail.addEventListener('click', function () {
      var dest = prefiereEmail.getAttribute('data-email') || 'sacsi@sacsi.com.ar';
      var catLabel = categoria && categoria.options[categoria.selectedIndex]
        ? categoria.options[categoria.selectedIndex].text
        : '';
      var subject = 'Consulta desde sacsi.com.ar' + (catLabel ? ' - ' + catLabel.trim() : '');
      window.location.href = 'mailto:' + dest + '?subject=' + encodeURIComponent(subject);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!categoriaValida() || !contactoValido()) {
        statusEl.textContent = 'Completá los campos requeridos (*).';
        statusEl.className = 'form-status form-status--error';
        return;
      }

      // Validar Turnstile si el widget está activo en la página
      var turnstileContainer = form.querySelector('.cf-turnstile');
      var turnstileToken = form.querySelector('input[name="cf-turnstile-response"]');
      if (turnstileContainer && window.turnstile && typeof window.turnstile.render === 'function') {
        if (!turnstileToken || !turnstileToken.value) {
          statusEl.textContent = 'Completá la verificación de seguridad.';
          statusEl.className = 'form-status form-status--error';
          return;
        }
      }

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'checkout_started', source: source, categoria: categoria.value });

      var data = new FormData(form);
      fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' },
      })
        .then(function (resp) {
          if (resp.ok) {
            window.dataLayer.push({
              event: 'form_submit',
              form_name: 'contacto-progresivo',
              source: source,
              categoria: categoria.value,
            });
            // Thank-you state: ocultar form
            form.style.display = 'none';
            // Dejamos visible el botón de WhatsApp (form-alt permanece)
            thankyou = document.querySelector('.form-thankyou');
            if (thankyou) thankyou.style.display = 'block';
            submitBtn.disabled = true;
          } else {
            statusEl.textContent = 'Error al enviar. Por favor, intentá de nuevo.';
            statusEl.className = 'form-status form-status--error';
          }
        })
        .catch(function () {
          statusEl.textContent = 'Error de conexión. Escribinos por WhatsApp.';
          statusEl.className = 'form-status form-status--error';
        });
    });

    // Precarga desde query-string del visitante (el sitio es estático: el build
    // no conoce los params, así que se resuelve en cliente).
    // - ?categoria=<slug> válido -> selecciona esa opción.
    // - sin param o inválido y data-default-otros -> selecciona "Otros".
    //   (el link del footer usa ?categoria=otros; se normaliza a 'otro')
    var defaultOtros = form.getAttribute('data-default-otros') === '1';
    var validValues = Array.prototype.map.call(categoria.options, function (o) { return o.value; });
    var catParam = new URLSearchParams(window.location.search).get('categoria');
    if (catParam === 'otros') catParam = 'otro';
    if (catParam && validValues.indexOf(catParam) !== -1) {
      categoria.value = catParam;
    } else if (defaultOtros) {
      categoria.value = 'otro';
    }
    updateSubmit();
  })();
</script>
