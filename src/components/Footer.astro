---
// Footer con 3 columnas:
// Col 1: Logo + texto "Soluciones Inteligentes" + links de servicios (desde src/data/servicios/ + categorias/)
// Col 2: Listado de trabajos (desde src/data/trabajos/listado-trabajos.json)
// Col 3: Sección "¿Empezamos?" con WhatsApp + email
// Background: #252628 (gris oscuro) con colores ajustados para contraste
import LogoBrand from './LogoBrand.astro';
import { getServicios, getCategoriasByServicio, getTrabajos } from '../lib/data-utils';
import config from '../config/site.json';

// Datos normalizados: servicios + categorías
const servicios = getServicios();
const trabajos = getTrabajos();
---

<style>
  #footer-container {
    background: #252628;
    border-top: 1px solid #3a3b3f;
    padding: var(--spacing-xxl) var(--spacing-md);
  }
  footer.wrapper {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  /* Grid de 3 columnas */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xxl);
  }

  .footer-col h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #E0E0E0;
    margin: 0 0 var(--spacing-md);
  }

  /* ---------- Col 1: Logo + servicios ---------- */
  .footer-solutions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .footer-solution-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .footer-solution-title {
    color: #B0B0B0;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .footer-solution-title:hover {
    color: var(--tertiary);
  }
  .footer-solution-categories {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin: 0 0 0 var(--spacing-sm);
    padding: 0;
    list-style: none;
  }
  .footer-solution-categories a {
    color: #909090;
    text-decoration: none;
    font-size: 0.86rem;
    opacity: 0.9;
    transition: color 0.2s ease;
  }
  .footer-solution-categories a:hover {
    color: var(--tertiary);
    opacity: 1;
  }

  /* ---------- Col 2: Listado de trabajos ---------- */
  .footer-trabajos {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .footer-trabajo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 4px 0;
    border-bottom: 1px solid #3a3b3f;
  }
  .footer-trabajo:last-child {
    border-bottom: none;
  }
  .footer-trabajo__name {
    color: #B0B0B0;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .footer-trabajo__name:hover {
    color: var(--tertiary);
  }

  /* ---------- Col 3: Sección "¿Empezamos?" ---------- */
  .footer__cta h2 {
    color: #E0E0E0;
    margin-bottom: var(--spacing-md);
  }
  .footer__cta p {
    font-size: 1rem;
    line-height: 1.6;
    color: #B0B0B0;
    margin: 0 0 var(--spacing-md);
  }

  /* Fila de acciones: WhatsApp a la izquierda, email a la derecha */
  .footer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    align-items: center;
  }
  .footer__whatsapp {
    display: inline-block;
    background-color: var(--whatsapp);
    color: #FFFFFF;
    padding: 12px 28px;
    border-radius: var(--rounded-sm);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }
  .footer__whatsapp:hover {
    background-color: var(--whatsapp-hover);
    color: #FFFFFF;
  }

  .footer__contact-row {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.93rem;
    color: #909090;
    white-space: nowrap;
  }
  .footer__email {
    color: var(--tertiary);
    text-decoration: none;
    font-weight: 500;
  }
  .footer__email:hover {
    text-decoration: underline;
  }

  .footer-copy {
    font-size: 0.85rem;
    color: #909090;
    text-align: center;
    margin: 0;
  }

  /* Desktop: 3 columnas + acciones en fila */
  @media (min-width: 601px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: var(--spacing-xxl);
    }
    .footer__actions {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .footer__whatsapp {
      width: auto;
    }
  }

  @media (max-width: 600px) {
    .footer__actions {
      flex-direction: column;
    }
  }
</style>

<div id="footer-container">
  <footer class="wrapper">
    <div class="footer-grid">
      <!-- Col 1: Logo + servicios -->
      <div class="footer-col">
        <LogoBrand tagline="Soluciones Inteligentes" sin-texto="true"/>
        <div class="footer-solutions">
          {servicios.map((sol) => (
            <div class="footer-solution-group">
              <a class="footer-solution-title" href={sol.href}>{sol.title}</a>
              {sol.categorias_ids.length > 0 && (
                <ul class="footer-solution-categories">
                  {sol.categorias_ids.map((catId) => {
                    const cat = getCategoriasByServicio(sol.id).find((c) => c.id === catId);
                    return cat ? (
                      <li><a href={`${sol.href}${cat.id}/`}>{cat.title}</a></li>
                    ) : null;
                  })}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Col 2: Listado de trabajos -->
      <div class="footer-col">
        <h3>Trabajos</h3>
        <div class="footer-trabajos">
          {trabajos.map((trabajo) => (
            <div class="footer-trabajo">
              <a
                class="footer-trabajo__name"
                href={`/trabajos/${trabajo.id}/`}
              >{trabajo.nombre}</a>
            </div>
          ))}
        </div>
      </div>

      <!-- Col 3: Sección "¿Empezamos?" -->
      <div class="footer-col footer__cta">
        <h2>¿Empezamos?</h2>
        <p>
          Contanos tu proyecto sin compromiso. En 15 minutos podemos saber si podemos ayudarte y cómo.
        </p>
        <div class="footer__actions">
          <a
            class="footer__whatsapp"
            href={`${config.contact.whatsapp.base_url}?phone=${config.contact.whatsapp.phone}&text=Hola%20quiero%20saber%20más%20sobre%20sus%20soluciones%20informáticas`}
            rel="noopener noreferrer"
            target="_blank"
          >Escribinos por WhatsApp</a>
          <div class="footer__contact-row">
            <span aria-hidden="true">&#9993;</span>
            <a class="footer__email" href={`mailto:${config.contact.email}`}>{config.contact.email}</a>
          </div>
        </div>
      </div>
    </div>

    <p class="footer-copy">&copy; {new Date().getFullYear()} {config.site.name} — {config.site.tagline}</p>
  </footer>
</div>
