---
// Footer con 3 columnas:
// Col 1: Logo + texto "Soluciones Informáticas" + links de servicios (desde src/data/servicios/ + categorias/)
// Col 2: Listado de soluciones (desde src/data/soluciones/listado-soluciones.json)
// Col 3: Sección "¿Empezamos?" con WhatsApp + email
// Background: #252628 (gris oscuro) con colores ajustados para contraste
import LogoBrand from './LogoBrand.astro';
import { getServicios, getCategoriasByServicio, getSoluciones, getCasos } from '../lib/data-utils';
import config from '../config/site.json';

// Datos normalizados: servicios + categorías
const servicios = getServicios();
const soluciones = getSoluciones();
const casos = getCasos();
---

<style>
  #footer-container {
    background: #252628;
    border-top: 1px solid #3a3b3f;
    padding: var(--spacing-xxl) var(--spacing-md);
  }
  footer.wrapper {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  /* Grid de 3 columnas */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xxl);
  }

  .footer-col h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #E0E0E0;
    margin: 0 0 var(--spacing-md);
  }

  /* ---------- Col 1: Logo + servicios ---------- */
  .footer-solutions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .footer-solution-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .footer-solution-title {
    color: #B0B0B0;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .footer-solution-title:hover {
    color: var(--tertiary);
  }
  .footer-solution-categories {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin: 0 0 0 var(--spacing-sm);
    padding: 0;
    list-style: none;
  }
  .footer-solution-categories a {
    color: #909090;
    text-decoration: none;
    font-size: 0.86rem;
    opacity: 0.9;
    transition: color 0.2s ease;
  }
  .footer-solution-categories a:hover {
    color: var(--tertiary);
    opacity: 1;
  }

  /* ---------- Col 2: Listado de soluciones ---------- */
  .footer-soluciones {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .footer-solucion {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 4px 0;
    border-bottom: 1px solid #3a3b3f;
  }
  .footer-solucion:last-child {
    border-bottom: none;
  }
  .footer-solucion__name {
    color: #B0B0B0;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .footer-solucion__name:hover {
    color: var(--tertiary);
  }

  /* ---------- Col 3: Listado de casos de éxito ---------- */
  .footer-casos {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .footer-caso {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 4px 0;
    border-bottom: 1px solid #3a3b3f;
  }
  .footer-caso:last-child {
    border-bottom: none;
  }
  .footer-caso__name {
    color: #B0B0B0;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .footer-caso__name:hover {
    color: var(--tertiary);
  }

  /* ---------- Col 3: Sección "¿Empezamos?" ---------- */
  .footer__cta {
    text-align: center;
  }
  .footer__cta h2 {
    color: #E0E0E0;
    margin-bottom: var(--spacing-md);
  }
  .footer__cta p {
    font-size: 1rem;
    line-height: 1.6;
    color: #B0B0B0;
    margin: 0 0 var(--spacing-md);
  }

  /* Fila de acciones: WhatsApp a la izquierda, email a la derecha */
  .footer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    align-items: center;
  }
  .footer__cta--form {
    display: inline-block;
    background-color: var(--whatsapp);
    color: #FFFFFF;
    padding: 12px 28px;
    border-radius: var(--rounded-sm);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
    white-space: nowrap;
    align-self: center;
  }
  .footer__cta--form:hover {
    background-color: var(--whatsapp-hover);
    color: #FFFFFF;
  }

  .footer__contact-row {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.93rem;
    color: #909090;
    white-space: nowrap;
  }
  .footer__email {
    color: var(--tertiary);
    text-decoration: none;
    font-weight: 500;
  }
  .footer__email:hover {
    text-decoration: underline;
  }

  .footer-copy {
    font-size: 0.85rem;
    color: #909090;
    text-align: center;
    margin: 0;
  }

  /* Desktop: 3 columnas + acciones en fila */
  @media (min-width: 601px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: var(--spacing-xxl);
    }
    .footer__actions {
      flex-direction: row;
      justify-content: center;
      align-items: center;
    }
    .footer__cta--form {
      width: auto;
    }
  }

  @media (max-width: 600px) {
    .footer__actions {
      flex-direction: column;
    }
  }
</style>
  <section id="cta-final" class="cta-final">
    <div class="container">
      <div class="footer-col footer__cta">
        <h2>Tenes alguna pregunta?</h2>
        <p>
          En 15 minutos podes saber como podemos ayudarte.
        </p>
        <div class="footer__actions">
          <a
            class="footer__cta footer__cta--form"
            href="/contacto/?categoria=otros&asunto=Consulta%20desde%20footer"
            >Consultanos sin compromiso</a>
        </div>
      </div>
    </div>
  </section>
<div id="footer-container">
  <footer class="wrapper">
    <div class="footer-grid">
      <!-- Col 1: Logo + servicios -->
      <div class="footer-col">
        <LogoBrand tagline="Soluciones Informáticas" sin-texto="true"/>
        <div class="footer-solutions">
          {servicios.map((sol) => (
            <div class="footer-solution-group">
              <a class="footer-solution-title" href={sol.href}>{sol.title}</a>
              {sol.categorias_ids.length > 0 && (
                <ul class="footer-solution-categories">
                  {sol.categorias_ids.map((catId) => {
                    const cat = getCategoriasByServicio(sol.id).find((c) => c.id === catId);
                    return cat ? (
                      <li><a href={`${sol.href}${cat.id}/`}>{cat.title}</a></li>
                    ) : null;
                  })}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Col 2: Listado de soluciones -->
      <div class="footer-col">
        <h3>Soluciones</h3>
        <div class="footer-soluciones">
          {soluciones.map((solucion) => (
            <div class="footer-solucion">
              <a
                class="footer-solucion__name"
                href={`/soluciones/${solucion.id}/`}
              >{solucion.nombre}</a>
            </div>
          ))}
          <div class="footer-solucion">
            <a
              class="footer-solucion__name"
              href="/catalogo/"
            >Ver todas</a>
          </div>
        </div>
      </div>

      <!-- Col 3: Listado de casos de éxito -->
      <div class="footer-col">
        <h3>Casos de éxito</h3>
        <div class="footer-casos">
          {casos.map((caso) => (
            <div class="footer-caso">
              <a
                class="footer-caso__name"
                href={`/casos-exito/${caso.slug}/`}
              >{caso.title}</a>
            </div>
          ))}
        </div>
      </div>

      <!-- Col 4: NAP + Google Business Profile -->
      <div class="footer-col">
        <h3>{config.site.name}</h3>
        <div class="footer-nap">
          <p><strong>Dirección:</strong> Milan 1216, Rosario, Santa Fe CP 2000, Argentina</p>
          <p><strong>Tel:</strong> <a class="footer__email" href={`tel:${config.contact.phone_display}`}>{config.contact.phone_display}</a></p>
          <p><strong>Email:</strong> <a class="footer__email" href={`mailto:${config.contact.email}`}>{config.contact.email}</a></p>
          <p>
            <a class="footer__email" href="https://www.google.com/maps/search/?api=1&query=SACsi+Milan+1216+Rosario" target="_blank" rel="noopener noreferrer">
              Ver en Google Maps
            </a>
          </p>
        </div>
      </div>
    </div>

    <p class="footer-copy">&copy; {new Date().getFullYear()} {config.site.name} — {config.site.tagline}</p>
  </footer>
</div>
