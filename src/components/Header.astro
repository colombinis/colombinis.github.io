---
// Header con: logo + texto "SOLUCIONES INFORMÁTICAS", navegación sin "Inicio"
// Usa componente LogoBrand reutilizable y config/site.json
import LogoBrand from './LogoBrand.astro';
import config from '../config/site.json';

const links = config.nav.links;
---

<style>
  #header-container {
    position: relative;
    background: var(--surface);
    border-bottom: 1px solid #E8E8E8;
  }

  header.wrapper {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--spacing-sm) var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--surface);
    padding: var(--spacing-md);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    gap: var(--spacing-md);
    z-index: 100;
  }

  nav ul.active {
    display: flex;
  }

  .nav-link {
    font-size: 0.93rem;
    color: var(--secondary);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--tertiary);
  }

  .header-cta {
    display: none;
  }

  .hamburger {
    display: block;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    padding: 4px;
    color: var(--primary);
    line-height: 1;
  }

  @media (min-width: 601px) {
    .hamburger {
      display: none;
    }

    nav ul {
      display: flex;
      flex-direction: row;
      position: static;
      background: none;
      padding: 0;
      box-shadow: none;
      gap: var(--spacing-lg);
      z-index: auto;
    }

    .header-cta {
      display: inline-block;
    }

    header.wrapper {
      padding: var(--spacing-md) var(--spacing-lg);
    }
  }
</style>

<div id="header-container">
  <header class="wrapper">
    <LogoBrand tagline="SOLUCIONES INFORMÁTICAS" />
    <nav>
      <button
        class="hamburger"
        id="nav-toggle"
        aria-label="Abrir menú de navegación"
        aria-controls="nav-menu"
        aria-expanded="false"
      >
        ☰
      </button>
      <ul id="nav-menu" class="nav-menu">
        {links.map((link) => (
          <li>
            <a class="nav-link" href={link.href}>{link.label}</a>
          </li>
        ))}
        <li>
          <a
            class="header-cta"
            style="background-color: var(--whatsapp); color: #FFFFFF; padding: 10px 20px; border-radius: var(--rounded-sm); font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: background-color 0.2s ease;"
            href="/contacto/"
          >Contacto</a>
        </li>
      </ul>
    </nav>
  </header>
</div>

<script>
  // Toggle del menú móvil (funciona en todas las páginas)
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', function () {
      const isOpen = menu.classList.toggle('active');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute(
        'aria-label',
        isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
      );
    });
  }
</script>
