---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios/', label: 'Servicios' },
  { href: '/sobre-nosotros.html', label: 'Sobre nosotros' },
  { href: '/contacto.html', label: 'Contacto' },
];

let menuOpen = false;
function toggleMenu() {
  menuOpen = !menuOpen;
}
---

<style>
  #header-container {
    position: relative;
    background: var(--surface);
    border-bottom: 1px solid #E8E8E8;
  }

  header.wrapper {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--spacing-sm) var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 28px;
    width: auto;
    display: block;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--surface);
    padding: var(--spacing-md);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    gap: var(--spacing-md);
    z-index: 100;
  }

  nav ul.active {
    display: flex;
  }

  nav ul li a {
    font-size: 0.93rem;
    color: var(--secondary);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  nav ul li a:hover {
    color: var(--tertiary);
  }

  .hamburger {
    display: block;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    padding: 4px;
    color: var(--primary);
    line-height: 1;
  }

  @media (min-width: 601px) {
    .logo img {
      height: 36px;
    }

    .hamburger {
      display: none;
    }

    nav ul {
      display: flex;
      flex-direction: row;
      position: static;
      background: none;
      padding: 0;
      box-shadow: none;
      gap: var(--spacing-lg);
      z-index: auto;
    }

    header.wrapper {
      padding: var(--spacing-md) var(--spacing-lg);
    }
  }
</style>

<div id="header-container">
  <header class="wrapper">
    <a class="logo" href="/" title="SACsi - soluciones informáticas">
      <img src="/logo-autor.png" alt="SACsi - Soluciones Informáticas" />
    </a>
    <nav>
      <button
        class="hamburger"
        aria-label="Menú de navegación"
        onClick={toggleMenu}
      >
        ☰
      </button>
      <ul id="nav-menu" class:list={['nav-menu', { active: menuOpen }]}>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </header>
</div>
