---
// Componente reutilizable: FAQ con datos desde archivo JSON
// Fuente única de verdad: src/data/preguntas-frecuentes-solucion.json
// En la home se muestran solo las preguntas de nivel "general".
import FAQData from '../data/preguntas-frecuentes-solucion.json';
import Accordion from './ui/Accordion.astro';

// Mapeo al contrato del primitivo: {id, titulo, respuesta} → {id, title, content}
// (respuesta ya trae HTML inline seguro, p. ej. <strong>, que el Accordion renderiza)
const faqItems = FAQData.preguntas
  .filter((item) => item.donde_mostrar.nivel === 'general')
  .map(({ id, titulo, respuesta }) => ({ id, title: titulo, content: respuesta }));
---

<style>
  /* Wrapper de layout; el acordeón y sus estilos vienen del primitivo ui/Accordion.astro */
  .faq-list {
    max-width: 720px;
    margin: 0 auto;
  }
</style>

<div class="faq-list">
  <Accordion items={faqItems} allowMultiple={false} />
</div>
