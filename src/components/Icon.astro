---
// Componente icono SVG reutilizable
// Uso: <Icon name="brand-whatsapp" size="20" class="not-found__icon" />
// Basado en Tabler Icons (MIT) — estilo line con stroke="currentColor", fill="none"
// Se inlinean como HTML para heredar color via CSS (currentColor).

interface Props {
  name: string;
  size?: string | number;
  alt?: string;
  class?: string;
}

const { name, size = 20, alt = '', class: className } = Astro.props;

// SVG paths map — de los archivos en public/icons/ (sin el path de reset de fondo Tabler)
const SVG_ICONS: Record<string, string> = {
  'alert-triangle': '<path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" />',
  'arrow-right': '<line x1="5" y1="12" x2="19" y2="12" /><line x1="13" y1="18" x2="19" y2="12" /><line x1="13" y1="6" x2="19" y2="12" />',
  'brand-facebook': '<path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" />',
  'brand-instagram': '<rect x="4" y="4" width="16" height="16" rx="4" /><circle cx="12" cy="12" r="3" /><line x1="16.5" y1="7.5" x2="16.5" y2="7.501" />',
  'brand-whatsapp': '<path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />',
  'brand-youtube': '<rect x="3" y="5" width="18" height="14" rx="4" /><path d="M10 9l5 3l-5 3z" />',
  'check': '<path d="M5 12l5 5l10 -10" />',
  'home': '<polyline points="5 12 3 12 12 3 21 12 19 12" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" /><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />',
  'mail': '<rect x="3" y="5" width="18" height="14" rx="2" /><polyline points="3 7 12 13 21 7" /><path d="M12 13l9 -9v13a2 2 0 0 1-2 2h-14a2 2 0 0 1 -2 -2z" />',
  'phone': '<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />',
  'settings': '<path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" /><circle cx="12" cy="12" r="3" />',
};

const pathData = SVG_ICONS[name] || '';
---

{(pathData) ? (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={["icon", className]}
    aria-hidden={alt === ''}
  >
    <Fragment set:html={pathData} />
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class:list={["icon", className]} aria-hidden={alt === ''}></svg>
)}

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
  }
</style>
