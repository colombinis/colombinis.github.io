---
interface Props {
  variant?: 'neutral' | 'accent' | 'success' | 'warning' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'neutral',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const classes = [
  'ui-badge',
  `ui-badge--${variant}`,
  `ui-badge--${size}`,
  className
].filter(Boolean).join(' ');
---

<span class={classes} {...rest}>
  <slot />
</span>

<style>
  .ui-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    line-height: 1;
    border-radius: var(--rounded-xs, 4px);
    border: 1px solid transparent;
    white-space: nowrap;
    letter-spacing: 0.02em;
    width: fit-content;
  }

  .ui-badge--sm {
    padding: 3px 8px;
    font-size: 0.75rem;
  }

  .ui-badge--md {
    padding: 4px 10px;
    font-size: 0.8125rem;
  }

  .ui-badge--neutral {
    background-color: #F1F5F9;
    color: #334155;
    border-color: #E2E8F0;
  }

  .ui-badge--accent {
    background-color: #EFF6FF;
    color: var(--tertiary-dark, #0066CC);
    border-color: #BFDBFE;
  }

  .ui-badge--success {
    background-color: #ECFDF5;
    color: #065F46;
    border-color: #A7F3D0;
  }

  .ui-badge--warning {
    background-color: #FFFBEB;
    color: #92400E;
    border-color: #FDE68A;
  }

  .ui-badge--outline {
    background-color: transparent;
    color: #475569;
    border-color: #CBD5E1;
  }
</style>
