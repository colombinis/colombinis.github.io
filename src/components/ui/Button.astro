---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'whatsapp' | 'ghost' | 'link' | 'orange';
  size?: 'sm' | 'md' | 'lg' | 'icon';
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  class: className = '',
  disabled = false,
  ...rest
} = Astro.props;

const classes = [
  'ui-btn',
  `ui-btn--${variant}`,
  `ui-btn--${size}`,
  className
].filter(Boolean).join(' ');
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={rel}
      class={classes}
      aria-disabled={disabled ? 'true' : undefined}
      {...rest}
    >
      <slot name="icon-start" />
      <slot />
      <slot name="icon-end" />
    </a>
  ) : (
    <button
      class={classes}
      disabled={disabled}
      {...rest}
    >
      <slot name="icon-start" />
      <slot />
      <slot name="icon-end" />
    </button>
  )
}

<style>
  .ui-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: inherit;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    border-radius: var(--rounded-sm, 8px);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: normal;
    text-align: center;
    box-sizing: border-box;
    max-width: 100%;
    outline: none;
  }

  .ui-btn:focus-visible {
    outline: 2px solid var(--tertiary, #0A7CFF);
    outline-offset: 2px;
  }

  .ui-btn:disabled,
  .ui-btn[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Variantes */
  .ui-btn--primary {
    background-color: var(--primary, #1A1A2E);
    color: #FFFFFF;
  }
  .ui-btn--primary:hover {
    background-color: var(--tertiary, #0A7CFF);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(10, 124, 255, 0.2);
  }

  .ui-btn--secondary {
    background-color: #F1F5F9;
    color: var(--primary, #1A1A2E);
    border-color: #E2E8F0;
  }
  .ui-btn--secondary:hover {
    background-color: #E2E8F0;
    color: var(--primary, #1A1A2E);
  }

  .ui-btn--outline {
    background-color: transparent;
    color: var(--primary, #1A1A2E);
    border-color: #CBD5E1;
  }
  .ui-btn--outline:hover {
    border-color: var(--primary, #1A1A2E);
    background-color: rgba(26, 26, 46, 0.04);
  }

  .ui-btn--whatsapp {
    background-color: var(--whatsapp, #25D366);
    color: #FFFFFF;
  }
  .ui-btn--whatsapp:hover {
    background-color: #1DA851;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
  }

  .ui-btn--ghost {
    background-color: transparent;
    color: var(--secondary, #444444);
  }
  .ui-btn--ghost:hover {
    background-color: #F1F5F9;
    color: var(--primary, #1A1A2E);
  }

  .ui-btn--link {
    background-color: transparent;
    color: var(--tertiary, #0A7CFF);
    padding-left: 0;
    padding-right: 0;
    border-radius: 0;
  }
  .ui-btn--link:hover {
    text-decoration: underline;
  }

  /* Variante orange (home donweb): naranja del logo #F16529 con texto
     BLANCO (feedback 11). Hover mantiene blanco y pasa a naranja profundo
     #D9531E con elevación. */
  .ui-btn--orange {
    background-color: #F16529;
    color: #FFFFFF;
  }
  .ui-btn--orange:hover {
    background-color: #D9531E;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(241, 101, 41, 0.3);
  }

  /* Tamaños */
  .ui-btn--sm {
    padding: 8px 14px;
    font-size: 0.875rem;
  }

  .ui-btn--md {
    padding: 12px 22px;
    font-size: 0.95rem;
  }

  .ui-btn--lg {
    padding: 14px 28px;
    font-size: 1.05rem;
  }

  .ui-btn--icon {
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: var(--rounded-sm, 8px);
    flex-shrink: 0;
  }
</style>
