---
// Componente: Casos de éxito anónimos con formato fijo
// Formato: Problema → Solución justa → Resultado medible
// Estático (sin JS), carga ultra rápida, diseño responsive
// Diseño Atómico: compone los primitivos src/components/ui/ (Card,
// Button). El primitivo Card (variant case-flow) aporta el cromo del
// card, el título en banda azul accent (#0A7CFF) y toda la secuencia .ui-flow*.
// .caso-card sobrevive como hook de test/E2E (piel hover de la sección).
import casosData from '../data/casos-anonimos.json';
import { AlertCircle, CheckCircle2, TrendingUp, ArrowRight } from 'lucide-astro';
import Card from './ui/Card.astro';
import BrandIcon from './ui/BrandIcon.astro';
import Button from './ui/Button.astro';

interface Props {
  servicioId?: string;
  title?: string;
  titleHighlight?: string;
}

const {
  servicioId,
  title = "Casos reales con resultados medibles",
  titleHighlight = "Experiencia comprobada",
} = Astro.props;

// Título bicolor (home): resalta la primera parte en naranja de marca
// (#F16529), el resto en navy --primary. Requiere que title EMPIECE con
// titleHighlight; si no, se renderiza plano como antes.
const startsWithHighlight = title.startsWith(titleHighlight);
const titleRest = startsWithHighlight ? title.slice(titleHighlight.length) : '';

const casos = servicioId
  ? casosData.filter((c) => c.servicio_id === servicioId)
  : casosData;
---
{casos.length > 0 && (
<section class="casos-anonimos-section">
  <div class="container">
    <div class="casos-header">
      <h2 class="section__title">
        {startsWithHighlight ? (
          <span class="casos-title-highlight">{titleHighlight}</span><span>{titleRest}</span>
        ) : (
          title
        )}
      </h2>
    </div>

    <div class="casos-grid">
      {casos.map((caso) => (
        <Card as="article" variant="case-flow" padding="none" class="caso-card">
          <h3 class="ui-card__title">
            <BrandIcon class="ui-card__title-icon" alt="" />
            <span>{caso.titulo}</span>
          </h3>

          <div class="ui-flow">
            <div class="ui-flow__step ui-flow__step--problema">
              <div class="ui-flow__header">
                <span class="ui-flow__indicator ui-flow__indicator--danger">
                  <AlertCircle size={14} aria-hidden="true" />
                </span>
                <h4 class="ui-flow__title">Problema</h4>
              </div>
              <p class="ui-flow__desc">{caso.problema}</p>
            </div>

            <div class="ui-flow__step ui-flow__step--solucion">
              <div class="ui-flow__header">
                <span class="ui-flow__indicator ui-flow__indicator--primary">
                  <CheckCircle2 size={14} aria-hidden="true" />
                </span>
                <h4 class="ui-flow__title">Solución justa</h4>
              </div>
              <p class="ui-flow__desc">{caso.solucion_justa}</p>
            </div>

            <div class="ui-flow__step ui-flow__step--resultado">
              <div class="ui-flow__header">
                <span class="ui-flow__indicator ui-flow__indicator--success">
                  <TrendingUp size={14} aria-hidden="true" />
                </span>
                <h4 class="ui-flow__title">Resultado medible</h4>
              </div>
              <p class="ui-flow__desc ui-flow__desc--highlight">{caso.resultado_medible}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <div class="casos-footer-cta">
      <p class="casos-footer-cta__text">¿Tenés un cuello de botella similar en tu negocio?</p>
      <Button variant="primary" href="/contacto/" class="hero__cta hero__cta--form">
        <span>Te decimos qué necesitás… y qué no. Consulta sin cargo</span>
        <ArrowRight size={16} aria-hidden="true" slot="icon-end" />
      </Button>
    </div>
  </div>
</section>
)}

<style>
  .casos-anonimos-section {
    padding: var(--spacing-xxl) var(--spacing-md);
    background: var(--neutral);
  }

  .casos-header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .casos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    max-width: var(--container);
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .casos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* El primitivo Card (variant default, padding md) pinta el cromo del card
     (fondo, borde, radio, sombra, padding, flex column). .caso-card sobrevive
     como hook de test/E2E y aporta solo la firma hover de la sección.
     :global() porque el <article> lo renderiza Card (scoping de Astro). */
  :global(.caso-card):hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  /* El primitivo Card (variant case-flow) aporta el cromo del card y TODA
     la composición Problema → Solución justa → Resultado medible (.ui-flow*)
     con el título en banda azul accent (#0A7CFF) flush al tope. Acá queda
     solo lo propio de la sección (grid, header, footer CTA). */

  /* Título bicolor de la sección (home): "Experiencia comprobada" en
     naranja de marca #F16529, el resto hereda el navy de section__title. */
  .casos-title-highlight {
    color: #F16529;
  }

  .casos-footer-cta {
    margin-top: var(--spacing-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .casos-footer-cta__text {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }

  /* El CTA es un primitivo Button (variant primary, href /contacto/) con la
     piel hero__cta de global.css; el ancho responsive de la sección se
     ajusta aquí. :global() porque el <a> lo renderiza Button (scoping de Astro). */
  .casos-footer-cta :global(.hero__cta) {
    width: 100%;
    max-width: 520px;
    min-width: 0;
  }
</style>
