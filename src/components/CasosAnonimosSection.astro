---
// Componente: Casos de éxito anónimos con formato fijo
// Formato: Problema → Solución justa → Resultado medible
// Estático (sin JS), carga ultra rápida, diseño responsive
// Diseño Atómico: compone los primitivos src/components/ui/ (Card, Badge,
// Button). Las clases de página (caso-card, caso-badge, hero__cta) viajan
// por el prop class para conservar los hooks de test/E2E y la piel
// definida en global.css (p. ej. body.header-overlay .caso-badge).
import casosData from '../data/casos-anonimos.json';
import { MapPin, AlertCircle, CheckCircle2, TrendingUp, ArrowRight } from 'lucide-astro';
import Card from './ui/Card.astro';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';

interface Props {
  servicioId?: string;
  title?: string;
  titleHighlight?: string;
  subtitle?: string;
  hideLabel?: boolean;
  hideMeta?: boolean;
}

const {
  servicioId,
  title = "Casos reales con resultados medibles",
  titleHighlight = "Experiencia comprobada",
  subtitle,
  hideLabel = false,
  hideMeta = false,
} = Astro.props;

// Título bicolor (home): resalta la primera parte en naranja de marca
// (#F16529), el resto en navy --primary. Requiere que title EMPIECE con
// titleHighlight; si no, se renderiza plano como antes.
const startsWithHighlight = title.startsWith(titleHighlight);
const titleRest = startsWithHighlight ? title.slice(titleHighlight.length) : '';

const casos = servicioId
  ? casosData.filter((c) => c.servicio_id === servicioId)
  : casosData;
---
{casos.length > 0 && (
<section class="casos-anonimos-section">
  <div class="container">
    <div class="casos-header">
      {!hideLabel && <p class="casos-label">EXPERIENCIA COMPROBADA</p>}
      <h2 class="section__title">
        {startsWithHighlight ? (
          <span class="casos-title-highlight">{titleHighlight}</span><span>{titleRest}</span>
        ) : (
          title
        )}
      </h2>
      {subtitle && <p class="section__subtitle">{subtitle}</p>}
    </div>

    <div class="casos-grid">
      {casos.map((caso) => (
        <Card as="article" variant="default" padding="md" class="caso-card">
          {!hideMeta && (
            <div class="caso-card__meta">
              <Badge variant="warning" class="caso-badge">{caso.rubro}</Badge>
              <span class="caso-location">
                <MapPin size={13} aria-hidden="true" />
                <span>{caso.ubicacion}</span>
              </span>
            </div>
          )}

          <h3 class="caso-card__title">{caso.titulo}</h3>

          <div class="caso-flow">
            <div class="flow-step flow-step--problema">
              <div class="flow-step__header">
                <span class="step-indicator step-indicator--danger">
                  <AlertCircle size={14} aria-hidden="true" />
                </span>
                <h4 class="flow-step__title">Problema</h4>
              </div>
              <p class="flow-step__desc">{caso.problema}</p>
            </div>

            <div class="flow-step flow-step--solucion">
              <div class="flow-step__header">
                <span class="step-indicator step-indicator--primary">
                  <CheckCircle2 size={14} aria-hidden="true" />
                </span>
                <h4 class="flow-step__title">Solución justa</h4>
              </div>
              <p class="flow-step__desc">{caso.solucion_justa}</p>
            </div>

            <div class="flow-step flow-step--resultado">
              <div class="flow-step__header">
                <span class="step-indicator step-indicator--success">
                  <TrendingUp size={14} aria-hidden="true" />
                </span>
                <h4 class="flow-step__title">Resultado medible</h4>
              </div>
              <p class="flow-step__desc flow-step__desc--highlight">{caso.resultado_medible}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <div class="casos-footer-cta">
      <p class="casos-footer-cta__text">¿Tenés un cuello de botella similar en tu negocio?</p>
      <Button variant="primary" href="/contacto/" class="hero__cta hero__cta--form">
        <span>Te decimos qué necesitás… y qué no. Consulta sin cargo</span>
        <ArrowRight size={16} aria-hidden="true" slot="icon-end" />
      </Button>
    </div>
  </div>
</section>
)}

<style>
  .casos-anonimos-section {
    padding: var(--spacing-xxl) var(--spacing-md);
    background: var(--neutral);
  }

  .casos-header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .casos-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tertiary-dark);
    margin: 0 0 var(--spacing-xs);
  }

  .casos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    max-width: var(--container);
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .casos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* El primitivo Card (variant default, padding md) pinta el cromo del card
     (fondo, borde, radio, sombra, padding, flex column). .caso-card sobrevive
     como hook de test/E2E y aporta solo la firma hover de la sección.
     :global() porque el <article> lo renderiza Card (scoping de Astro). */
  :global(.caso-card):hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .caso-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
  }

  /* Título bicolor de la sección (home): "Experiencia comprobada" en
     naranja de marca #F16529, el resto hereda el navy de section__title. */
  .casos-title-highlight {
    color: #F16529;
  }

  /* El primitivo Badge (variant warning) aporta paleta, tamaño y forma; se
     conserva la identidad tipográfica del rubro en MAYÚSCULAS.
     :global() porque el <span> lo renderiza Badge (scoping de Astro). */
  :global(.caso-badge) {
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .caso-location {
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 500;
  }

  .caso-card__title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 var(--spacing-md);
    line-height: 1.35;
  }

  .caso-flow {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    flex-grow: 1;
  }

  .flow-step {
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--rounded-sm);
    background: #FAFBFD;
    border-left: 3px solid #CBD5E1;
  }

  .flow-step--problema {
    border-left-color: #EF4444;
    background: #FEF2F2;
  }

  .flow-step--solucion {
    border-left-color: var(--tertiary);
    background: #EFF6FF;
  }

  .flow-step--resultado {
    border-left-color: #10B981;
    background: #ECFDF5;
  }

  .flow-step__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .step-indicator {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .step-indicator--danger {
    background: #FEE2E2;
    color: #DC2626;
  }

  .step-indicator--primary {
    background: #DBEAFE;
    color: var(--tertiary-dark);
  }

  .step-indicator--success {
    background: #D1FAE5;
    color: #059669;
  }

  .flow-step__title {
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    color: var(--primary);
  }

  .flow-step__desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--secondary);
    margin: 0;
  }

  .flow-step__desc--highlight {
    font-weight: 600;
    color: #065F46;
  }

  .casos-footer-cta {
    margin-top: var(--spacing-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .casos-footer-cta__text {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }

  /* El CTA es un primitivo Button (variant primary, href /contacto/) con la
     piel hero__cta de global.css; el ancho responsive de la sección se
     ajusta aquí. :global() porque el <a> lo renderiza Button (scoping de Astro). */
  .casos-footer-cta :global(.hero__cta) {
    width: 100%;
    max-width: 520px;
    min-width: 0;
  }
</style>
