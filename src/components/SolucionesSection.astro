---
// Componente reutilizable: Sección "Soluciones para tu negocio"
// Se renderiza del lado del servidor (SSG estático) — sin carga asíncrona.
// Fuente única de verdad: src/data/servicios/servicio_*.json (datos normalizados)
//
// Migración a design system (s3-soluciones): cada card se compone con el
// primitivo <Card variant="media-accent" padding="none"> (banda naranja
// #F16529 borde a borde via .ui-card__media, CSS del propio primitivo) +
// <Button variant="primary" size="sm"> como CTA. El hook de test "service-card"
// y el href se preservan en la raíz del card.
import Card from './ui/Card.astro';
import Button from './ui/Button.astro';
import { getServicios } from '../lib/data-utils';

const servicios = getServicios();
---

<style>
  .soluciones__title {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }
  @media (min-width: 601px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* Cuerpo del card de servicio: el primitivo Card (media-accent) aporta
     la banda naranja borde a borde, el borde y el hover; como el card usa
     padding="none" (para que la banda llegue a los bordes), el padding del
     cuerpo se reponer acá con los mismos valores de la home donweb. */
  .service-card__body {
    padding: 0 24px 28px;
  }
</style>

<section id="soluciones" class="section">
  <div class="container">
    <h2 class="soluciones__title">Soluciones para tu negocio</h2>
    <div class="cards-grid">
      {servicios.map((service) => (
        <Card
          as="article"
          variant="media-accent"
          class="service-card"
          data-servicio={service.id}
        >
          <div class="ui-card__media">
            <img src={service.imagen} alt={service.title} loading="lazy" />
          </div>
          <div class="ui-card__body service-card__body">
            <h3>
              <a href={service.href}>{service.title}</a>
            </h3>
            <p>{service.claim}</p>
            <Button variant="primary" size="sm" href={service.href}
              >Ver servicio</Button
            >
          </div>
        </Card>
      ))}
    </div>
    <div style="text-align: center; margin-top: var(--spacing-xl);">
      <a class="hero__cta-secondary" href="/catalogo/">Buscar mas soluciones</a>
    </div>
  </div>
</section>
