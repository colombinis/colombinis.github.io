---
// HeroSlider: carrusel hero estilo donweb — un slide por servicio.
// Vanilla JS (sin Swiper): scroll-snap + autoplay + dots + teclado.
// Data-driven: slides generados desde src/data/servicios/ (orden `orden`).
import { getServicios } from '../lib/data-utils';

interface Slide {
  id: string;
  title: string;
  claim: string;
  href: string;
  imagen: string;
}

const slides: Slide[] = getServicios().map((svc) => ({
  id: svc.id,
  title: svc.title,
  claim: svc.claim,
  href: svc.href,
  imagen: svc.imagen,
}));
---

<section
  class="hero-slider"
  aria-roledescription="carousel"
  aria-label="Servicios principales de SACsi"
>
  <div class="hero-slider__viewport" id="hero-slider-viewport">
    {slides.map((s, i) => (
      <article
        class="hero-slider__slide"
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} de ${slides.length}: ${s.title}`}
        data-index={i}
      >
        <div class="hero-slider__inner">
          <a class="hero-slider__link" href={s.href}>
            <div class="hero-slider__media" aria-hidden="true">
              <img
                src={s.imagen}
                srcset={`${s.imagen} 1x`}
                alt=""
                width="600"
                height="400"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <div class="hero-slider__content">
              <h2 class="hero-slider__title">{s.title}</h2>
              <p class="hero-slider__claim">{s.claim}</p>
            </div>
          </a>
        </div>
      </article>
    ))}
  </div>

  <div class="hero-slider__dots" role="tablist" aria-label="Elegí un slide">
    {slides.map((s, i) => (
      <button
        class="hero-slider__dot"
        data-goto={i}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Ir a ${s.title}`}
      ></button>
    ))}
  </div>
</section>

<style>
  .hero-slider {
    position: relative;
    background: var(--primary);
    color: #FFFFFF;
    overflow: hidden;
  }

  .hero-slider__viewport {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge legacy */
  }
  .hero-slider__viewport::-webkit-scrollbar {
    display: none;
  }

  /* El slide es un lienzo: la imagen de fondo lo cubre por completo y el
     texto se superpone centrado. */
  .hero-slider__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-height: 78vh;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Imagen de fondo: ocupa TODO el slide (object-fit: cover).
     z-index: 0 explícito para que el panel de texto (z-index: 1) quede
     encima — sin esto, el absolute pinta sobre el contenido estático. */
  .hero-slider__media {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 0;
  }
  .hero-slider__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .hero-slider__link:hover .hero-slider__media img,
  .hero-slider__link:focus-visible .hero-slider__media img {
    transform: scale(1.03);
  }

  /* Scrim sutil de marca sobre la imagen para reforzar el contraste. */
  .hero-slider__slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(26, 26, 46, 0.2),
      rgba(26, 26, 46, 0.55)
    );
    pointer-events: none;
    z-index: 1;
  }

  /* El slide completo es un link: el texto va centrado vertical y
     horizontalmente sobre la imagen. */
  .hero-slider__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: inherit;
    text-decoration: none;
    padding: var(--spacing-xxl) var(--spacing-md);
  }

  .hero-slider__link:focus-visible {
    outline: 2px solid var(--tertiary);
    outline-offset: 4px;
    border-radius: var(--rounded-md);
  }

  /* Panel translúcido detrás del texto: fondo semitransparente para que el
     contraste permita leer sobre cualquier zona de la imagen. */
  .hero-slider__content {
    position: relative;
    z-index: 1; /* sobre la imagen de fondo */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
    width: 100%;
    max-width: 480px;
    padding: var(--spacing-lg) var(--spacing-md);
    border-radius: var(--rounded-md);
    background: rgba(26, 26, 46, 0.5);
  }

  .hero-slider__title {
    color: #FFFFFF;
    font-size: clamp(2rem, 6vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
    text-transform: uppercase;
  }

  .hero-slider__claim {
    font-size: clamp(1rem, 2.4vw, 1.35rem);
    font-weight: 600;
    color: #C9DFFF;
    margin: 0;
    max-width: 34ch;
  }

  /* Hover: el título pasa al naranja de marca. */
  .hero-slider__link:hover .hero-slider__title,
  .hero-slider__link:focus-visible .hero-slider__title {
    color: #F16529;
  }

  .hero-slider__dots {
    position: absolute;
    right: var(--spacing-md);
    bottom: var(--spacing-lg);
    display: flex;
    gap: 10px;
    z-index: 5;
  }

  .hero-slider__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.8);
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .hero-slider__dot[aria-selected='true'] {
    background: #FFFFFF;
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slider__viewport {
      scroll-behavior: auto;
    }
    .hero-slider__media img {
      transition: none;
    }
  }

  /* Modo fila 60/40 de la home (wrapper .hero-row): el carrusel llena la
     altura de la fila (definida por el hero) y reduce tipografías/panel para
     el 40% restante. La imagen de fondo y el centrado son los de la base,
     así que acá solo se ajusta escala. En mobile no aplica (por debajo de
     901px el slider conserva su formato completo). */
  @media (min-width: 901px) {
    :global(.hero-row) .hero-slider {
      display: flex;
      flex-direction: column;
    }
    :global(.hero-row) .hero-slider__viewport {
      flex: 1 1 auto;
      min-height: 0;
    }
    :global(.hero-row) .hero-slider__slide {
      min-height: 0;
    }
    :global(.hero-row) .hero-slider__link {
      padding: var(--spacing-md);
    }
    :global(.hero-row) .hero-slider__content {
      z-index: 1; /* sobre la imagen, también en el modo fila 60/40 */
      max-width: 320px;
      padding: var(--spacing-md);
    }
    :global(.hero-row) .hero-slider__title {
      font-size: clamp(1.3rem, 2.4vw, 1.7rem);
      line-height: 1.1;
    }
    :global(.hero-row) .hero-slider__claim {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  (function () {
    var viewport = document.getElementById('hero-slider-viewport');
    if (!viewport) return;

    var dots = Array.prototype.slice.call(
      document.querySelectorAll('.hero-slider__dot')
    );
    var slides = Array.prototype.slice.call(
      viewport.querySelectorAll('.hero-slider__slide')
    );
    if (!slides.length) return;

    var AUTOPLAY_MS = 6000;
    var timer: number | undefined;
    var currentIndex = 0;
    var reducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function goTo(index: number, smooth: boolean) {
      currentIndex = (index + slides.length) % slides.length;
      viewport.scrollTo({
        left: slides[currentIndex].offsetLeft,
        behavior: smooth && !reducedMotion ? 'smooth' : 'auto',
      });
    }

    function syncDots() {
      dots.forEach(function (dot, i) {
        dot.setAttribute('aria-selected', i === currentIndex ? 'true' : 'false');
      });
    }

    function startAutoplay() {
      if (reducedMotion) return;
      stopAutoplay();
      timer = window.setInterval(function () {
        goTo(currentIndex + 1, true);
      }, AUTOPLAY_MS);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.getAttribute('data-goto') || '0', 10), true);
        syncDots();
        startAutoplay(); // reinicia el conteo tras interacción
      });
    });

    // Sincronizar dots cuando el usuario scrollea/toca el carrusel
    var scrollTimer: number | undefined;
    viewport.addEventListener('scroll', function () {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(function () {
        var center = viewport.scrollLeft + viewport.clientWidth / 2;
        var best = 0;
        var bestDist = Infinity;
        slides.forEach(function (s, i) {
          var mid = s.offsetLeft + s.offsetWidth / 2;
          var dist = Math.abs(mid - center);
          if (dist < bestDist) {
            bestDist = dist;
            best = i;
          }
        });
        if (best !== currentIndex) {
          currentIndex = best;
          syncDots();
        }
      }, 80);
    }, { passive: true });

    // Pausar autoplay cuando el carrusel no está visible o la pestaña duerme
    document.addEventListener('visibilitychange', function () {
      document.hidden ? stopAutoplay() : startAutoplay();
    });

    // Teclado: flechas izq/der cuando el carrusel tiene foco
    viewport.setAttribute('tabindex', '0');
    viewport.addEventListener('keydown', function (e: KeyboardEvent) {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(currentIndex + 1, true);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(currentIndex - 1, true);
      }
      syncDots();
      startAutoplay();
    });

    // Touch/swipe pausa el autoplay mientras se interactúa
    viewport.addEventListener('pointerdown', stopAutoplay);
    viewport.addEventListener('pointerup', startAutoplay);
    viewport.addEventListener('pointercancel', startAutoplay);

    syncDots();
    startAutoplay();
  })();
</script>
