---
const { title, icon, href, claim, label } = Astro.props;
---

<article class="service-card">
  {label ? <span class="service-card__type">{label}</span> : ''}
  <div class="service-card__icon">
    {icon ? <img src={icon} alt={title} style="height:48px;width:auto;" /> : ''}
  </div>
  <h3>
    <a href={href} style="color:inherit;text-decoration:none;">{title}</a>
  </h3>
  <slot name="claim" />
  <p><slot /></p>
  <slot name="cta" />
</article>
