---
import IconResolver from './ui/IconResolver.astro';

const { title, icon, href, claim, label, imagen } = Astro.props;
---

<article class="service-card">
  {label ? <span class="service-card__type">{label}</span> : ''}
  <div class="service-card__icon">
    {imagen ? (
      <img src={imagen} alt={title} loading="lazy" />
    ) : icon ? (
      <IconResolver name={icon} size={28} />
    ) : null}
  </div>
  <h3>
    <a href={href} style="color:inherit;text-decoration:none;">{title}</a>
  </h3>
  <slot name="claim" />
  <p><slot /></p>
  <slot name="cta" />
</article>
