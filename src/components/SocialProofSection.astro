---
// Componente reutilizable: sección "Resultados que hablan" (social proof)
// Métricas + testimonios generales o por servicio. Se renderiza SSG estático.
import { getTestimoniosGenerales, getTestimoniosByServicio } from '../lib/data-utils';
import Card from './ui/Card.astro';

interface Props {
  servicioId?: string;
  maxTestimonios?: number;
}

const { servicioId, maxTestimonios = 2 } = Astro.props;
const testimoniosDataRaw = servicioId ? getTestimoniosByServicio(servicioId) : getTestimoniosGenerales();

const testimoniosData = testimoniosDataRaw ? {
  ...testimoniosDataRaw,
  testimonios: testimoniosDataRaw.testimonios?.slice(0, maxTestimonios) ?? []
} : null;
---

<section id="social-proof" class="section">
  <div class="container">
    <h2 class="section__title">{testimoniosData?.section_title ?? 'Resultados concretos'}</h2>

    {testimoniosData && (
      <div class="testimonials">
        <div class="testimonials-grid">
          {testimoniosData.testimonios.map((t) => (
            <Card variant="default" padding="md" class="testimonial-card">
              <p class="testimonial-card__quote">
                "{t.quote}"
              </p>
              <p class="testimonial-card__author">{t.autor}</p>
              {t.rol && <p class="testimonial-card__role">{t.rol}</p>}
            </Card>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
