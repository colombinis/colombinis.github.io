---
// Componente reutilizable: sección "Resultados que hablan" (social proof)
// Métricas + testimonios generales (homepage). Se renderiza SSG estático.
import { getTestimoniosGenerales } from '../lib/data-utils';

const testimoniosData = getTestimoniosGenerales();
---

<section id="social-proof" class="section">
  <div class="container">
    <h2 class="section__title">{testimoniosData?.section_title ?? 'Resultados que hablan'}</h2>
    <div class="metrics-grid">
      <div class="metric">
        <p class="metric__number">15+</p>
        <p class="metric__label">años de experiencia</p>
      </div>
      <div class="metric">
        <p class="metric__number">65%</p>
        <p class="metric__label">del tiempo administrativo liberado</p>
      </div>
      <div class="metric">
        <p class="metric__number">50+</p>
        <p class="metric__label">clientes satisfechos</p>
      </div>
      <div class="metric">
        <p class="metric__number">2</p>
        <p class="metric__label">semanas a tu primer prototipo</p>
      </div>
    </div>

    {testimoniosData && (
      <div class="testimonials">
        <div class="testimonials-grid">
          {testimoniosData.testimonios.map((t) => (
            <div class="testimonial-card">
              <p class="testimonial-card__quote">
                "{t.quote}"
              </p>
              <p class="testimonial-card__author">{t.autor}</p>
              <p class="testimonial-card__role">{t.rol}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
