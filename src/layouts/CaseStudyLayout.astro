---
import Layout from './Layout.astro';
import IconResolver from '../components/ui/IconResolver.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import { AlertTriangle } from 'lucide-astro';

interface Metric {
  value: string;
  label: string;
}

interface SolutionCard {
  icon: string;
  imagen?: string;
  title: string;
  text: string;
}

interface Testimonial {
  quote: string;
  author: string;
  role: string;
}

interface Props {
  title: string;
  description: string;
  heroLabel?: string;
  heroSubtitle: string;
  problema: string;
  problemaExtra?: string;
  vision?: string;
  solutions: SolutionCard[];
  stack?: string[];
  testimonial: Testimonial;
  metrics: Metric[];
  disclaimer?: string;
  cliente?: string;
  clienteUrl?: string;
  imagen?: string;
}

const {
  title,
  description,
  heroLabel,
  heroSubtitle,
  problema,
  problemaExtra,
  vision,
  solutions,
  stack,
  testimonial,
  metrics,
  disclaimer,
  cliente,
  clienteUrl,
  imagen,
} = Astro.props;
---

<!--
  Diseño Atómico (DESIGN.md): este layout compone los primitivos de
  src/components/ui/ (Button, Card, Badge) en lugar de markup ad-hoc.
  Las clases de página (hero__cta, service-card, testimonial-card,
  metric, tech-tag, case-disclaimer) viajan via el prop `class` para
  conservar la piel/responsive definida en global.css.
-->
<Layout title={title} description={description}>
  <section class="hero">
    <div class="hero__container">
      <h1 class="hero__title">{title}</h1>
      <p class="hero__subtitle">{heroSubtitle}</p>
      <div class="hero__actions">
        <Button variant="primary" size="lg" href="/contacto/" class="hero__cta">
          ¿Tenés preguntas? Consultanos ahora
        </Button>
      </div>
      {cliente && (
        <p class="hero__client">
          {clienteUrl ? <a href={clienteUrl} target="_blank" rel="noopener noreferrer">{cliente}</a> : cliente}
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">El deseo del cliente</h2>
      <div class="case-prose">
        <p>{problema}</p>
        {problemaExtra && <p set:html={problemaExtra} />}
      </div>

      {vision && (
        <div class="case-vision">
          <p class="case-vision__label">Cómo imaginaba el éxito</p>
          <p class="case-vision__quote">{vision}</p>
        </div>
      )}
    </div>
  </section>

  {imagen && (
    <section class="section">
      <div class="container">
        <img src={imagen} alt={title} loading="lazy" style="width:100%;border-radius:var(--rounded-md);" />
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">La solución</h2>
      <div class="cards-grid">
        {solutions.map((s) => (
          <Card as="article" variant="muted" padding="lg" class="service-card">
            <div class="service-card__icon">
              {s.imagen ? (
                <img src={s.imagen} alt={s.title} loading="lazy" />
              ) : (
                <IconResolver name={s.icon} size={28} />
              )}
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  {stack && stack.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section__title">Stack técnico</h2>
        <div class="tech-stack">
          {stack.map((t) => (
            <Badge variant="neutral" class="tech-tag">{t}</Badge>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">Resultado</h2>
      <div class="testimonials-grid">
        <Card variant="muted" padding="lg" class="testimonial-card">
          <p class="testimonial-card__quote">{testimonial.quote}</p>
          <p class="testimonial-card__author">{testimonial.author}</p>
          <p class="testimonial-card__role">{testimonial.role}</p>
        </Card>
      </div>
      <div class="metrics-grid" style="margin-top:var(--spacing-xl);">
        {metrics.map((m) => (
          <Card variant="muted" padding="lg" class="metric">
            <p class="metric__number">{m.value}</p>
            <p class="metric__label">{m.label}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  {disclaimer && (
    <section class="section">
      <div class="container">
        <Card
          variant="default"
          padding="md"
          class="case-disclaimer"
          style="padding:var(--spacing-md);background:#FFF3CD;border-radius:var(--rounded-sm);border:1.5px solid #FFD93D;"
        >
          <p style="margin:0;font-size:0.9rem;color:#856404;display:flex;align-items:flex-start;gap:8px;">
            <AlertTriangle size={18} color="#D97706" aria-hidden="true" style="flex-shrink:0;margin-top:2px;" />
            <span><strong>Nota importante:</strong> {disclaimer}</span>
          </p>
        </Card>
      </div>
    </section>
  )}
</Layout>

<style>
  /* Píldoras del stack técnico: el <span> lo renderiza Badge.astro, por lo
     que una regla scoped no alcanza la raíz del primitivo — se restaura la
     forma de píldora (y su piel de página) con :global(). tech-tag solo se
     usa en este layout, así que no hay efecto colateral en otras páginas.
     Debe ganarle a .ui-badge--neutral del primitivo (misma especificidad,
     este bloque se emite después en el bundle). */
  :global(.tech-tag) {
    background-color: var(--surface);
    border: 1px solid #E0E0E0;
    border-radius: var(--rounded-full);
    padding: 6px 16px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
  }
</style>
